<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\bg-dark.jpg" />
    <Content Include="Assets\bg-light.jpg" />
    <Content Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!--
      Явно поднимаем транзитивную зависимость (версия 2.0.0 содержит уязвимость GHSA-v5pm-xwqc-g5wc).
      Кроме того, пакет нужен инструментам EF Core: миграции лежат в Adashboard.Data, но design-time
      запускается из проекта-хоста (startup), поэтому пакет обязателен и здесь.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Riok.Mapperly — source generator: генерирует код маппинга entity ↔ контрактная модель на сборке. -->
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Ссылка на WASM-клиент переводит API в режим хоста: статика клиента подключается
      как static web assets и раздаётся тем же сервером (один origin).
    -->
    <ProjectReference Include="..\Adashboard.Domain\Adashboard.Domain.csproj" />
    <ProjectReference Include="..\Adashboard.Data\Adashboard.Data.csproj" />
    <ProjectReference Include="..\Adashboard.Client\Adashboard.Client.csproj" />
  </ItemGroup>

</Project>
