@implements IAsyncDisposable
@inject IJSRuntime Js

<input class="form-control color-picker__input"
       data-coloris
       id="@_inputId"
       value="@Value"
       @oninput="OnInput"
       aria-label="@AriaLabel" />

@code {
    private readonly string _inputId = $"coloris-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<ColorPicker>? _dotNetRef;

    // Статический набор образцов общий для приложения: недавно выбранные цвета поднимаются наверх.
    private static readonly object SwatchesLock = new();
    private static readonly List<string> Swatches =
    [
        "#1e40af", "#0369a1", "#0ea5e9", "#15803d",
        "#22c55e", "#ea580c", "#f97316", "#b91c1c",
        "#f43f5e", "#8b5cf6", "#0f172a", "#64748b"
    ];

    /// <summary>Текущий выбранный цвет.</summary>
    [Parameter]
    public string Value { get; set; } = "#ffffff";

    /// <summary>Событие изменения цвета (поддерживает <c>@bind-Value</c>).</summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Разрешить выбор прозрачности.</summary>
    [Parameter]
    public bool Alpha { get; set; }

    /// <summary>Тема оформления Coloris.</summary>
    [Parameter]
    public string Theme { get; set; } = "default";

    /// <summary>Режим темы: light, dark или auto.</summary>
    [Parameter]
    public string ThemeMode { get; set; } = "auto";

    /// <summary>Подпись поля для скринридеров.</summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Выбор цвета";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/colorisInterop.js");
            _dotNetRef = DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync("initializeColoris", _inputId, new
            {
                theme = Theme,
                alpha = Alpha,
                format = "hex",
                swatches = GetSwatchSnapshot(),
                closeButton = true,
                closeLabel = "Выбрать"
            }, ThemeMode, _dotNetRef);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        Value = args.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    /// <summary>
    /// Запоминает выбранный цвет и обновляет образцы в открытом поле.
    /// </summary>
    [JSInvokable]
    public async Task OnColorPicked(string color)
    {
        if (string.IsNullOrWhiteSpace(color))
        {
            return;
        }

        RememberColor(color);

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("updateSwatches", _inputId, GetSwatchSnapshot());
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private static string[] GetSwatchSnapshot()
    {
        lock (SwatchesLock)
        {
            return Swatches.ToArray();
        }
    }

    private static void RememberColor(string color)
    {
        const int maxSwatches = 12;

        lock (SwatchesLock)
        {
            Swatches.RemoveAll(x => string.Equals(x, color, StringComparison.OrdinalIgnoreCase));
            Swatches.Insert(0, color);

            if (Swatches.Count > maxSwatches)
            {
                Swatches.RemoveRange(maxSwatches, Swatches.Count - maxSwatches);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeColoris", _inputId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetRef?.Dispose();
    }
}
