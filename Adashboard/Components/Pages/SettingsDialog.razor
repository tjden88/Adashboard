<form class="settings-dialog" @onsubmit="Save" @onsubmit:preventDefault>
    <div class="settings-section">
        <label for="siteTitle">Заголовок dashboard</label>
        <input id="siteTitle"
               class="form-control"
               type="text"
               maxlength="120"
               autocomplete="off"
               value="@_title"
               @oninput="args => _title = args.Value?.ToString() ?? string.Empty" />
    </div>

    <div class="settings-section">
        <label for="siteDescription">Описание</label>
        <input id="siteDescription"
               class="form-control"
               type="text"
               maxlength="300"
               autocomplete="off"
               value="@_description"
               @oninput="args => _description = args.Value?.ToString() ?? string.Empty" />
    </div>

    <div class="form-check">
        <input id="showLogo"
               class="form-check-input"
               type="checkbox"
               checked="@_showLogo"
               @onchange="args => _showLogo = args.Value is true" />
        <label class="form-check-label" for="showLogo">Показывать логотип в шапке</label>
    </div>

    <div class="settings-section">
        <label for="themeSelect">Выберите тему оформления:</label>
        <select id="themeSelect" class="form-select" value="@_themeMode" @onchange="OnThemeChange">
            <option value="auto">Автоматическая</option>
            <option value="dark">Тёмная</option>
            <option value="light">Светлая</option>
        </select>
    </div>

    <div class="settings-dialog__actions">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>Сохранить
        </button>
    </div>
</form>

@using Adashboard.Models.Dashboard

@code {
    private string _themeMode = "auto";
    private string _title = string.Empty;
    private string _description = string.Empty;
    private bool _showLogo = true;

    [Parameter]
    public string ThemeMode { get; set; } = "auto";

    [Parameter]
    public string SiteTitle { get; set; } = string.Empty;

    [Parameter]
    public string SiteDescription { get; set; } = string.Empty;

    [Parameter]
    public bool ShowLogo { get; set; } = true;

    [Parameter, EditorRequired]
    public required EventCallback<SiteSettings> OnSave { get; set; }

    protected override void OnInitialized()
    {
        _themeMode = ThemeMode;
        _title = SiteTitle;
        _description = SiteDescription;
        _showLogo = ShowLogo;
    }

    private void OnThemeChange(ChangeEventArgs args) => _themeMode = args.Value?.ToString() ?? "auto";

    private async Task Save() => await OnSave.InvokeAsync(new SiteSettings(_themeMode, _title.Trim(), _description.Trim(), _showLogo));
}
