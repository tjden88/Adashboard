@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IDbContextFactory<DashboardDbContext> DbContextFactory
@using Adashboard.Data
@using Adashboard.Models.Dashboard
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

<PageTitle>Adashboard</PageTitle>

@if (!_isLoaded)
{
    <div class="dashboard-loading" role="status" aria-live="polite" aria-label="Загрузка dashboard">
        <div class="loader-card">
            <div class="loader-orb"></div>
            <div class="loader-lines">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="loader-grid">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
}
else
{
    <section class="dashboard-shell">
        <header class="dashboard-header">
            <div>
                <h1>Adashboard</h1>
                <p>Личная стартовая страница со ссылками и сервисами</p>
            </div>
            <div class="dashboard-header-actions">
                <label for="themeMode">Тема</label>
                <select id="themeMode" value="@_themeMode" @onchange="OnThemeChanged" aria-label="Переключение темы">
                    <option value="auto">Авто</option>
                    <option value="dark">Тёмная</option>
                    <option value="light">Светлая</option>
                </select>
            </div>
        </header>

        <div class="dashboard-grid" id="dashboard-grid">
            @foreach (var category in _categories)
            {
                <section class="dashboard-category"
                         data-category-id="@category.Id"
                         style="--span-desktop:@category.Position.Width; --span-mobile:@Math.Min(category.Position.Width, 4);">
                    <header class="category-header">
                        <div class="category-title-wrap">
                            <span class="drag-handle" title="Перетащить категорию" aria-hidden="true">
                                <i class="fa-solid fa-grip-vertical"></i>
                            </span>
                            <h2>@category.Title</h2>
                        </div>
                        <div class="category-actions">
                            <label for="width-@category.Id">Ширина</label>
                            <select id="width-@category.Id"
                                    value="@category.Position.Width"
                                    @onchange="args => OnCategoryWidthChanged(category.Id, args)">
                                @for (var width = 1; width <= 12; width++)
                                {
                                    <option value="@width">@width</option>
                                }
                            </select>
                        </div>
                    </header>

                    <div class="category-cards" data-category-id="@category.Id">
                        @foreach (var card in category.Cards.OrderBy(x => x.Position.Order))
                        {
                            <a class="dashboard-card"
                               data-card-id="@card.Id"
                               href="@card.Url"
                               target="_blank"
                               rel="noopener noreferrer"
                               style="--card-icon-color:@card.IconColor;">
                                <span class="card-title">@card.Title</span>
                                <div class="card-icon" aria-hidden="true">
                                    <i class="@card.IconClass"></i>
                                </div>
                                <span class="status-dot @(card.IsOnline ? "online" : "offline")" aria-label="Статус"></span>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
    </section>
}

@code {
    private DashboardLayout _layout = new()
    {
        Id = "main"
    };

    private IEnumerable<DashboardCategory> _categories => _layout.Categories.OrderBy(x => x.Position.Order);

    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _dotNetRef;
    private string _themeMode = "auto";
    private bool _isLoaded;
    private bool _sortableInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
            _dotNetRef = DotNetObjectReference.Create(this);

            await LoadLayoutAsync();
            _themeMode = _layout.ThemeMode;
            await _module.InvokeVoidAsync("initializeTheme", _themeMode);

            NormalizeLayout();

            _isLoaded = true;
            StateHasChanged();
            return;
        }

        if (_isLoaded && !_sortableInitialized && _module is not null && _dotNetRef is not null)
        {
            await _module.InvokeVoidAsync("initializeSortable", _dotNetRef);
            _sortableInitialized = true;
        }
    }

    private async Task OnThemeChanged(ChangeEventArgs args)
    {
        var next = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(next) || _module is null)
        {
            return;
        }

        _themeMode = next;
        _layout.ThemeMode = next;
        await SaveLayoutAsync();
        await _module.InvokeVoidAsync("setThemeMode", _themeMode);
    }

    private async Task OnCategoryWidthChanged(string categoryId, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var width))
        {
            return;
        }

        var category = _layout.Categories.FirstOrDefault(x => x.Id == categoryId);
        if (category is null)
        {
            return;
        }

        category.Position.Width = Math.Clamp(width, 1, 12);
        await SaveLayoutAsync();
    }

    [JSInvokable]
    public async Task OnCategoriesReordered(string[] orderedCategoryIds)
    {
        if (orderedCategoryIds.Length == 0)
        {
            return;
        }

        var order = 0;
        foreach (var id in orderedCategoryIds)
        {
            var category = _layout.Categories.FirstOrDefault(x => x.Id == id);
            if (category is not null)
            {
                category.Position.Order = order;
                order++;
            }
        }

        foreach (var category in _layout.Categories.OrderBy(x => x.Position.Order))
        {
            if (orderedCategoryIds.All(id => id != category.Id))
            {
                category.Position.Order = order;
                order++;
            }
        }

        await SaveLayoutAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnCardsReordered(string sourceCategoryId, string targetCategoryId, string[] sourceCardIds, string[] targetCardIds)
    {
        var source = _layout.Categories.FirstOrDefault(x => x.Id == sourceCategoryId);
        var target = _layout.Categories.FirstOrDefault(x => x.Id == targetCategoryId);
        if (source is null || target is null)
        {
            return;
        }

        var allCards = _layout.Categories
            .SelectMany(x => x.Cards)
            .ToDictionary(x => x.Id, x => x);

        if (sourceCategoryId == targetCategoryId)
        {
            if (sourceCardIds.Length > 0)
            {
                source.Cards = ReorderCards(sourceCardIds, allCards);
            }
        }
        else
        {
            if (sourceCardIds.Length > 0)
            {
                source.Cards = ReorderCards(sourceCardIds, allCards);
            }

            if (targetCardIds.Length > 0)
            {
                target.Cards = ReorderCards(targetCardIds, allCards);
            }

            foreach (var card in source.Cards)
            {
                card.CategoryId = source.Id;
            }

            foreach (var card in target.Cards)
            {
                card.CategoryId = target.Id;
            }
        }

        UpdateCardOrders(source);
        if (!ReferenceEquals(source, target))
        {
            UpdateCardOrders(target);
        }

        await SaveLayoutAsync();
        StateHasChanged();
    }

    private static void UpdateCardOrders(DashboardCategory category)
    {
        for (var i = 0; i < category.Cards.Count; i++)
        {
            category.Cards[i].Position.Order = i;
        }
    }

    private static List<DashboardCard> ReorderCards(string[] orderedIds, IReadOnlyDictionary<string, DashboardCard> cardsById)
    {
        var ordered = new List<DashboardCard>(orderedIds.Length);

        foreach (var id in orderedIds)
        {
            if (cardsById.TryGetValue(id, out var card))
            {
                ordered.Add(card);
            }
        }

        return ordered;
    }

    private void NormalizeLayout()
    {
        if (string.IsNullOrWhiteSpace(_layout.ThemeMode))
        {
            _layout.ThemeMode = "auto";
        }

        for (var categoryIndex = 0; categoryIndex < _layout.Categories.Count; categoryIndex++)
        {
            var category = _layout.Categories[categoryIndex];

            category.DashboardLayoutId = _layout.Id;
            category.Position.Width = Math.Clamp(category.Position.Width, 1, 12);

            if (category.Position.Order < 0)
            {
                category.Position.Order = categoryIndex;
            }

            for (var cardIndex = 0; cardIndex < category.Cards.Count; cardIndex++)
            {
                var card = category.Cards[cardIndex];
                card.CategoryId = category.Id;

                if (string.IsNullOrWhiteSpace(card.IconColor))
                {
                    card.IconColor = ResolveDefaultIconColor(card.IconClass);
                }

                if (card.Position.Order < 0)
                {
                    card.Position.Order = cardIndex;
                }
            }
        }

        if (_layout.Categories.All(x => x.Position.Order == 0))
        {
            for (var i = 0; i < _layout.Categories.Count; i++)
            {
                _layout.Categories[i].Position.Order = i;
            }
        }

        foreach (var category in _layout.Categories)
        {
            if (category.Cards.Count > 0 && category.Cards.All(x => x.Position.Order == 0))
            {
                for (var i = 0; i < category.Cards.Count; i++)
                {
                    category.Cards[i].Position.Order = i;
                }
            }
        }
    }

    private static string ResolveDefaultIconColor(string iconClass)
    {
        if (iconClass.Contains("database", StringComparison.OrdinalIgnoreCase))
        {
            return "#f97316";
        }

        if (iconClass.Contains("chart", StringComparison.OrdinalIgnoreCase))
        {
            return "#fb923c";
        }

        if (iconClass.Contains("docker", StringComparison.OrdinalIgnoreCase))
        {
            return "#38bdf8";
        }

        if (iconClass.Contains("heart", StringComparison.OrdinalIgnoreCase))
        {
            return "#22c55e";
        }

        return "#fb923c";
    }

    private async Task LoadLayoutAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var layoutFromDb = await dbContext.Layouts
            .AsNoTracking()
            .Include(x => x.Categories)
            .ThenInclude(x => x.Cards)
            .FirstOrDefaultAsync(x => x.Id == "main");

        _layout = layoutFromDb ?? new DashboardLayout { Id = "main", ThemeMode = "auto" };
    }

    private async Task SaveLayoutAsync()
    {
        NormalizeLayout();

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var existing = await dbContext.Layouts
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == _layout.Id);

        if (existing is not null)
        {
            dbContext.Layouts.Remove(new DashboardLayout { Id = existing.Id });
            await dbContext.SaveChangesAsync();
        }

        dbContext.Layouts.Add(CloneLayout(_layout));
        await dbContext.SaveChangesAsync();
    }

    private static DashboardLayout CloneLayout(DashboardLayout source)
    {
        var layout = new DashboardLayout
        {
            Id = source.Id,
            ThemeMode = source.ThemeMode,
            Categories = []
        };

        foreach (var category in source.Categories)
        {
            var categoryCopy = new DashboardCategory
            {
                Id = category.Id,
                DashboardLayoutId = source.Id,
                Title = category.Title,
                Position = new CategoryPosition
                {
                    Order = category.Position.Order,
                    Width = category.Position.Width
                },
                Cards = []
            };

            foreach (var card in category.Cards)
            {
                categoryCopy.Cards.Add(new DashboardCard
                {
                    Id = card.Id,
                    CategoryId = category.Id,
                    Title = card.Title,
                    Url = card.Url,
                    IconClass = card.IconClass,
                    IconColor = card.IconColor,
                    IsOnline = card.IsOnline,
                    Position = new CardPosition
                    {
                        Order = card.Position.Order
                    }
                });
            }

            layout.Categories.Add(categoryCopy);
        }

        return layout;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeSortable");
                await _module.DisposeAsync();
            }
            catch
            {
            }
        }

        _dotNetRef?.Dispose();
    }
}
