@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IDashboardLayoutService DashboardLayoutService
@inject IImageIconService ImageIconService
@inject DialogService DialogService
@inject EditModeService EditModeService
@inject IHealthCheckService HealthCheckService
@inject ILogger<Home> Logger
@using Adashboard.Data
@using Adashboard.Models.Dashboard
@using Adashboard.Services
@using Microsoft.JSInterop
@using System.Collections.Concurrent

<PageTitle>Adashboard</PageTitle>

@if (!_isLoaded)
{
    <div class="dashboard-loading" role="status" aria-live="polite" aria-label="Загрузка dashboard">
        <div class="loader-card">
            <div class="loader-orb"></div>
            <div class="loader-lines">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="loader-grid">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
}
else
{
    <section class="dashboard-shell">
        <header class="dashboard-header">
            <div class="dashboard-header-brand">
                @if (_layout.ShowLogo)
                {
                    <img class="dashboard-logo" src="uploads/backgrounds/logo.png" alt="" />
                }
                <div>
                    <h1>@_layout.SiteTitle</h1>
                    <p>@_layout.SiteDescription</p>
                </div>
            </div>
            <div class="dashboard-header-actions">

                @if (EditModeService.IsEnabled)
                {
                    <button type="button" class="btn btn-icon btn-sm btn-success" @onclick="OpenAddCategoryDialog" aria-label="Добавить категорию" title="Добавить категорию">
                        <i class="fa-regular fa-layer-plus"></i>
                    </button>

                    <button type="button" class="btn btn-icon btn-sm btn-outline-secondary" @onclick="OpenSettings" aria-label="Открыть настройки" title="Настройки">
                        <i class="fa-solid fa-gear" aria-hidden="true"></i>
                    </button>
                }

                <button type="button"
                        class="px-4 btn btn-icon btn-sm @(EditModeService.IsEnabled ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="ToggleEditMode"
                        aria-pressed="@EditModeService.IsEnabled"
                        aria-label="Переключить режим редактирования"
                        title="@(EditModeService.IsEnabled ? "Завершить редактирование" : "Редактировать")">
                    <i class="fa-solid @(EditModeService.IsEnabled ? "fa-check" : "fa-pen-nib")" aria-hidden="true"></i>
                </button>

            </div>
        </header>

        <div class="dashboard-grid" id="dashboard-grid">
            @foreach (var category in _categories)
            {
                <Category @key="category.Id" Model="@category"
                          EditRequested="category => OpenEditCategoryDialog(category)"
                          AddCardRequested="category => OpenAddCardDialog(category)"
                          DeleteRequested="category => OpenDeleteCategoryConfirm(category)"
                          CardEditRequested="card => OpenEditCardDialog(card)"
                          HealthLookup="GetHealthState" />
            }
        </div>
    </section>
}

@code {
    private DashboardLayout _layout = new()
    {
        Id = 1
    };

    private IEnumerable<DashboardCategory> _categories => _layout.Categories.OrderBy(x => x.Position.Order);

    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _dotNetRef;
    private readonly SemaphoreSlim _reorderLock = new(1, 1);
    private readonly ConcurrentDictionary<int, ServiceHealthState> _health = new();
    private readonly CancellationTokenSource _pageCts = new();
    private CancellationTokenSource? _healthCts;
    private Task? _healthLoop;
    private string _themeMode = "auto";
    private bool _isLoaded;
    private bool _dragAndDropInitialized;

    // Ограничения интервала проверки статуса и число одновременных запросов.
    private const int MinHealthIntervalSeconds = 10;
    private const int MaxHealthIntervalSeconds = 600;
    private const int MaxConcurrentHealthChecks = 6;

    protected override void OnInitialized()
    {
        EditModeService.OnChange += OnEditModeChanged;
    }

    private void OnEditModeChanged() => InvokeAsync(StateHasChanged);

    private void ToggleEditMode() => EditModeService.Toggle();

    private ServiceHealthState GetHealthState(DashboardCard card)
        => _health.TryGetValue(card.Id, out var state) ? state : ServiceHealthState.Unknown;

    // Запускает периодическую проверку статуса в рамках текущего circuit: запросы идут,
    // только пока dashboard открыт у пользователя.
    private async Task StartHealthLoopAsync()
    {
        if (_healthCts is not null)
        {
            // Останавливаем предыдущий цикл и дожидаемся его завершения до освобождения токена.
            _healthCts.Cancel();
            if (_healthLoop is not null)
            {
                try
                {
                    await _healthLoop;
                }
                catch (OperationCanceledException)
                {
                }
            }

            _healthCts.Dispose();
        }

        _healthCts = new CancellationTokenSource();
        _healthLoop = RunHealthLoopAsync(_healthCts.Token);
    }

    private async Task RunHealthLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await CheckAllCardsAsync(cancellationToken);

                var interval = Math.Clamp(
                    _layout.HealthCheckIntervalSeconds,
                    MinHealthIntervalSeconds,
                    MaxHealthIntervalSeconds);
                await Task.Delay(TimeSpan.FromSeconds(interval), cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Штатное завершение цикла при уходе со страницы или перезапуске.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Цикл проверки статуса карточек остановлен из-за ошибки.");
        }
    }

    private async Task CheckAllCardsAsync(CancellationToken cancellationToken)
    {
        var cards = _layout.Categories
            .SelectMany(x => x.Cards)
            .Where(x => x.StatusMode != CardStatusMode.None)
            .ToList();

        if (cards.Count == 0)
        {
            return;
        }

        // Ограничиваем число одновременных запросов, чтобы не перегружать сеть и сервер.
        using var throttler = new SemaphoreSlim(MaxConcurrentHealthChecks);
        var checks = cards.Select(async card =>
        {
            await throttler.WaitAsync(cancellationToken);
            try
            {
                _health[card.Id] = await HealthCheckService.CheckAsync(card, cancellationToken);
            }
            finally
            {
                throttler.Release();
            }
        });

        await Task.WhenAll(checks);

        if (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) when (cancellationToken.IsCancellationRequested)
        {
            // Circuit уже завершается: обновлять UI не нужно.
        }
    }

    // Немедленная проверка одной карточки после добавления или редактирования.
    private async Task CheckCardNowAsync(DashboardCard card)
    {
        try
        {
            if (card.StatusMode == CardStatusMode.None)
            {
                _health.TryRemove(card.Id, out _);
            }
            else
            {
                _health[card.Id] = await HealthCheckService.CheckAsync(card, _pageCts.Token);
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Страница закрывается: результат проверки больше не нужен.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось выполнить немедленную проверку статуса карточки {CardId}.", card.Id);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
            _dotNetRef = DotNetObjectReference.Create(this);

            await LoadLayoutAsync();
            _themeMode = _layout.ThemeMode;
            await _module.InvokeVoidAsync("initializeTheme", _themeMode);

            NormalizeLayout();

            _isLoaded = true;
            StateHasChanged();
            await StartHealthLoopAsync();
            return;
        }

        if (_isLoaded && !_dragAndDropInitialized && _module is not null && _dotNetRef is not null)
        {
            await _module.InvokeVoidAsync("initializeDragAndDrop", _dotNetRef);
            _dragAndDropInitialized = true;
        }

        if (_isLoaded && _module is not null)
        {
            await _module.InvokeVoidAsync("setEditMode", EditModeService.IsEnabled);
        }
    }

    private void OpenSettings()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(SettingsDialog.ThemeMode)] = _themeMode,
            [nameof(SettingsDialog.SiteTitle)] = _layout.SiteTitle,
            [nameof(SettingsDialog.SiteDescription)] = _layout.SiteDescription,
            [nameof(SettingsDialog.ShowLogo)] = _layout.ShowLogo,
            [nameof(SettingsDialog.HealthCheckIntervalSeconds)] = _layout.HealthCheckIntervalSeconds,
            [nameof(SettingsDialog.OnSave)] = EventCallback.Factory.Create<SiteSettings>(this, OnSettingsSavedAsync)
        };

        DialogService.Show<SettingsDialog>("Настройки", parameters, closeOnOverlayClick: false);
    }

    private async Task OnSettingsSavedAsync(SiteSettings settings)
    {
        // Пустые значения заголовка и описания сохраняются как есть: пользователь может
        // намеренно очистить их, и дефолты подставлять не нужно.
        _themeMode = string.IsNullOrWhiteSpace(settings.ThemeMode) ? "auto" : settings.ThemeMode;
        _layout.ThemeMode = _themeMode;
        _layout.SiteTitle = settings.SiteTitle;
        _layout.SiteDescription = settings.SiteDescription;
        _layout.ShowLogo = settings.ShowLogo;
        _layout.HealthCheckIntervalSeconds = settings.HealthCheckIntervalSeconds;

        await SaveLayoutAsync();
        await InvokeAsync(StateHasChanged);

        // Интервал мог измениться: перезапускаем цикл с новым значением.
        await StartHealthLoopAsync();

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setThemeMode", _themeMode);
        }

        DialogService.Close();
    }

    private void OpenAddCategoryDialog()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(CategoryDialog.OnSave)] = EventCallback.Factory.Create<DashboardCategory>(this, AddCategory)
        };

        DialogService.Show<CategoryDialog>("Создать категорию", parameters, closeOnOverlayClick: false);
    }

    private void OpenEditCategoryDialog(DashboardCategory category)
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(CategoryDialog.Category)] = category,
            [nameof(CategoryDialog.OnSave)] = EventCallback.Factory.Create<DashboardCategory>(this, SaveCategory)
        };

        DialogService.Show<CategoryDialog>("Редактировать категорию", parameters, closeOnOverlayClick: false);
    }

    private async Task AddCategory(DashboardCategory category)
    {
        // Id больше, чем у всех существующих: раскладка сохраняется целиком, поэтому
        // идентификатор стабильно переживает перезапись.
        category.Id = _layout.Categories.Count > 0 ? _layout.Categories.Max(x => x.Id) + 1 : 1;
        category.DashboardLayoutId = _layout.Id;
        category.Position.Order = _layout.Categories.Count > 0 ? _layout.Categories.Max(x => x.Position.Order) + 1 : 0;
        _layout.Categories.Add(category);

        await SaveLayoutAsync();
        await InvokeAsync(StateHasChanged);
        DialogService.Close();
    }

    private async Task SaveCategory(DashboardCategory category)
    {
        await SaveLayoutAsync();
        await InvokeAsync(StateHasChanged);
        DialogService.Close();
    }

    private async Task OpenDeleteCategoryConfirm(DashboardCategory category)
    {
        // Пустую категорию удаляем сразу: подтверждать нечего.
        if (category.Cards.Count == 0)
        {
            await DeleteCategory(category);
            return;
        }

        var parameters = new Dictionary<string, object?>
        {
            [nameof(ConfirmDialog.Message)] = $"Удалить категорию «{category.Title}» вместе со всеми ссылками?",
            [nameof(ConfirmDialog.ConfirmLabel)] = "Удалить",
            [nameof(ConfirmDialog.OnConfirm)] = EventCallback.Factory.Create(this, () => DeleteCategory(category))
        };

        DialogService.Show<ConfirmDialog>("Подтверждение удаления", parameters, closeOnOverlayClick: true);
    }

    private async Task DeleteCategory(DashboardCategory category)
    {
        // Вместе с категорией удаляем файлы пользовательских иконок всех её карточек.
        foreach (var card in category.Cards)
        {
            ImageIconService.Delete(card.Id);
        }

        _layout.Categories.Remove(category);

        var ordered = _layout.Categories.OrderBy(x => x.Position.Order).ToList();
        for (var i = 0; i < ordered.Count; i++)
        {
            ordered[i].Position.Order = i;
        }

        await SaveLayoutAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OpenAddCardDialog(DashboardCategory category)
    {
        // Идентификатор резервируется заранее: он нужен для имени файла пользовательской иконки.
        var nextCardId = _layout.Categories
            .SelectMany(x => x.Cards)
            .Select(x => x.Id)
            .DefaultIfEmpty(0)
            .Max() + 1;

        var parameters = new Dictionary<string, object?>
        {
            [nameof(CardDialog.CategoryId)] = category.Id,
            [nameof(CardDialog.CardId)] = nextCardId,
            [nameof(CardDialog.OnSave)] = EventCallback.Factory.Create<DashboardCard>(this, AddCard)
        };

        DialogService.Show<CardDialog>("Добавить карточку", parameters, closeOnOverlayClick: false);
    }

    private void OpenEditCardDialog(DashboardCard card)
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(CardDialog.Card)] = card,
            [nameof(CardDialog.OnSave)] = EventCallback.Factory.Create<DashboardCard>(this, SaveCard),
            [nameof(CardDialog.OnDelete)] = EventCallback.Factory.Create<DashboardCard>(this, OpenDeleteCardConfirm)
        };

        DialogService.Show<CardDialog>($"Редактировать карточку: {card.Title}", parameters, closeOnOverlayClick: false);
    }

    private async Task AddCard(DashboardCard card)
    {
        var category = _layout.Categories.FirstOrDefault(x => x.Id == card.CategoryId);
        if (category is null)
        {
            DialogService.Close();
            return;
        }

        // Id больше, чем у всех существующих: раскладка сохраняется целиком, поэтому
        // идентификатор стабильно переживает перезапись. Диалог уже мог зарезервировать
        // id под файл иконки — тогда используем его.
        if (card.Id <= 0)
        {
            card.Id = _layout.Categories.SelectMany(x => x.Cards).Select(x => x.Id).DefaultIfEmpty(0).Max() + 1;
        }

        card.Position.Order = category.Cards.Count > 0 ? category.Cards.Max(x => x.Position.Order) + 1 : 0;
        category.Cards.Add(card);
        _health.TryRemove(card.Id, out _);

        await SaveLayoutAsync();
        await InvokeAsync(StateHasChanged);
        DialogService.Close();

        // Не ждём очередного цикла: проверяем новую карточку сразу.
        _ = CheckCardNowAsync(card);
    }

    private async Task SaveCard(DashboardCard card)
    {
        _health.TryRemove(card.Id, out _);
        await SaveLayoutAsync();
        await InvokeAsync(StateHasChanged);
        DialogService.Close();

        // Не ждём очередного цикла: проверяем изменённую карточку сразу.
        _ = CheckCardNowAsync(card);
    }

    private void OpenDeleteCardConfirm(DashboardCard card)
    {
        var displayName = string.IsNullOrWhiteSpace(card.Title) ? card.Url : card.Title;

        var parameters = new Dictionary<string, object?>
        {
            [nameof(ConfirmDialog.Message)] = $"Удалить ссылку «{displayName}»?",
            [nameof(ConfirmDialog.ConfirmLabel)] = "Удалить",
            [nameof(ConfirmDialog.OnConfirm)] = EventCallback.Factory.Create(this, () => DeleteCard(card))
        };

        DialogService.Show<ConfirmDialog>("Подтверждение удаления", parameters, closeOnOverlayClick: true);
    }

    private async Task DeleteCard(DashboardCard card)
    {
        ImageIconService.Delete(card.Id);
        _health.TryRemove(card.Id, out _);

        var category = _layout.Categories.FirstOrDefault(x => x.Id == card.CategoryId);
        if (category is not null)
        {
            category.Cards.Remove(card);
            AssignCardOrder(category);
        }

        await SaveLayoutAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnCategoriesReordered(int[] orderedCategoryIds)
    {
        if (orderedCategoryIds.Length == 0)
        {
            return;
        }

        await _reorderLock.WaitAsync();
        try
        {
            var order = 0;
            foreach (var id in orderedCategoryIds)
            {
                var category = _layout.Categories.FirstOrDefault(x => x.Id == id);
                if (category is not null)
                {
                    category.Position.Order = order;
                    order++;
                }
            }

            // Категории, которых нет в присланном списке, уходят в конец, сохраняя относительный порядок.
            foreach (var category in _layout.Categories.OrderBy(x => x.Position.Order))
            {
                if (Array.IndexOf(orderedCategoryIds, category.Id) < 0)
                {
                    category.Position.Order = order;
                    order++;
                }
            }

            await SaveLayoutAsync();
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnCardsReordered(int sourceCategoryId, int targetCategoryId, int[] sourceCardIds, int[] targetCardIds)
    {
        await _reorderLock.WaitAsync();
        try
        {
            var source = _layout.Categories.FirstOrDefault(x => x.Id == sourceCategoryId);
            var target = _layout.Categories.FirstOrDefault(x => x.Id == targetCategoryId);
            if (source is null || target is null)
            {
                return;
            }

            var cardsById = _layout.Categories
                .SelectMany(x => x.Cards)
                .ToDictionary(x => x.Id, x => x);

            // Список из DOM всегда авторитетный и пересобирается целиком: иначе перенесённая
            // карточка осталась бы сразу в двух категориях и дала дубликат ключа при сохранении.
            source.Cards = ResolveCards(sourceCardIds, cardsById);
            foreach (var card in source.Cards)
            {
                card.CategoryId = source.Id;
            }

            if (!ReferenceEquals(source, target))
            {
                target.Cards = ResolveCards(targetCardIds, cardsById);
                foreach (var card in target.Cards)
                {
                    card.CategoryId = target.Id;
                }
            }

            AssignCardOrder(source);
            if (!ReferenceEquals(source, target))
            {
                AssignCardOrder(target);
            }

            await SaveLayoutAsync();
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    private static void AssignCardOrder(DashboardCategory category)
    {
        for (var i = 0; i < category.Cards.Count; i++)
        {
            category.Cards[i].Position.Order = i;
        }
    }

    private static List<DashboardCard> ResolveCards(int[] orderedIds, IReadOnlyDictionary<int, DashboardCard> cardsById)
    {
        var ordered = new List<DashboardCard>(orderedIds.Length);

        foreach (var id in orderedIds)
        {
            if (cardsById.TryGetValue(id, out var card))
            {
                ordered.Add(card);
            }
        }

        return ordered;
    }

    private void NormalizeLayout()
    {
        if (string.IsNullOrWhiteSpace(_layout.ThemeMode))
        {
            _layout.ThemeMode = "auto";
        }

        if (_layout.HealthCheckIntervalSeconds < MinHealthIntervalSeconds
            || _layout.HealthCheckIntervalSeconds > MaxHealthIntervalSeconds)
        {
            _layout.HealthCheckIntervalSeconds = 30;
        }

        for (var categoryIndex = 0; categoryIndex < _layout.Categories.Count; categoryIndex++)
        {
            var category = _layout.Categories[categoryIndex];

            category.DashboardLayoutId = _layout.Id;
            category.Position.Width = Math.Clamp(category.Position.Width, 1, 12);

            if (category.Position.Order < 0)
            {
                category.Position.Order = categoryIndex;
            }

            for (var cardIndex = 0; cardIndex < category.Cards.Count; cardIndex++)
            {
                var card = category.Cards[cardIndex];
                card.CategoryId = category.Id;

                if (string.IsNullOrWhiteSpace(card.BackgroundColor))
                {
                    card.BackgroundColor = ResolveDefaultBackgroundColor(card.IconClass);
                }

                if (card.Position.Order < 0)
                {
                    card.Position.Order = cardIndex;
                }
            }
        }

        if (_layout.Categories.All(x => x.Position.Order == 0))
        {
            for (var i = 0; i < _layout.Categories.Count; i++)
            {
                _layout.Categories[i].Position.Order = i;
            }
        }

        foreach (var category in _layout.Categories)
        {
            if (category.Cards.Count > 0 && category.Cards.All(x => x.Position.Order == 0))
            {
                for (var i = 0; i < category.Cards.Count; i++)
                {
                    category.Cards[i].Position.Order = i;
                }
            }
        }
    }

    private static string ResolveDefaultBackgroundColor(string iconClass)
    {
        if (iconClass.Contains("database", StringComparison.OrdinalIgnoreCase))
        {
            return "#b91c1c";
        }

        if (iconClass.Contains("chart", StringComparison.OrdinalIgnoreCase))
        {
            return "#ea580c";
        }

        if (iconClass.Contains("docker", StringComparison.OrdinalIgnoreCase))
        {
            return "#0369a1";
        }

        if (iconClass.Contains("heart", StringComparison.OrdinalIgnoreCase))
        {
            return "#15803d";
        }

        return "#1e40af";
    }

    private async Task LoadLayoutAsync()
    {
        _layout = await DashboardLayoutService.GetMainLayoutAsync();
    }

    private async Task SaveLayoutAsync()
    {
        NormalizeLayout();
        await DashboardLayoutService.SaveMainLayoutAsync(_layout);
    }

    public async ValueTask DisposeAsync()
    {
        EditModeService.OnChange -= OnEditModeChanged;

        _pageCts.Cancel();
        _healthCts?.Cancel();
        if (_healthLoop is not null)
        {
            try
            {
                await _healthLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _healthCts?.Dispose();
        _pageCts.Dispose();

        // Диалоги настроек, категории, карточки и подтверждения держат колбэк на текущую
        // страницу: закрываем их при уходе, чтобы не вызывать метод у уже удалённого компонента.
        if (DialogService.Current is not null &&
            (DialogService.Current.ComponentType == typeof(SettingsDialog)
             || DialogService.Current.ComponentType == typeof(CategoryDialog)
             || DialogService.Current.ComponentType == typeof(CardDialog)
             || DialogService.Current.ComponentType == typeof(ConfirmDialog)))
        {
            DialogService.Close();
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeDragAndDrop");
                await _module.DisposeAsync();
            }
            catch
            {
            }
        }

        _dotNetRef?.Dispose();
        _reorderLock.Dispose();
    }
}
