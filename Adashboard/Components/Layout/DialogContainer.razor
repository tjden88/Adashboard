@implements IAsyncDisposable
@inject DialogService DialogService
@inject IJSRuntime JS
@using Adashboard.Services

@if (DialogService.Current is DialogRequest request)
{
    <div class="app-dialog-overlay" @onclick="() => HandleOverlayClick(request)">
        <div @ref="_contentElement"
             class="app-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="app-dialog-title"
             tabindex="-1"
             @onclick:stopPropagation="true"
             @onkeydown="HandleKeyDown">
            <header class="app-dialog__header">
                <span id="app-dialog-title" class="app-dialog__title">@request.Title</span>
                <button type="button" class="app-dialog__close" aria-label="Закрыть" @onclick="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </header>
            <div class="app-dialog__body">
                <DynamicComponent Type="request.ComponentType" Parameters="request.Parameters" />
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _contentElement;
    private IJSObjectReference? _module;
    private bool _focusPending;

    protected override void OnInitialized() => DialogService.OnChange += HandleDialogChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
        }

        if (_focusPending && _module is not null)
        {
            _focusPending = false;
            await _module.InvokeVoidAsync("focusDialog", _contentElement);
        }
    }

    private void HandleDialogChanged()
    {
        if (DialogService.Current is not null)
        {
            _focusPending = true;
        }

        InvokeAsync(StateHasChanged);
    }

    private void HandleOverlayClick(DialogRequest request)
    {
        if (request.CloseOnOverlayClick)
        {
            Close();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Close();
        }
    }

    private void Close() => DialogService.Close();

    public async ValueTask DisposeAsync()
    {
        DialogService.OnChange -= HandleDialogChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch
            {
            }
        }
    }
}
