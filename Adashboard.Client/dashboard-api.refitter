{
  "openApiPath": "../openapi/Adashboard.Server.json",
  "namespace": "Adashboard.Client.Services",
  "naming": {
    "useOpenApiTitle": false,
    "interfaceName": "DashboardApi"
  },
  "generateContracts": false,
  "generateXmlDocCodeComments": false,
  "addAcceptHeaders": false,
  "addContentTypeHeaders": false,
  "useCancellationTokens": true,
  "operationNameTemplate": "{operationName}Async",
  "outputFolder": "Generated",
  "outputFilename": "IDashboardApi.g.cs",
  "additionalNamespaces": [
    "Adashboard.Domain.Contracts",
    "Adashboard.Domain.ReadModels"
  ],
  "responseTypeOverride": {
    "UploadImage": "System.Net.Http.HttpResponseMessage"
  }
}
