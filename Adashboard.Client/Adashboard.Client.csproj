<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">

    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <BlazorEnableCompression>true</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Refit" Version="16.3.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="16.3.0" />
    <PackageReference Include="Refitter.MSBuild" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Generated\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adashboard.Domain\Adashboard.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Update="wwwroot/lib/**/*.map" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/lib/fa/webfonts/*.ttf" CopyToPublishDirectory="Never" />

    <!-- Стили FontAwesome Pro в проекте не используются: реестр FontAwesomeIcons содержит только
         fas/far/fab, поэтому в публикацию попадают лишь нужные шрифты (solid, regular, brands,
         v4compatibility). Остальные файлы только раздували офлайн-кэш service worker. -->
    <Content Update="wwwroot/lib/fa/webfonts/fa-thin-*" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/lib/fa/webfonts/fa-light-*" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/lib/fa/webfonts/fa-duotone-*" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/lib/fa/webfonts/fa-sharp-*" CopyToPublishDirectory="Never" />

    <!-- JavaScript Bootstrap компонентами не используется (диалоги самодельные, data-bs-* нет);
         из css публикуем только bootstrap.min.css, который подключён в index.html. -->
    <Content Update="wwwroot/lib/bootstrap/dist/js/**" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/lib/bootstrap/dist/css/**" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/lib/bootstrap/dist/css/bootstrap.min.css" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
