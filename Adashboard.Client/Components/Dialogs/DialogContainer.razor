@using Adashboard.Client.Services
@implements IAsyncDisposable
@inject DialogService DialogService
@inject IJSRuntime JS

@*
    Стопка диалоговых окон: единственный экземпляр на приложение, рисуется из MainLayout.
    Окна открывает DialogService, а контейнер отрисовывает их все — состояние нижних
    сохраняется, активен верхний: в нём фокус, его закрывают Esc и крестик.
*@

@{
    var dialogs = DialogService.Dialogs;
}

@for (var index = 0; index < dialogs.Count; index++)
{
    var dialog = dialogs[index];
    var isTop = index == dialogs.Count - 1;

    <div @key="dialog.Id"
         class="dialog-overlay"
         style="z-index: @(DialogOverlayZIndex + index)"
         tabindex="-1"
         @onclick="() => HandleOverlayClick(dialog)"
         @onkeydown="args => HandleKeyDown(dialog, isTop, args)">
        <section class="dialog-window @SizeClass(dialog)"
                 data-dialog-id="@dialog.Id"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@TitleId(dialog)"
                 tabindex="-1"
                 @onclick:stopPropagation="true">
            <header class="dialog-window__header">
                <h2 class="dialog-window__title" id="@TitleId(dialog)">@dialog.Title</h2>
                <button type="button"
                        class="dialog-window__close"
                        aria-label="Закрыть окно"
                        disabled="@dialog.IsBusy"
                        @onclick="() => CancelDialog(dialog)">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </header>
            <div class="dialog-window__body" data-dialog-body>
                <DynamicComponent Type="dialog.ComponentType" Parameters="BuildParameters(dialog)" />
            </div>
        </section>
    </div>
}

@code {
    // Базовый z-index окон: каждое следующее окно стопки рисуется выше предыдущего.
    private const int DialogOverlayZIndex = 1000;

    // Имена параметров компонента диалога: их объявляет базовый класс DialogComponent.
    private static readonly string ParametersParameterName = nameof(DialogComponent<object, object>.Parameters);
    private static readonly string DialogParameterName = nameof(DialogComponent<object, object>.Dialog);

    private IJSObjectReference? _module;

    // Окна, которым уже поставлен фокус: по ним возвращаем фокус при закрытии.
    private readonly List<Guid> _focused = [];

    protected override void OnInitialized() => DialogService.OnChange += HandleDialogsChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
        }

        if (_module is not null)
        {
            await SyncFocusAsync(_module);
        }
    }

    private void HandleDialogsChanged() => InvokeAsync(StateHasChanged);

    // Приводит фокус и блокировку прокрутки в браузере в соответствие со стопкой окон:
    // закрытые окна возвращают фокус, верхнее окно получает его первым.
    private async Task SyncFocusAsync(IJSObjectReference module)
    {
        var open = DialogService.Dialogs.Select(x => x.Id).ToHashSet();

        for (var index = _focused.Count - 1; index >= 0; index--)
        {
            if (!open.Contains(_focused[index]))
            {
                await module.InvokeVoidAsync("releaseDialog", _focused[index]);
                _focused.RemoveAt(index);
            }
        }

        var top = DialogService.Top;
        if (top is not null && !_focused.Contains(top.Id))
        {
            _focused.Add(top.Id);
            await module.InvokeVoidAsync("focusDialog", top.Id);
        }
    }

    private static Dictionary<string, object> BuildParameters(DialogInstance dialog)
    {
        return new Dictionary<string, object>
        {
            [ParametersParameterName] = dialog.Parameters,
            [DialogParameterName] = dialog
        };
    }

    private static string TitleId(DialogInstance dialog) => $"dialog-title-{dialog.Id}";

    private static string SizeClass(DialogInstance dialog) => dialog.Options.Size switch
    {
        DialogSize.Small => "dialog-window--small",
        DialogSize.Large => "dialog-window--large",
        _ => "dialog-window--medium"
    };

    private void HandleOverlayClick(DialogInstance dialog)
    {
        if (!dialog.Options.CloseOnOverlayClick)
        {
            return;
        }

        CancelDialog(dialog);
    }

    // Esc закрывает верхнее окно; занятое сохранением окно не закрывается (см. DialogService.Cancel).
    // Обработчик стоит на затемнении: клик по нему переносит фокус туда, поэтому Esc работает
    // и после клика вне окна, а не только когда фокус внутри полей.
    private void HandleKeyDown(DialogInstance dialog, bool isTop, KeyboardEventArgs args)
    {
        if (isTop && args.Key == "Escape")
        {
            CancelDialog(dialog);
        }
    }

    private void CancelDialog(DialogInstance dialog) => DialogService.Cancel(dialog);

    public async ValueTask DisposeAsync()
    {
        DialogService.OnChange -= HandleDialogsChanged;

        if (_module is not null)
        {
            foreach (var id in _focused)
            {
                try
                {
                    await _module.InvokeVoidAsync("releaseDialog", id);
                }
                catch (Exception)
                {
                    // Соединение с JS потеряно: освобождать больше нечего.
                }
            }

            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception)
            {
                // Соединение с JS потеряно: модуль освобождать не нужно.
            }
        }

        _focused.Clear();
    }
}
