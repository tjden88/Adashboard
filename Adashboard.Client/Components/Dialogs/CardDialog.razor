@implements IAsyncDisposable
@inject IDashboardApi DashboardApi
@inject DashboardApiOptions ApiOptions
@inject IJSRuntime JS
@inject ILogger<CardDialog> Logger

@*
    Диалог ссылки-карточки: создание (Card не задана) и изменение (Card передана).
    Открытость окна ведёт Category.

    Запросы к API выполняет сам диалог: карточка сохраняется одним запросом вместе с новым
    изображением-иконкой (если оно выбрано). Итоговую карточку — с путём к сохранённому файлу —
    возвращает API, поэтому клиенту не нужно знать, под каким именем сервер его записал.
    При отказе окно остаётся открытым с понятным текстом ошибки.

    Удаление выполняет Category: диалог только сообщает о запросе, а подтверждение спрашивает родитель.
*@

<EditForm Model="_model" OnValidSubmit="SaveAsync" class="card-dialog">
    <DataAnnotationsValidator />

    <div class="card-dialog__field">
        <label for="cardDialogTitle" class="card-dialog__label">Заголовок</label>
        <div class="card-dialog__title-row">
            <InputText id="cardDialogTitle"
                       class="form-control"
                       maxlength="@DomainConstants.CardTitleMaxLength"
                       autocomplete="off"
                       placeholder="Например: Docker"
                       autofocus
                       @bind-Value="_model.Title" />
            <button type="button"
                    class="btn btn-outline-secondary card-dialog__fetch-title"
                    @onclick="FetchTitleAsync"
                    disabled="@_isFetchingTitle"
                    title="Получить заголовок со страницы"
                    aria-label="Получить заголовок со страницы">
                <i class="fa-solid @(_isFetchingTitle ? "fa-spinner fa-spin" : "fa-wand-magic-sparkles")" aria-hidden="true"></i>
            </button>
        </div>
        <ValidationMessage For="() => _model.Title" />
        @if (_titleError is not null)
        {
            <p class="card-dialog__error" role="alert">@_titleError</p>
        }
    </div>

    <div class="card-dialog__field">
        <label for="cardDialogUrl" class="card-dialog__label">Ссылка</label>
        <div class="card-dialog__url">
            <button type="button"
                    class="card-dialog__scheme"
                    @onclick="CycleScheme"
                    title="Схема ссылки"
                    aria-label="@($"Схема ссылки: {SchemeLabel}")">
                @SchemeLabel
            </button>
            <InputText id="cardDialogUrl"
                       class="form-control card-dialog__url-input"
                       maxlength="@DomainConstants.CardUrlMaxLength"
                       autocomplete="off"
                       placeholder="example.com"
                       @bind-Value="_model.Url" />
        </div>
        <ValidationMessage For="() => _model.Url" />
    </div>

    <div class="card-dialog__field">
        <span class="card-dialog__label">Иконка</span>

        <div class="card-dialog__icon-modes" role="radiogroup" aria-label="Тип иконки">
            <label class="card-dialog__radio">
                <input type="radio"
                       name="cardIconMode"
                       checked="@(!_model.UseCustomImage)"
                       @onchange="() => SetCustomImage(false)" />
                <span>Встроенная иконка</span>
            </label>
            <label class="card-dialog__radio">
                <input type="radio"
                       name="cardIconMode"
                       checked="@(_model.UseCustomImage)"
                       @onchange="() => SetCustomImage(true)" />
                <span>Своё изображение</span>
            </label>
        </div>

        @if (_model.UseCustomImage)
        {
            <div class="card-dialog__image">
                <div class="card-dialog__image-preview">
                    @if (PreviewSource is not null)
                    {
                        <img src="@PreviewSource" alt="Предпросмотр иконки карточки" />
                    }
                    else
                    {
                        <i class="fa-regular fa-image" aria-hidden="true"></i>
                    }
                </div>

                <div class="card-dialog__image-controls">
                    <div class="card-dialog__image-buttons">
                        <label class="btn btn-outline-secondary card-dialog__image-upload">
                            <i class="fa-solid fa-upload" aria-hidden="true"></i>Выбрать файл
                            <InputFile OnChange="OnFileSelectedAsync"
                                       accept="image/png,image/jpeg,image/gif,image/webp,image/bmp,image/avif"
                                       hidden />
                        </label>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearImage">
                            <i class="fa-solid fa-eraser" aria-hidden="true"></i>Очистить
                        </button>
                    </div>

                    <p class="card-dialog__hint">
                        Выберите файл или вставьте изображение из буфера обмена (Ctrl+V).
                        Максимальный размер — @DomainConstants.MaxImageMegabytes МБ.
                    </p>
                </div>
            </div>

            @if (_imageError is not null)
            {
                <p class="card-dialog__error" role="alert">@_imageError</p>
            }
        }
        else
        {
            <IconPicker @bind-Value="_model.Icon" AriaLabel="Поиск иконки карточки" />
        }
    </div>

    <div class="card-dialog__row">
        <div class="card-dialog__field card-dialog__field--grow">
            <span class="card-dialog__label">Цвет фона</span>
            <ColorPicker @bind-Value="_model.Color" AriaLabel="Цвет фона карточки" />
        </div>
        <label class="card-dialog__toggle" title="Карточка займёт две колонки категории">
            <input type="checkbox"
                   checked="@_model.IsWide"
                   @onchange="args => _model.IsWide = args.Value is true" />
            <span>Широкая</span>
        </label>
    </div>

    <div class="card-dialog__field">
        <span class="card-dialog__label">Проверка доступности</span>
        <div class="card-dialog__status-options" role="radiogroup" aria-label="Режим проверки доступности">
            @foreach (var option in StatusOptions)
            {
                <label class="card-dialog__status-option" title="@option.Hint">
                    <input type="radio"
                           name="cardStatusMode"
                           checked="@(_model.StatusMode == option.Mode)"
                           @onchange="() => SelectStatusMode(option.Mode)" />
                    <span class="card-dialog__status-text">
                        <span class="card-dialog__status-title">@option.Title</span>
                        <span class="card-dialog__status-hint">@option.Hint</span>
                    </span>
                </label>
            }
        </div>
    </div>

    @if (_error is not null)
    {
        <p class="card-dialog__error" role="alert">@_error</p>
    }

    <div class="card-dialog__actions">
        @if (Card is not null)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="() => DeleteRequested.InvokeAsync(Card)">
                <i class="fa-solid fa-trash" aria-hidden="true"></i>Удалить
            </button>
        }

        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>@(_isSaving ? "Сохранение..." : "Сохранить")
        </button>
    </div>
</EditForm>

@code {
    private const string DefaultColor = DomainConstants.DefaultCardBackgroundColor;
    private const string DefaultIcon = DomainConstants.DefaultCardIcon;

    // Варианты проверки доступности, отображаемые в диалоге.
    private static readonly (CardStatusMode Mode, string Title, string Hint)[] StatusOptions =
    [
        (CardStatusMode.None, "Не проверять", "Индикатор на карточке скрыт."),
        (CardStatusMode.Reachable, "Любой ответ", "Доступен при любом ответе сервера."),
        (CardStatusMode.NoServerError, "Без ошибок 5xx", "Доступен, пока нет серверных ошибок."),
        (CardStatusMode.Success, "Успешный ответ", "Доступен только при ответах 200–299.")
    ];

    private CardEditModel _model = new();
    private string? _error;
    private string? _imageError;
    private bool _isSaving;
    private bool _isFetchingTitle;
    private string? _titleError;

    private byte[]? _uploadedBytes;
    private string? _uploadedPreview;

    private readonly CancellationTokenSource _titleLookupCts = new();

    private IJSObjectReference? _module;
    private DotNetObjectReference<CardDialog>? _selfRef;
    private bool _isClipboardInitialized;

    [CascadingParameter]
    private DialogContainer Dialog { get; set; } = null!;

    /// <summary>
    /// Карточка для изменения или <c>null</c> при создании.
    /// </summary>
    [Parameter]
    public DashboardCard? Card { get; set; }

    /// <summary>
    /// Идентификатор категории, в которую добавляется новая карточка.
    /// </summary>
    [Parameter]
    public int CategoryId { get; set; }

    /// <summary>
    /// Порядковый номер новой карточки в категории.
    /// </summary>
    [Parameter]
    public int Position { get; set; }

    /// <summary>
    /// Уведомление о созданной или изменённой карточке: вызывающий обновляет списки.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<DashboardCard> Saved { get; set; }

    /// <summary>
    /// Запрос на удаление карточки: подтверждение спрашивает вызывающий.
    /// </summary>
    [Parameter]
    public EventCallback<DashboardCard> DeleteRequested { get; set; }

    private string SchemeLabel => _model.Scheme switch
    {
        UrlScheme.Http => "http://",
        UrlScheme.Https => "https://",
        _ => "Без схемы"
    };

    // Предпросмотр иконки: выбранный файл (или вставка из буфера), иначе уже сохранённое изображение.
    // Путь сохранённого изображения относительный, поэтому приводим его к адресу API.
    private string? PreviewSource => _uploadedPreview
        ?? (string.IsNullOrWhiteSpace(_model.ExistingImagePath) ? null : ApiOptions.ResolveUploadPath(_model.ExistingImagePath));

    protected override void OnInitialized()
    {
        _model = Card is null
            ? new CardEditModel { CategoryId = CategoryId, Position = Position }
            : CardEditModel.FromCard(Card);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _isClipboardInitialized)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/icon-image.js");
            _selfRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initializeClipboard", _selfRef);
            _isClipboardInitialized = true;
        }
        catch (JSException ex)
        {
            // Вставка из буфера недоступна: изображение можно выбрать файлом.
            Logger.LogWarning(ex, "Модуль вставки изображения из буфера не подключён.");
            _module = null;
        }
    }

    private void CycleScheme()
    {
        _model.Scheme = _model.Scheme switch
        {
            UrlScheme.Http => UrlScheme.Https,
            UrlScheme.Https => UrlScheme.None,
            _ => UrlScheme.Http
        };
    }

    // Переключение типа иконки: своё изображение означает, что встроенная иконка не используется.
    private void SetCustomImage(bool useCustomImage) => _model.UseCustomImage = useCustomImage;

    private void SelectStatusMode(CardStatusMode mode) => _model.StatusMode = mode;

    // ---------------------------------------------------------------
    // Заголовок по ссылке: разбор HTML выполняет сервер, браузеру он недоступен из-за CORS.
    // ---------------------------------------------------------------

    private async Task FetchTitleAsync()
    {
        _titleError = null;

        var (scheme, url) = NormalizeUrl(_model.Scheme, _model.Url);
        if (url.Length == 0)
        {
            _titleError = "Введите ссылку.";
            return;
        }

        if (!IsSafeUrl(scheme, url))
        {
            _titleError = "Недопустимая схема ссылки.";
            return;
        }

        _isFetchingTitle = true;

        try
        {
            Logger.LogDebug("Запрошено получение заголовка страницы по ссылке карточки.");

            var response = await DashboardApi.GetTitleAsync(UrlSchemePrefix(scheme) + url, _titleLookupCts.Token);
            if (!response.IsSuccessStatusCode)
            {
                Logger.LogWarning("Получение заголовка завершилось ошибкой API. Код: {StatusCode}.", (int?)response.StatusCode);
                _titleError = response.ErrorText();
                return;
            }

            var title = response.Content?.Trim();
            if (string.IsNullOrWhiteSpace(title))
            {
                Logger.LogWarning("Заголовок страницы по ссылке карточки не найден.");
                _titleError = "Не удалось найти заголовок на странице.";
                return;
            }

            _model.Title = title;
            Logger.LogDebug("Заголовок страницы по ссылке карточки получен.");
        }
        catch (OperationCanceledException) when (_titleLookupCts.IsCancellationRequested)
        {
            // Диалог закрыли: ответ уже не нужен.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось получить заголовок страницы по ссылке карточки.");
            _titleError = "Не удалось получить заголовок страницы.";
        }
        finally
        {
            _isFetchingTitle = false;
        }
    }

    // ---------------------------------------------------------------
    // Изображение-иконка: выбор файла и вставка из буфера обмена.
    // Байты уходят в API уже при сохранении карточки.
    // ---------------------------------------------------------------

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _imageError = null;

        var file = args.File;
        if (file.Size > DomainConstants.MaxImageBytes)
        {
            _imageError = $"Файл превышает максимальный размер {DomainConstants.MaxImageMegabytes} МБ.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(DomainConstants.MaxImageBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            _uploadedBytes = buffer.ToArray();
            _uploadedPreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(_uploadedBytes)}";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось прочитать выбранный файл изображения карточки.");
            _imageError = "Не удалось прочитать выбранный файл.";
        }
    }

    /// <summary>
    /// Принимает изображение, вставленное из буфера обмена, в виде data URL.
    /// </summary>
    [JSInvokable]
    public void OnClipboardImage(string? dataUrl)
    {
        if (string.IsNullOrWhiteSpace(dataUrl))
        {
            return;
        }

        var commaIndex = dataUrl.IndexOf(',');
        if (commaIndex < 0)
        {
            return;
        }

        try
        {
            var bytes = Convert.FromBase64String(dataUrl[(commaIndex + 1)..]);
            if (bytes.Length == 0 || bytes.LongLength > DomainConstants.MaxImageBytes)
            {
                _imageError = $"Изображение превышает максимальный размер {DomainConstants.MaxImageMegabytes} МБ.";
            }
            else
            {
                _uploadedBytes = bytes;
                _uploadedPreview = dataUrl;
                _model.UseCustomImage = true;
                _imageError = null;
            }
        }
        catch (FormatException)
        {
            _imageError = "Не удалось прочитать изображение из буфера обмена.";
        }

        InvokeAsync(StateHasChanged);
    }

    private void ClearImage()
    {
        _uploadedBytes = null;
        _uploadedPreview = null;
        _model.ExistingImagePath = null;
        _imageError = null;

        // «Очистить» возвращает карточку к встроенной иконке.
        _model.UseCustomImage = false;
    }

    // ---------------------------------------------------------------
    // Сохранение карточки.
    // Иконка уходит вместе с карточкой одним запросом: API принимает изображение и для новой,
    // и для существующей карточки, поэтому отдельных запросов загрузки и откатов не нужно.
    // ---------------------------------------------------------------

    private async Task SaveAsync()
    {
        _error = null;
        _imageError = null;

        var (scheme, url) = NormalizeUrl(_model.Scheme, _model.Url);
        if (!IsSafeUrl(scheme, url))
        {
            _error = "Недопустимая схема ссылки.";
            return;
        }

        var color = _model.Color.Trim();
        if (color.Length == 0)
        {
            color = DefaultColor;
        }

        if (!IsValidHexColor(color))
        {
            _error = "Цвет фона должен быть в формате #RRGGBB.";
            return;
        }

        var icon = _model.Icon.Trim();
        if (icon.Length == 0)
        {
            icon = DefaultIcon;
        }

        // Пользовательская иконка без нового файла и без ранее сохранённого изображения не имеет смысла.
        if (_model.UseCustomImage && _uploadedBytes is null && string.IsNullOrWhiteSpace(_model.ExistingImagePath))
        {
            _imageError = "Выберите изображение.";
            return;
        }

        _isSaving = true;
        Dialog.SetBusy(true);

        try
        {
            var card = Card ?? new DashboardCard
            {
                DashboardCategoryId = CategoryId,
                Position = Position
            };

            card.Title = _model.Title.Trim();
            card.Url = url;
            card.UrlScheme = scheme;
            card.BackgroundColor = color;
            card.StatusMode = _model.StatusMode;
            card.IsWide = _model.IsWide;
            card.IsCustomIcon = _model.UseCustomImage;
            card.IconSource = _model.UseCustomImage ? _model.ExistingImagePath ?? string.Empty : icon;

            var request = new SaveCardRequest
            {
                Card = card,
                ImageContent = _model.UseCustomImage ? _uploadedBytes : null
            };

            if (card.Id <= 0)
            {
                Logger.LogDebug("Создание карточки dashboard {Title} в категории {CategoryId}.", card.Title, card.DashboardCategoryId);

                var response = await DashboardApi.CreateCardAsync(request);
                if (!response.IsSuccessStatusCode || response.Content is null)
                {
                    Logger.LogWarning("Создание карточки завершилось ошибкой API. Код: {StatusCode}.", (int?)response.StatusCode);
                    _error = response.ErrorText();
                    return;
                }

                card = response.Content;
                Logger.LogInformation("Карточка dashboard создана. Идентификатор: {CardId}.", card.Id);
            }
            else
            {
                Logger.LogDebug("Изменение карточки dashboard {CardId}.", card.Id);

                var response = await DashboardApi.UpdateCardAsync(request);
                if (!response.IsSuccessStatusCode || response.Content is null)
                {
                    Logger.LogWarning("Изменение карточки {CardId} завершилось ошибкой API. Код: {StatusCode}.", card.Id, (int?)response.StatusCode);
                    _error = response.ErrorText();
                    return;
                }

                // Ответ содержит карточку с итоговым путём изображения: клиент не знает,
                // под каким именем сервер сохранил новый файл.
                card = response.Content;
                Logger.LogInformation("Карточка dashboard изменена. Идентификатор: {CardId}.", card.Id);
            }

            await Saved.InvokeAsync(card);
            await Dialog.CloseAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось сохранить карточку dashboard.");
            _error = "Не удалось сохранить карточку. Проверьте соединение с сервером и попробуйте снова.";
        }
        finally
        {
            _isSaving = false;
            Dialog.SetBusy(false);
        }
    }
    // Выделяет схему из адреса, если она там уже указана.
    private static (UrlScheme Scheme, string Url) SplitScheme(string url)
    {
        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
        {
            return (UrlScheme.Http, url[7..]);
        }

        if (url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return (UrlScheme.Https, url[8..]);
        }

        return (UrlScheme.None, url);
    }

    // Нормализует адрес: схема в самом адресе имеет приоритет над переключателем.
    private static (UrlScheme Scheme, string Url) NormalizeUrl(UrlScheme scheme, string rawUrl)
    {
        var trimmed = rawUrl.Trim();
        var split = SplitScheme(trimmed);

        return split.Scheme != UrlScheme.None ? split : (scheme, trimmed);
    }

    // Запрещает опасные схемы, если адрес задаётся без префикса.
    private static bool IsSafeUrl(UrlScheme scheme, string url)
    {
        if (scheme != UrlScheme.None)
        {
            return true;
        }

        var normalized = url.TrimStart().ToLowerInvariant();

        return !normalized.StartsWith("javascript:", StringComparison.Ordinal)
               && !normalized.StartsWith("data:", StringComparison.Ordinal)
               && !normalized.StartsWith("vbscript:", StringComparison.Ordinal)
               && !normalized.StartsWith("file:", StringComparison.Ordinal)
               && !normalized.StartsWith("blob:", StringComparison.Ordinal);
    }

    // Префикс адреса для выбранной схемы.
    private static string UrlSchemePrefix(UrlScheme scheme) => scheme switch
    {
        UrlScheme.Http => "http://",
        UrlScheme.Https => "https://",
        _ => string.Empty
    };

    private static bool IsValidHexColor(string color)
    {
        if (color.Length != 7 || color[0] != '#')
        {
            return false;
        }

        for (var i = 1; i < color.Length; i++)
        {
            if (!Uri.IsHexDigit(color[i]))
            {
                return false;
            }
        }

        return true;
    }

    public async ValueTask DisposeAsync()
    {
        await _titleLookupCts.CancelAsync();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeClipboard");
                await _module.DisposeAsync();
            }
            catch (Exception)
            {
                // Соединение с JS потеряно: освобождать больше нечего.
            }
        }

        _titleLookupCts.Dispose();
        _selfRef?.Dispose();
    }

    /// <summary>
    /// Редактируемые поля карточки.
    /// </summary>
    private sealed class CardEditModel
    {
        public int CategoryId { get; set; }

        public int Position { get; set; }

        [MaxLength(DomainConstants.CardTitleMaxLength)]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Введите ссылку.")]
        [MaxLength(DomainConstants.CardUrlMaxLength)]
        public string Url { get; set; } = string.Empty;

        public UrlScheme Scheme { get; set; } = UrlScheme.Https;

        public string Color { get; set; } = DefaultColor;

        public string Icon { get; set; } = DefaultIcon;

        public CardStatusMode StatusMode { get; set; } = CardStatusMode.None;

        public bool IsWide { get; set; }

        public bool UseCustomImage { get; set; }

        // Ранее сохранённый путь к изображению-иконке, если пользовательская иконка уже есть.
        public string? ExistingImagePath { get; set; }

        public static CardEditModel FromCard(DashboardCard card)
        {
            // Схема хранится отдельно от адреса; для старых данных допускаем схему внутри адреса.
            var (embeddedScheme, url) = SplitScheme(card.Url);
            var model = new CardEditModel
            {
                CategoryId = card.DashboardCategoryId,
                Position = card.Position,
                Title = card.Title,
                Url = url,
                Scheme = embeddedScheme != UrlScheme.None ? embeddedScheme : card.UrlScheme,
                Color = string.IsNullOrWhiteSpace(card.BackgroundColor) ? DefaultColor : card.BackgroundColor,
                StatusMode = card.StatusMode,
                IsWide = card.IsWide,
                UseCustomImage = card.IsCustomIcon
            };

            // Изображение-иконка: либо пользовательский файл, либо класс Font Awesome.
            if (model.UseCustomImage)
            {
                model.ExistingImagePath = string.IsNullOrWhiteSpace(card.IconSource) ? null : card.IconSource;

                // Файла нет и выбрана пользовательская иконка — начнём со встроенной.
                if (model.ExistingImagePath is null)
                {
                    model.UseCustomImage = false;
                }
            }
            else
            {
                model.Icon = string.IsNullOrWhiteSpace(card.IconSource) ? DefaultIcon : card.IconSource;
            }

            return model;
        }
    }
}
