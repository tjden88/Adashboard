@using Adashboard.Client.Helpers
@inject IDashboardApi DashboardApi
@inject ILogger<CategoryDialog> Logger

@*
    Диалог категории: создание (Category не задана) и изменение (Category передана).
    Открытость окна ведёт вызывающий: PageView — для создания, Category — для изменения.

    Запрос к API (POST или PUT) выполняет сам диалог: при отказе окно остаётся открытым и
    показывает понятный текст ошибки. Итоговую категорию отдаём параметром Saved, а окно
    закрываем сами. Перенос категории на другую страницу — это тоже изменение, поэтому
    страницу выбирают здесь же.
*@

<EditForm Model="_model" OnValidSubmit="SaveAsync" class="category-dialog">
    <DataAnnotationsValidator />

    <div class="category-dialog__field">
        <label for="categoryDialogTitle" class="category-dialog__label">Название категории</label>
        <InputText id="categoryDialogTitle"
                   class="form-control"
                   maxlength="@DomainConstants.CategoryTitleMaxLength"
                   autocomplete="off"
                   placeholder="Например, Сервисы"
                   autofocus
                   @bind-Value="_model.Title" />
        <ValidationMessage For="() => _model.Title" />
    </div>

    @if (Pages.Count > 0)
    {
        <div class="category-dialog__field">
            <label for="categoryDialogPage" class="category-dialog__label">Страница</label>
            <InputSelect id="categoryDialogPage" class="form-select" @bind-Value="_model.PageId">
                @foreach (var item in Pages)
                {
                    <option value="@item.Id">@PageLabel(item)</option>
                }
            </InputSelect>
            <p class="category-dialog__hint">Категорию можно оставить на текущей странице или перенести на другую.</p>
        </div>
    }

    <div class="category-dialog__field">
        <div class="category-dialog__slider-head">
            <label for="categoryDialogWidth" class="category-dialog__label">Ширина</label>
            <span class="category-dialog__width" aria-hidden="true">@_model.Width из @DomainConstants.CategoryWidthMax</span>
        </div>
        <input id="categoryDialogWidth"
               type="range"
               min="@DomainConstants.CategoryWidthMin"
               max="@DomainConstants.CategoryWidthMax"
               step="1"
               value="@_model.Width"
               @oninput="OnWidthInput"
               aria-valuetext="@_model.Width из @DomainConstants.CategoryWidthMax колонок" />
        <p class="category-dialog__hint">Сколько колонок сетки занимает категория.</p>
    </div>

    <div class="category-dialog__field">
        <div class="category-dialog__slider-head">
            <label for="categoryDialogMobileWidth" class="category-dialog__label">Мобильная ширина</label>
            <span class="category-dialog__width" aria-hidden="true">@MobileWidthText</span>
        </div>
        <input id="categoryDialogMobileWidth"
               type="range"
               min="@DomainConstants.CategoryWidthMin"
               max="@DomainConstants.CategoryMobileWidthMax"
               step="1"
               value="@MobileSliderValue"
               disabled="@_mobileAuto"
               @oninput="OnMobileWidthInput"
               aria-valuetext="@MobileWidthText колонок" />
        <label class="category-dialog__auto">
            <input type="checkbox"
                   checked="@_mobileAuto"
                   @onchange="OnMobileAutoChanged" />
            Авто — ширина следует общей сетке
        </label>
        <p class="category-dialog__hint">Отдельная ширина категории на узком экране: 1 — четверть ширины, 4 — вся ширина.</p>
    </div>

    @if (_error is not null)
    {
        <p class="category-dialog__error text-danger" role="alert">@_error</p>
    }

    <div class="category-dialog__actions">
        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>@(_isSaving ? "Сохранение..." : "Сохранить")
        </button>
    </div>
</EditForm>

@code {
    private EditModel _model = new();
    private string? _error;
    private bool _isSaving;
    private bool _mobileAuto = true;

    [CascadingParameter]
    private DialogContainer Dialog { get; set; } = null!;

    /// <summary>
    /// Категория для изменения или <c>null</c> при создании.
    /// </summary>
    [Parameter]
    public DashboardCategory? Category { get; set; }

    /// <summary>
    /// Идентификатор страницы, в которую добавляется новая категория.
    /// </summary>
    [Parameter]
    public int DashboardPageId { get; set; }

    /// <summary>
    /// Порядковый номер новой категории среди остальных.
    /// </summary>
    [Parameter]
    public int Order { get; set; }

    /// <summary>
    /// Список всех страниц: категорию можно отнести к любой из них.
    /// </summary>
    [Parameter]
    public IReadOnlyList<DashboardPage> Pages { get; set; } = [];

    /// <summary>
    /// Уведомление о созданной или изменённой категории: вызывающий обновляет списки.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<DashboardCategory> Saved { get; set; }

    protected override void OnInitialized()
    {
        _model = Category is null
            ? new EditModel { PageId = DashboardPageId }
            : new EditModel
            {
                PageId = Category.DashboardPageId,
                Title = Category.Title,
                Width = Math.Clamp(Category.Width, DomainConstants.CategoryWidthMin, DomainConstants.CategoryWidthMax),
                MobileWidth = Category.MobileWidth
            };

        // Пустая мобильная ширина означает «авто»: слайдер скрыт до явного выбора пользователем.
        _mobileAuto = _model.MobileWidth is null;
    }

    // Подпись страницы в селекторе: путь показываем, чтобы различать страницы с похожими названиями.
    private static string PageLabel(DashboardPage page) => page.Id == 1 ? $"{page.Title} (основная)" : $"{page.Title} — /{page.Path}";

    private void OnWidthInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var width))
        {
            _model.Width = Math.Clamp(width, DomainConstants.CategoryWidthMin, DomainConstants.CategoryWidthMax);
        }
    }

    // Мобильная ширина по умолчанию — производная от десктопной, как вёрстка без явной настройки.
    private int DefaultMobileWidth => Math.Min(Math.Clamp(_model.Width, DomainConstants.CategoryWidthMin, DomainConstants.CategoryWidthMax), DomainConstants.CategoryMobileWidthMax);

    private int MobileSliderValue => _model.MobileWidth ?? DefaultMobileWidth;

    private string MobileWidthText => _mobileAuto
        ? $"Авто — {DefaultMobileWidth} из {DomainConstants.CategoryMobileWidthMax}"
        : $"{MobileSliderValue} из {DomainConstants.CategoryMobileWidthMax}";

    private void OnMobileWidthInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var width))
        {
            _model.MobileWidth = Math.Clamp(width, DomainConstants.CategoryWidthMin, DomainConstants.CategoryMobileWidthMax);
        }
    }

    // Снятие «авто» фиксирует текущую производную ширину как явную, возврат к «авто» — обнуляет настройку.
    private void OnMobileAutoChanged(ChangeEventArgs args)
    {
        _mobileAuto = args.Value is true;
        _model.MobileWidth = _mobileAuto ? null : DefaultMobileWidth;
    }

    private async Task SaveAsync()
    {
        _error = null;
        _isSaving = true;
        Dialog.SetBusy(true);

        try
        {
            var isNew = Category is null;

            // При изменении сохраняем идентификатор и порядок, при создании порядок берём из параметров.
            // Страницу берём из селектора, а если списка страниц нет — остаёмся на текущей.
            var category = new DashboardCategory
            {
                Id = Category?.Id ?? 0,
                DashboardPageId = Pages.Count > 0 ? _model.PageId : DashboardPageId,
                Order = Category?.Order ?? Order,
                Title = _model.Title.Trim(),
                Width = _model.Width,
                MobileWidth = _mobileAuto ? null : _model.MobileWidth ?? DefaultMobileWidth
            };

            if (isNew)
            {
                Logger.LogDebug("Создание категории dashboard {Title}.", category.Title);

                var response = await DashboardApi.CreateCategoryAsync(category);
                if (!response.IsSuccessStatusCode || response.Content is null)
                {
                    Logger.LogWarning("Создание категории завершилось ошибкой API. Код: {StatusCode}.", (int?)response.StatusCode);
                    _error = response.ErrorText();
                    return;
                }

                category = response.Content;
                Logger.LogInformation("Категория dashboard создана. Идентификатор: {CategoryId}.", category.Id);
            }
            else
            {
                Logger.LogDebug("Изменение категории dashboard {CategoryId}.", category.Id);

                var response = await DashboardApi.UpdateCategoryAsync(category);
                if (!response.IsSuccessStatusCode)
                {
                    Logger.LogWarning("Изменение категории завершилось ошибкой API. Код: {StatusCode}.", (int?)response.StatusCode);
                    _error = response.ErrorText();
                    return;
                }

                Logger.LogInformation("Категория dashboard изменена. Идентификатор: {CategoryId}.", category.Id);
            }

            await Saved.InvokeAsync(category);
            await Dialog.CloseAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось сохранить категорию dashboard.");
            _error = "Не удалось сохранить категорию. Проверьте соединение с сервером и попробуйте снова.";
        }
        finally
        {
            _isSaving = false;
            Dialog.SetBusy(false);
        }
    }

    /// <summary>
    /// Редактируемые поля категории.
    /// </summary>
    private sealed class EditModel
    {
        public int PageId { get; set; }

        [Required(ErrorMessage = "Укажите название категории.")]
        public string Title { get; set; } = string.Empty;

        public int Width { get; set; } = 6;

        public int? MobileWidth { get; set; }
    }
}
