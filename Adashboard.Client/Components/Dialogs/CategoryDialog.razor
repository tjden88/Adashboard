@inject IDashboardApi DashboardApi
@inject ILogger<CategoryDialog> Logger

@*
    Диалог создания категории на текущей странице. Открытость окна ведёт PageView.

    Запрос к API (POST) выполняет сам диалог: при отказе окно остаётся открытым и показывает
    понятный текст ошибки. Созданную категорию отдаём параметром Saved, а окно закрываем сами.
*@

<EditForm Model="_model" OnValidSubmit="SaveAsync" class="category-dialog">
    <DataAnnotationsValidator />

    <div class="category-dialog__field">
        <label for="categoryDialogTitle" class="category-dialog__label">Название категории</label>
        <InputText id="categoryDialogTitle"
                   class="form-control"
                   maxlength="@DomainConstants.CategoryTitleMaxLength"
                   autocomplete="off"
                   placeholder="Например, Сервисы"
                   autofocus
                   @bind-Value="_model.Title" />
        <ValidationMessage For="() => _model.Title" />
    </div>

    <div class="category-dialog__field">
        <div class="category-dialog__slider-head">
            <label for="categoryDialogWidth" class="category-dialog__label">Ширина</label>
            <span class="category-dialog__width" aria-hidden="true">@_model.Width из 12</span>
        </div>
        <input id="categoryDialogWidth"
               type="range"
               min="1"
               max="12"
               step="1"
               value="@_model.Width"
               @oninput="OnWidthInput"
               aria-valuetext="@_model.Width из 12 колонок" />
        <p class="category-dialog__hint">Сколько колонок сетки занимает категория. Ширину можно менять и потом.</p>
    </div>

    @if (_error is not null)
    {
        <p class="category-dialog__error text-danger" role="alert">@_error</p>
    }

    <div class="category-dialog__actions">
        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>@(_isSaving ? "Сохранение..." : "Сохранить")
        </button>
    </div>
</EditForm>

@code {
    private EditModel _model = new();
    private string? _error;
    private bool _isSaving;

    [CascadingParameter]
    private DialogContainer Dialog { get; set; } = null!;

    /// <summary>
    /// Идентификатор страницы, в которую добавляется категория.
    /// </summary>
    [Parameter]
    public int DashboardPageId { get; set; }

    /// <summary>
    /// Порядковый номер новой категории среди остальных.
    /// </summary>
    [Parameter]
    public int Order { get; set; }

    /// <summary>
    /// Уведомление о созданной категории: вызывающий добавляет её в список.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<DashboardCategory> Saved { get; set; }

    private void OnWidthInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var width))
        {
            _model.Width = Math.Clamp(width, 1, 12);
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _isSaving = true;
        Dialog.SetBusy(true);

        try
        {
            var category = new DashboardCategory
            {
                DashboardPageId = DashboardPageId,
                Order = Order,
                Title = _model.Title.Trim(),
                Width = _model.Width
            };

            Logger.LogDebug("Создание категории dashboard {Title}.", category.Title);

            var response = await DashboardApi.CreateCategoryAsync(category);
            if (!response.IsSuccessStatusCode || response.Content is null)
            {
                Logger.LogWarning("Создание категории завершилось ошибкой API. Код: {StatusCode}.", (int?)response.StatusCode);
                _error = response.ErrorText();
                return;
            }

            Logger.LogInformation("Категория dashboard создана. Идентификатор: {CategoryId}.", response.Content.Id);

            await Saved.InvokeAsync(response.Content);
            await Dialog.CloseAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось создать категорию dashboard.");
            _error = "Не удалось создать категорию. Проверьте соединение с сервером и попробуйте снова.";
        }
        finally
        {
            _isSaving = false;
            Dialog.SetBusy(false);
        }
    }

    /// <summary>
    /// Редактируемые поля новой категории.
    /// </summary>
    private sealed class EditModel
    {
        [Required(ErrorMessage = "Укажите название категории.")]
        public string Title { get; set; } = string.Empty;

        public int Width { get; set; } = 6;
    }
}
