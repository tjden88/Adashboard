@using Adashboard.Client.Helpers
@inject ILogger<PageDialog> Logger

@*
    Диалог страницы dashboard: создание (Page не задана) и изменение (Page передана).
    Открытость окна ведёт вызывающий (Header или PageView).

    Запросы к API выполняет DashboardDataService: при отказе окно остаётся открытым и
    показывает понятный текст ошибки. Состояние страницы после сохранения обновляет сервис,
    а вызывающий по параметру Saved переходит на страницу (это нужно только для перехода).

    При создании путь генерируется из названия, пока его не ввели вручную. У основной страницы
    путь пустой и не меняется.
*@

<EditForm Model="_model" OnValidSubmit="SaveAsync" class="page-dialog">
    <DataAnnotationsValidator />

    <div class="page-dialog__field">
        <label for="pageDialogTitle" class="page-dialog__label">Название страницы</label>
        <InputText id="pageDialogTitle"
                   class="form-control"
                   maxlength="@DomainConstants.PageTitleMaxLength"
                   autocomplete="off"
                   placeholder="Отображается в заголовке"
                   autofocus
                   @bind-Value="_model.Title"
                   @oninput="OnTitleInput" />
        <ValidationMessage For="() => _model.Title" />
    </div>

    <div class="page-dialog__field">
        <label for="pageDialogDescription" class="page-dialog__label">Описание</label>
        <InputText id="pageDialogDescription"
                   class="form-control"
                   maxlength="@DomainConstants.PageDescriptionMaxLength"
                   autocomplete="off"
                   placeholder="Подзаголовок"
                   @bind-Value="_model.Description" />
    </div>

    <div class="page-dialog__field">
        <span class="page-dialog__label">Иконка</span>
        <div class="page-dialog__icon-row">
            <div class="page-dialog__icon-control">
                <IconPicker @bind-Value="_model.Icon" AriaLabel="Поиск иконки страницы" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_model.Icon))
            {
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="ClearIcon"
                        title="Убрать иконку со страницы"
                        aria-label="Убрать иконку со страницы">
                    <i class="fa-solid fa-eraser" aria-hidden="true"></i>Очистить
                </button>
            }
        </div>
        <p class="page-dialog__hint">Иконка показывается перед заголовком. Оставьте пустым, если иконка не нужна.</p>
    </div>

    <div class="page-dialog__field">
        <span class="page-dialog__label">Цвет иконки</span>
        <ColorPicker @bind-Value="_model.IconColor" AriaLabel="Цвет иконки страницы" />
        <p class="page-dialog__hint">Оставьте пустым, чтобы цвет иконки определялся темой.</p>
    </div>

    <div class="page-dialog__field">
        <label for="pageDialogPath" class="page-dialog__label">Путь</label>
        @if (IsMainPage)
        {
            <p class="page-dialog__hint">Основная страница открывается по корневому адресу.</p>
        }
        else
        {
            <input id="pageDialogPath"
                   class="form-control"
                   type="text"
                   maxlength="@DomainConstants.PagePathMaxLength"
                   autocomplete="off"
                   placeholder="path-to-page"
                   disabled="@IsMainPage"
                   value="@_model.Path"
                   @oninput="OnPathInput" />

            <p class="page-dialog__hint">Латиница, цифры и дефис. Страница будет доступна по адресу /путь.</p>
        }
    </div>

    @if (_error is not null)
    {
        <p class="page-dialog__error text-danger" role="alert">@_error</p>
    }

    <div class="page-dialog__actions">
        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>@(_isSaving ? "Сохранение..." : "Сохранить")
        </button>
    </div>
</EditForm>

@code {
    private EditModel _model = new();
    private string? _error;
    private bool _isSaving;

    // Пока путь не трогали вручную (и страница создаётся), он генерируется из названия.
    private bool _pathTouched;

    [CascadingParameter]
    private DialogContainer Dialog { get; set; } = null!;

    /// <summary>
    /// Единственный владелец dashboard-данных: справочник страниц и сохранение страницы.
    /// </summary>
    [CascadingParameter]
    private DashboardDataService Data { get; set; } = null!;

    /// <summary>
    /// Страница для изменения или <c>null</c> при создании.
    /// </summary>
    [Parameter]
    public DashboardPage? Page { get; set; }

    /// <summary>
    /// Уведомление о созданной или изменённой странице: вызывающий переходит на неё.
    /// Данные обновляет сервис, поэтому уведомление нужно только для перехода.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<DashboardPage> Saved { get; set; }

    private bool IsCreate => Page is null;

    // У основной страницы путь пустой и не меняется.
    private bool IsMainPage => Page is { Id: 1 };

    // Пути всех существующих страниц нужны диалогу для проверки уникальности пути.
    private IEnumerable<string> ExistingPaths => Data.Pages.Select(x => x.Page.Path);

    protected override void OnInitialized()
    {
        _model = Page is null
            ? new EditModel()
            : new EditModel
            {
                Title = Page.Title,
                Description = Page.Description,
                Path = Page.Path,
                Icon = Page.Icon,
                IconColor = Page.IconColor
            };

        // При изменении автогенерация пути выключена: он уже задан.
        _pathTouched = !IsCreate;
    }

    // Название вводится посимвольно, чтобы путь обновлялся сразу; проверки EditForm
    // подхватят значение по штатному событию изменения поля.
    private void OnTitleInput(ChangeEventArgs args)
    {
        _model.Title = args.Value?.ToString() ?? string.Empty;

        if (IsCreate && !_pathTouched)
        {
            _model.Path = PagePathRules.CreateSlug(_model.Title);
        }
    }

    private void OnPathInput(ChangeEventArgs args)
    {
        _pathTouched = true;
        _model.Path = (args.Value?.ToString() ?? string.Empty).Trim().ToLowerInvariant();
    }

    // «Очистить» сбрасывает иконку в пустое значение: страница показывается без иконки.
    private void ClearIcon() => _model.Icon = string.Empty;

    // Цвет иконки — строго hex вида #RRGGBB; пустое значение разрешено (цвет темы).
    private static bool IsValidHexColor(string color)
    {
        if (color.Length != 7 || color[0] != '#')
        {
            return false;
        }

        for (var i = 1; i < color.Length; i++)
        {
            if (!Uri.IsHexDigit(color[i]))
            {
                return false;
            }
        }

        return true;
    }

    private async Task SaveAsync()
    {
        _error = null;

        var title = _model.Title.Trim();
        if (title.Length == 0)
        {
            _error = "Укажите название страницы.";
            return;
        }

        var path = _model.Path.Trim();

        if (IsMainPage)
        {
            // Путь основной страницы зарезервирован и не меняется.
            path = Page!.Path;
        }
        else if (path.Length == 0)
        {
            _error = "Укажите путь страницы.";
            return;
        }
        else if (!PagePathRules.IsValid(path))
        {
            _error = "Путь может содержать только латиницу в нижнем регистре, цифры и дефис.";
            return;
        }

        if (!IsMainPage && IsPathTaken(path))
        {
            _error = "Страница с таким путём уже существует.";
            return;
        }

        // Пустой цвет разрешён: тогда иконка берёт системный цвет темы.
        var iconColor = _model.IconColor.Trim();
        if (iconColor.Length > 0 && !IsValidHexColor(iconColor))
        {
            _error = "Цвет иконки должен быть в формате #RRGGBB.";
            return;
        }

        _isSaving = true;
        Dialog.SetBusy(true);

        try
        {
            var page = new DashboardPage
            {
                Id = Page?.Id ?? 0,
                Title = title,
                Description = _model.Description.Trim(),
                Path = path,
                Icon = _model.Icon.Trim(),
                IconColor = iconColor
            };

            // Запросы выполняет сервис: он же обновляет данные, поэтому отдельное уведомление не нужно.
            var error = IsCreate
                ? await Data.CreatePageAsync(page)
                : await Data.SavePageInfoAsync(page);

            if (error is not null)
            {
                _error = error;
                return;
            }

            // Итоговую страницу берём из сервиса: при создании идентификатор знает только он.
            var saved = IsCreate ? Data.GetPageByPath(path)?.Page : Data.GetPageById(page.Id)?.Page;
            await Saved.InvokeAsync(saved ?? page);

            await Dialog.CloseAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось сохранить страницу dashboard.");
            _error = "Не удалось сохранить страницу. Проверьте соединение с сервером и попробуйте снова.";
        }
        finally
        {
            _isSaving = false;
            Dialog.SetBusy(false);
        }
    }

    // Путь уже занят другой страницей: сервер проверит это же, но ответим сразу, без запроса.
    // Свой путь при изменении не учитываем.
    private bool IsPathTaken(string path)
    {
        foreach (var existing in ExistingPaths)
        {
            if (string.Equals(existing, Page?.Path, StringComparison.Ordinal))
            {
                continue;
            }

            if (string.Equals(existing, path, StringComparison.Ordinal))
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Редактируемые поля страницы.
    /// </summary>
    private sealed class EditModel
    {
        [Required(ErrorMessage = "Укажите название страницы.")]
        public string Title { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public string Path { get; set; } = string.Empty;

        [MaxLength(DomainConstants.PageIconClassMaxLength)]
        public string Icon { get; set; } = string.Empty;

        public string IconColor { get; set; } = string.Empty;
    }
}
