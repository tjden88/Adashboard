@inject NavigationManager Navigation
@inject ILogger<Header> Logger

@*
    Шапка dashboard. Живёт внутри Home.razor (а не в layout): её содержимое относится
    к конкретной странице dashboard.

    Режим редактирования приходит из AppState, данные страницы — из каскадной модели
    DashboardPageModel (обе задаёт Home). Пока страница грузится, вместо текста рисуется
    скелет заголовка, а кнопки остаются на месте. Логотип из настроек сайта подключит
    часть theme/site-settings-dialog.

    Окна диалогов рисуются здесь же: состояние открытости ведёт шапка, содержимое передаётся
    контейнеру как RenderFragment, а закрывает окно сам диалог через каскадный контейнер.
*@

<header class="dashboard-header">
    <div class="dashboard-header-brand">
        <div>
            @if (IsLoading)
            {
                <span class="header-skeleton header-skeleton--title" aria-hidden="true"></span>
                <span class="header-skeleton header-skeleton--subtitle" aria-hidden="true"></span>
            }
            else
            {
                <h1>@Model.DisplayTitle</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Page.Description))
                {
                    <p>@Model.Page.Description</p>
                }
            }
        </div>
    </div>
    <div class="dashboard-header-actions">
        @if (AppState.IsEditMode)
        {
            <button type="button" class="btn btn-sm btn-success" @onclick="() => _isAddPageOpen = true" aria-label="Добавить страницу" title="Добавить страницу">
                <i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>
                <span class="header-button-label">Добавить страницу</span>
            </button>

            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenSiteSettings" aria-label="Настройки сайта" title="Настройки сайта">
                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                <span class="header-button-label">Настройки</span>
            </button>

            @* ВРЕМЕННО: проверка диалога подтверждения. Удалить вместе с подключением удаления страницы в части page-view. *@
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _isConfirmOpen = true" aria-label="Проверить диалог подтверждения" title="Проверить диалог подтверждения">
                <i class="fa-solid fa-vial" aria-hidden="true"></i>
                <span class="header-button-label">Проверка</span>
            </button>
        }

        <button type="button"
                class="px-4 btn btn-icon btn-sm @(AppState.IsEditMode ? "btn-primary" : "btn-outline-secondary")"
                @onclick="ToggleEditMode"
                aria-pressed="@(AppState.IsEditMode ? "true" : "false")"
                aria-label="Переключить режим редактирования"
                title="@(AppState.IsEditMode ? "Завершить редактирование" : "Редактировать")">
            <i class="fa-solid @(AppState.IsEditMode ? "fa-check" : "fa-pen-nib")" aria-hidden="true"></i>
        </button>
    </div>
</header>

<DialogContainer @bind-Open="_isAddPageOpen" Title="Создать страницу">
    <PageDialog Saved="OnPageCreated" />
</DialogContainer>

@* ВРЕМЕННО: второе окно нужно только для проверки ConfirmDialog, пока его не подключит удаление страницы. *@
<DialogContainer @bind-Open="_isConfirmOpen"
                 Title="Подтверждение"
                 Size="DialogContainer.DialogSize.ConfirmDialog"
                 CloseOnOverlayClick="true">
    <ConfirmDialog Message="Это проверка диалога подтверждения. Продолжить?"
                   ConfirmLabel="Подтвердить"
                   Action="ConfirmDialog.ConfirmDialogAction.Primary"
                   Confirmed="OnConfirmChecked" />
</DialogContainer>

@code {
    private bool _isAddPageOpen;
    private bool _isConfirmOpen;

    /// <summary>
    /// Идёт загрузка страницы: вместо заголовка и описания рисуется скелет.
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    [CascadingParameter]
    private AppState AppState { get; set; } = null!;

    [CascadingParameter]
    private DashboardPageModel Model { get; set; } = null!;

    // Созданную страницу открываем: Home загрузит её по новому адресу, а окно закроет сам диалог.
    private void OnPageCreated(DashboardPage page) => Navigation.NavigateTo("/" + page.Path);

    private void OpenSiteSettings()
    {
    }

    // ВРЕМЕННО: проверка ConfirmDialog, пока его не подключит удаление страницы (часть page-view).
    private void OnConfirmChecked() => Logger.LogInformation("Проверка диалога подтверждения: подтверждено.");

    private void ToggleEditMode() => AppState.ToggleEditMode();
}
