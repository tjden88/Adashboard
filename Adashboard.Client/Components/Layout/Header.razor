@inject NavigationManager Navigation
@inject DashboardApiOptions ApiOptions
@implements IDisposable

@*
    Шапка dashboard. Живёт внутри Home.razor (а не в layout): её содержимое относится
    к конкретной странице dashboard.

    Режим редактирования и настройки сайта приходят из AppState (каскадное значение), данные
    страницы — параметром Page от Home: заголовок и описание обновляются сразу после правки
    страницы в диалоге. Пока страница грузится, вместо текста рисуется скелет заголовка,
    а кнопки и иконка остаются на месте.

    Окна диалогов рисуются здесь же: состояние открытости ведёт шапка, содержимое передаётся
    контейнеру как RenderFragment, а закрывает окно сам диалог через каскадный контейнер.
    Настройки приложения шапка показывает только в режиме редактирования и скрытом
    боковом меню: при видимом меню тем же окном управляет дубликат кнопки в самом меню
    (см. SideMenu) и в CSS (см. Header.razor.css). Кнопка редактирования в нормальном
    режиме видна только при скрытом меню; в активном режиме редактирования на десктопе
    видна всегда — при видимом меню дублирует кнопку бокового меню для удобства.
*@

@{
    var isEditMode = AppStateService.IsEditMode;
}

<header class="dashboard-header">
    <div class="dashboard-header-brand">
        @* Кнопка меню на мобильной ширине: стоит слева от иконки страницы. На десктопе
           CSS её скрывает (см. Header.razor.css), порядок элементов туда не влияет. *@
        @if (AppStateService.Settings.SideMenuMode is not SideMenuMode.Hidden)
        {
            <button type="button"
                    id="side-menu-toggle"
                    class="btn btn-icon btn-sm btn-outline-secondary side-menu-toggle"
                    @onclick="ToggleMobileMenu"
                    aria-expanded="@(AppStateService.IsMobileMenuOpen ? "true" : "false")"
                    aria-label="Меню страниц"
                    title="Меню страниц">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
        }

        @if (AppStateService.Settings.ShowPageIcon)
        {
            @if (!string.IsNullOrWhiteSpace(Model.Page.Icon))
            {
                <i class="dashboard-page-icon @Model.Page.Icon" style="@PageIconColor" aria-hidden="true"></i>
            }
            else
            {
                <img class="dashboard-page-icon dashboard-page-icon--image" src="@IconSource" alt="" />
            }
        }

        <div>
            @if (IsLoading)
            {
                <span class="header-skeleton header-skeleton--title" aria-hidden="true"></span>
                <span class="header-skeleton header-skeleton--subtitle" aria-hidden="true"></span>
            }
            else
            {
                <h1>@Model.DisplayTitle</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Page.Description))
                {
                    <p>@Model.Page.Description</p>
                }
            }
        </div>
    </div>
    <div class="dashboard-header-actions">
        @if (isEditMode)
        {
            <button type="button" class="btn btn-sm btn-success" @onclick="() => _isAddPageOpen = true" aria-label="Добавить страницу" title="Добавить страницу">
                <i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>
                <span class="header-button-label">Добавить страницу</span>
            </button>

            @* Настройки — только в режиме редактирования: класс header-settings даёт
               доп. видимость «меню скрыто» (CSS, см. Header.razor.css) — при видимом
               меню тем же окном управляет дубликат в его подвале (см. SideMenu). *@
            <button type="button" class="btn btn-sm btn-outline-secondary header-settings" @onclick="OpenSiteSettings" aria-label="Настройки приложения" title="Настройки приложения">
                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                <span class="header-button-label">Настройки</span>
            </button>

        }

        @* В нормальном режиме кнопка видна только при скрытом боковом меню: вход в режим
           — дубликатом в самом меню (см. SideMenu), видимость задаёт CSS (см. Header.razor.css).
           В режиме редактирования на десктопе видна всегда: при видимом меню она дублирует
           кнопку бокового меню для удобства. На мобильных — как и прежде, только при скрытом меню. *@
        <button type="button"
                class="px-4 btn btn-icon btn-sm header-edit-toggle @(isEditMode ? "btn-primary" : "btn-outline-secondary")"
                @onclick="ToggleEditMode"
                aria-pressed="@(isEditMode ? "true" : "false")"
                aria-label="Переключить режим редактирования"
                title="@(isEditMode ? "Завершить редактирование" : "Редактировать")">
            <i class="fa-solid @(isEditMode ? "fa-check" : "fa-pen-nib")" aria-hidden="true"></i>
        </button>
    </div>
</header>

<DialogContainer @bind-Open="_isAddPageOpen" Title="Создать страницу">
    <PageDialog Saved="OnPageCreated" />
</DialogContainer>

<DialogContainer @bind-Open="_isSettingsOpen" Title="Настройки приложения">
    <AppSettingsDialog />
</DialogContainer>


@code {
    private bool _isAddPageOpen;
    private bool _isSettingsOpen;

    /// <summary>
    /// Идёт загрузка страницы: вместо заголовка и описания рисуется скелет.
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Информационная часть открытой страницы: заголовок и описание в шапке.
    /// </summary>
    [CascadingParameter]
    public DashboardPageModel Model { get; set; } = new();

    [CascadingParameter]
    private AppStateService AppStateService { get; set; } = null!;

    /// <summary>Иконка приложения для страницы без своей иконки: абсолютный путь к статике API,
    /// иначе при раздельном запуске клиента и сервера изображение запрашивалось бы у клиента.</summary>
    private string? IconSource => ApiOptions.ResolveUploadPath(DomainConstants.IconAsset);

    /// <summary>
    /// Инлайновый стиль иконки: заданный на странице цвет, а при пустом значении цвет темы.
    /// </summary>
    private string? PageIconColor => string.IsNullOrWhiteSpace(Model.Page.IconColor)
        ? null
        : $"color:{Model.Page.IconColor}";

    // Созданную страницу открываем: Home загрузит её по новому адресу, а окно закроет сам диалог.
    private void OnPageCreated(DashboardPage page) => Navigation.NavigateTo("/" + page.Path);

    // Настройки сайта сохраняет сам диалог: владелец настроек — AppStateService,
    // а шапка только открывает окно.
    private void OpenSiteSettings() => _isSettingsOpen = true;

    private void ToggleEditMode() => AppStateService.ToggleEditMode();

    /// <summary>Переключает открытость мобильного бокового меню.</summary>
    private void ToggleMobileMenu() => AppStateService.ToggleMobileMenu();

    protected override void OnInitialized()
    {
        Model.PageInfoChanged += ModelOnPageInfoChanged;
    }

    private void ModelOnPageInfoChanged() => StateHasChanged();

    public void Dispose()
    {
        Model.PageInfoChanged -= ModelOnPageInfoChanged;
    }

}
