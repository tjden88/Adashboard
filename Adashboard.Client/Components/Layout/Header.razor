@using Adashboard.Client.Services
@inject EditModeService EditModeService

@*
    Шапка dashboard. Живёт внутри Home.razor (а не в layout): её содержимое относится
    к конкретной странице dashboard.

    Заголовок и описание пока заданы в разметке: реальные данные страницы подключит часть
    page-view, настройки сайта (логотип) — часть theme/site-settings-dialog.
*@

<PageTitle>Adashboard</PageTitle>

<header class="dashboard-header">
    <div class="dashboard-header-brand">
        <div>
            <h1>Adashboard</h1>
            <p>Настраиваемая стартовая страница с виджетами и ссылками.</p>
        </div>
    </div>
    <div class="dashboard-header-actions">
        @if (EditModeService.IsEnabled)
        {
            <button type="button" class="btn btn-sm btn-success" @onclick="OpenAddPageDialog" aria-label="Добавить страницу" title="Добавить страницу">
                <i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>
                <span class="header-button-label">Добавить страницу</span>
            </button>

            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenSiteSettings" aria-label="Настройки сайта" title="Настройки сайта">
                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                <span class="header-button-label">Настройки</span>
            </button>
        }

        <button type="button"
                class="px-4 btn btn-icon btn-sm @(EditModeService.IsEnabled ? "btn-primary" : "btn-outline-secondary")"
                @onclick="ToggleEditMode"
                aria-pressed="@(EditModeService.IsEnabled ? "true" : "false")"
                aria-label="Переключить режим редактирования"
                title="@(EditModeService.IsEnabled ? "Завершить редактирование" : "Редактировать")">
            <i class="fa-solid @(EditModeService.IsEnabled ? "fa-check" : "fa-pen-nib")" aria-hidden="true"></i>
        </button>
    </div>
</header>

@code {
    // Кнопки диалогов пока ничего не делают: сами диалоги появятся в частях dialogs,
    // page-dialog и site-settings-dialog. Разметку и видимость оставляем как в шапке референса.
    private void OpenAddPageDialog()
    {
    }

    private void OpenSiteSettings()
    {
    }

    private void ToggleEditMode() => EditModeService.Toggle();
}
