@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger

@*
    Каркас приложения: оболочка страницы и блок ошибок Blazor.

    Оформление (режим темы и фоновые изображения) применяет этот компонент: он живёт всё
    время работы приложения и получает общие настройки из AppStateService. Настройки уже
    загружены до первого рендера (см. Routes), поэтому режим темы ставится сразу после
    монтирования, а не после ответа API.
*@

<main class="main-shell @(AppStateService.IsEditMode ? "dashboard-edit-mode" : null)">
    <article class="content">
        @Body
    </article>
</main>

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private IJSObjectReference? _module;
    private ThemeMode? _appliedThemeMode;

    [CascadingParameter]
    private AppStateService AppStateService { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeThemeAsync();
        }

        await ApplyThemeAsync();
    }

    // Подключает модуль оформления и передаёт ему адреса фона. Файлы фона лежат в загрузках
    // сервера, поэтому адреса заданы в DomainConstants и ставятся из кода: CSS-переменная
    // не может взять их из C#.
    private async Task InitializeThemeAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
            await _module.InvokeVoidAsync("setBackgroundImages", DomainConstants.LightBackgroundAsset, DomainConstants.DarkBackgroundAsset);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Модуль оформления dashboard не подключён. Действует оформление по умолчанию.");
            _module = null;
        }
    }

    // Тема применяется после загрузки настроек и повторно после сохранения настроек сайта:
    // компоненты-подписчики каскадного значения получают уведомление об изменении состояния.
    private async Task ApplyThemeAsync()
    {
        if (_module is null || _appliedThemeMode == AppStateService.Settings.ThemeMode)
        {
            return;
        }

        var mode = AppStateService.Settings.ThemeMode;

        try
        {
            // Первое применение заодно подписывает режим "auto" на системную тему.
            if (_appliedThemeMode is null)
            {
                await _module.InvokeVoidAsync("initializeTheme", ThemeString(mode));
            }
            else
            {
                await _module.InvokeVoidAsync("setThemeMode", ThemeString(mode));
            }

            _appliedThemeMode = mode;
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Режим темы {ThemeMode} применить не удалось.", mode);
        }
    }

    private static string ThemeString(ThemeMode mode) => mode switch
    {
        ThemeMode.Dark => "dark",
        ThemeMode.Light => "light",
        _ => "auto"
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (Exception)
        {
            // Соединение с JS потеряно: освобождать модуль больше не нужно.
        }
    }
}
