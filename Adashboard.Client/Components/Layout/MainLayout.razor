@inherits LayoutComponentBase
@inject EditModeService EditModeService
@implements IDisposable

<main class="main-shell @(EditModeService.IsEnabled ? "dashboard-edit-mode" : null)">
    <article class="content">
        @Body
    </article>
</main>

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        EditModeService.OnChange += OnEditModeChanged;
    }

    private void OnEditModeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        EditModeService.OnChange -= OnEditModeChanged;
    }
}
