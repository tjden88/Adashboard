@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<SideMenu> Logger
@implements IDisposable

@*
    Левое боковое меню страниц dashboard.

    Режим задаётся в настройках приложения и определяет видимость на десктопе:
    Hidden — не рисуется, Collapsed — узкая полоса с иконками, которая никогда не
    раскрывается (название страницы видно во всплывающей подсказке), AutoCollapse —
    узкая полоса, расширяется по наведению, Expanded — всегда развёрнуто. На мобильных
    (до 900px) режимы не действуют: меню работает как выдвижной drawer с полными
    подписями — открывается кнопкой в шапке, закрывается кликом по подложке или
    клавишей Esc; фокус возвращается к кнопке открытия.
*@

@if (AppStateService.Settings.SideMenuMode is not SideMenuMode.Hidden)
{
    @if (AppStateService.IsMobileMenuOpen)
    {
        <div class="side-menu-backdrop" aria-hidden="true" @onclick="OnBackdropClick"></div>
    }

    <nav class="@NavClass" aria-label="Страницы dashboard" @onkeydown="OnNavKeyDown">
        <ul class="side-menu-list">
            @foreach (var page in Model.Pages)
            {
                var isMain = string.IsNullOrEmpty(page.Path);
                var isActive = IsPageActive(page.Path);
                var label = string.IsNullOrWhiteSpace(page.Title) ? DomainConstants.AppTitle : page.Title;
                var iconClass = string.IsNullOrWhiteSpace(page.Icon) ? "fa-solid fa-file" : page.Icon;
                var iconStyle = string.IsNullOrWhiteSpace(page.IconColor) ? null : $"color:{page.IconColor}";

                <li class="@GetItemClass(isMain, isActive)">
                    @* Подпись скрыта в свёрнутом режиме (visibility: hidden), поэтому
                       скринридеру даём отдельную aria-label той же подписи. *@
                    <a href="@(isMain ? "/" : "/" + page.Path)"
                       class="side-menu-link"
                       title="@label"
                       aria-label="@label"
                       aria-current="@((isActive ? "page" : null))"
                       @onclick="OnPageLinkClick">
                        <i class="@iconClass" style="@iconStyle" aria-hidden="true"></i>
                        <span class="side-menu-label">@label</span>
                    </a>
                </li>
            }
        </ul>

        <footer class="side-menu-footer">
            @* Кнопка редактирования: в нормальном режиме шапка прячет свою кнопку при
               видимом меню (см. Header и Header.razor.css), поэтому вход в режим — здесь.
               В активном режиме на десктопе в шапке видна дублирующая «Завершить». *@
            <button type="button"
                    class="side-menu-edit-btn @(AppStateService.IsEditMode ? "side-menu-edit-btn--on" : null)"
                    @onclick="ToggleEditMode"
                    aria-pressed="@AppStateService.IsEditMode"
                    aria-label="Переключить режим редактирования"
                    title="@(AppStateService.IsEditMode ? "Завершить редактирование" : "Редактировать")">
                <i class="fa-solid @(AppStateService.IsEditMode ? "fa-check" : "fa-pen-nib")" aria-hidden="true"></i>
                <span class="side-menu-label">@(AppStateService.IsEditMode ? "Завершить" : "Редактировать")</span>
            </button>

            @* Дубликат кнопки настроек из шапки: при видимом меню шапка её прячет
               (см. Header и Header.razor.css), поэтому открыть окно можно прямо здесь.
               Окно живёт в меню, а не в шапке: шапка отвечает за режим, где меню скрыто. *@
            <button type="button"
                    class="side-menu-settings-btn"
                    @onclick="OpenSettings"
                    aria-label="Настройки приложения"
                    title="Настройки приложения">
                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                <span class="side-menu-label">Настройки</span>
            </button>
        </footer>
    </nav>

    <DialogContainer @bind-Open="_isSettingsOpen" Title="Настройки приложения">
        <AppSettingsDialog />
    </DialogContainer>
}

@code {
    private bool _isSettingsOpen;

    [CascadingParameter]
    private DashboardPageModel Model { get; set; } = null!;

    [CascadingParameter]
    private AppStateService AppStateService { get; set; } = null!;

    /// <summary>Класс корневой ветки меню: режим (скрыто/свёрнуто/автосворачивание/развёрнуто) + признак открытого мобильного drawer.</summary>
    private string NavClass
    {
        get
        {
            var cls = "side-menu";
            switch (AppStateService.Settings.SideMenuMode)
            {
                case SideMenuMode.Expanded:
                    cls += " side-menu--expanded";
                    break;
                case SideMenuMode.AutoCollapse:
                    cls += " side-menu--auto";
                    break;
                case SideMenuMode.Collapsed:
                    cls += " side-menu--collapsed";
                    break;
            }
            if (AppStateService.IsMobileMenuOpen)
            {
                cls += " side-menu--open";
            }
            return cls;
        }
    }

    /// <summary>Класс пункта меню: признак главной страницы (пустой путь) и активной текущей страницы.</summary>
    private static string GetItemClass(bool isMain, bool isActive)
    {
        var cls = "side-menu-item";
        if (isMain) cls += " side-menu-item--main";
        if (isActive) cls += " side-menu-item--active";
        return cls;
    }

    /// <summary>Совпадает ли путь страницы с текущим адресом (без учёта регистра).</summary>
    private bool IsPageActive(string? pagePath)
    {
        var current = GetCurrentPath();
        if (string.IsNullOrEmpty(pagePath))
            return current.Length == 0;
        return string.Equals(current, pagePath.ToLowerInvariant(), StringComparison.Ordinal);
    }

    /// <summary>Текучий путь без строки запроса и хэша, в нижнем регистре, без крайних слэшей.</summary>
    private string GetCurrentPath()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var cut = path.IndexOfAny(['?', '#']);
        if (cut >= 0) path = path[..cut];
        return path.Trim('/').ToLowerInvariant();
    }

    /// <summary>Esc закрывает мобильное меню и возвращает фокус к кнопке открытия.</summary>
    private async Task OnNavKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || !AppStateService.IsMobileMenuOpen) return;

        AppStateService.CloseMobileMenu();

        try
        {
            // Модуль кэшируется браузером: повторный import не создаёт нового экземпляра.
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
            await module.InvokeVoidAsync("focusElementById", "side-menu-toggle");
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogDebug(ex, "Не удалось вернуть фокус к кнопке мобильного меню.");
        }
    }

    /// <summary>Переключает режим редактирования (дубликат кнопки из шапки).</summary>
    private void ToggleEditMode() => AppStateService.ToggleEditMode();

    /// <summary>Открывает окно настроек приложения; на мобильных drawer закрывает, как и клик по ссылке страницы.</summary>
    private void OpenSettings()
    {
        AppStateService.CloseMobileMenu();
        _isSettingsOpen = true;
    }

    /// <summary>Клик по затемнённому фону закрывает мобильное меню.</summary>
    private void OnBackdropClick() => AppStateService.CloseMobileMenu();

    /// <summary>Клик по пункту меню закрывает мобильный drawer (навигация продолжает работу).</summary>
    private void OnPageLinkClick() => AppStateService.CloseMobileMenu();

    /// <summary>Перерисовка при изменении списка страниц (создание, удаление, смена текущей).</summary>
    private void OnPageInfoChanged() => StateHasChanged();

    protected override void OnInitialized()
    {
        Model.PageInfoChanged += OnPageInfoChanged;
    }

    public void Dispose()
    {
        Model.PageInfoChanged -= OnPageInfoChanged;
    }
}
