@using Adashboard.Client.Components.Pages
@using Adashboard.Client.Services
@using Refit
@implements IAsyncDisposable
@inject EditModeService EditModeService
@inject SiteSettingsService SettingsService
@inject DialogService DialogService
@inject DashboardApiOptions ApiOptions
@inject IDashboardApi DashboardApi
@inject IJSRuntime JS
@inject ILogger<PageHeader> Logger

@*
    Шапка dashboard: логотип, заголовок и описание страницы и кнопки управления.

    Компонент владеет настройками сайта: загружает их через SiteSettingsService, применяет тему
    оформления и показывает логотип по настройке ShowLogo. Он же переключает режим редактирования,
    открывает настройки сайта и добавление новой страницы. Настройки и удаление текущей страницы
    и создание категорий живут на самой странице (PageView), потому что относятся к её содержимому.
*@

<PageTitle>@PageTitleText</PageTitle>

<header class="dashboard-header">
    <div class="dashboard-header-brand">
        @if (_settings.ShowLogo)
        {
            <img class="dashboard-logo" src="@LogoPath" alt="" />
        }
        <div>
            <h1>@Page.Title</h1>
            <p>@Page.Description</p>
        </div>
    </div>
    <div class="dashboard-header-actions">
        @if (EditModeService.IsEnabled)
        {
            <button type="button" class="btn btn-icon btn-sm btn-success" @onclick="OpenAddPageDialog" aria-label="Добавить страницу" title="Добавить страницу">
                <i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>
            </button>

            <button type="button" class="btn btn-icon btn-sm btn-outline-secondary" @onclick="OpenSiteSettings" aria-label="Настройки сайта" title="Настройки сайта">
                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
            </button>
        }

        <button type="button"
                class="px-4 btn btn-icon btn-sm @(EditModeService.IsEnabled ? "btn-primary" : "btn-outline-secondary")"
                @onclick="ToggleEditMode"
                aria-pressed="@EditModeService.IsEnabled"
                aria-label="Переключить режим редактирования"
                title="@(EditModeService.IsEnabled ? "Завершить редактирование" : "Редактировать")">
            <i class="fa-solid @(EditModeService.IsEnabled ? "fa-check" : "fa-pen-nib")" aria-hidden="true"></i>
        </button>
    </div>
</header>

@code {
    // Файлы оформления лежат в каталоге загрузок API, а не в статике клиента. Путь к логотипу
    // переводим в абсолютный адрес API (ResolveUploadPath), иначе при запуске клиента отдельно
    // от сервера он запрашивался бы у клиентского dev-сервера и давал 404.
    private const string LogoAsset = "/uploads/assets/logo.png";

    private IJSObjectReference? _module;
    private SiteSettings _settings = new();

    /// <summary>Информационная часть страницы, отображаемая в шапке.</summary>
    [Parameter, EditorRequired]
    public DashboardPage Page { get; set; } = null!;

    /// <summary>Список всех страниц: нужен для проверки уникальности пути при создании.</summary>
    [Parameter]
    public IReadOnlyList<DashboardPage> Pages { get; set; } = [];

    /// <summary>Уведомление родителя о созданной странице.</summary>
    [Parameter]
    public EventCallback<DashboardPage> PageCreated { get; set; }

    private string LogoPath => ApiOptions.ResolveUploadPath(LogoAsset)!;

    // Заголовок вкладки браузера повторяет заголовок в шапке, а при пустом значении — «Adashboard».
    private string PageTitleText => string.IsNullOrWhiteSpace(Page.Title) ? "Adashboard" : Page.Title;

    protected override async Task OnInitializedAsync()
    {
        EditModeService.OnChange += OnEditModeChanged;
        SettingsService.OnChange += OnSettingsChanged;

        _settings = SettingsService.Current;

        // Настройки загружаем до первого рендера, чтобы тема, логотип и интервал проверки
        // применились сразу и не было лишнего переключения темы.
        await SettingsService.LoadAsync();
        _settings = SettingsService.Current;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            // Модуль темы подключаем на первом рендере и применяем сохранённый режим.
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
            await _module.InvokeVoidAsync("initializeTheme", ThemeString(_settings.ThemeMode));
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnEditModeChanged() => InvokeAsync(StateHasChanged);

    private void OnSettingsChanged()
    {
        _settings = SettingsService.Current;

        // Тема применяется сразу после сохранения, не дожидаясь перерисовки.
        if (_module is not null)
        {
            _ = ApplyThemeAsync(_settings.ThemeMode);
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task ApplyThemeAsync(ThemeMode mode)
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("setThemeMode", ThemeString(mode));
        }
        catch (JSException)
        {
            // Соединение с JS потеряно: тему применит следующий успешный рендер.
        }
    }

    // ---------------------------------------------------------------
    // Создание новой страницы.
    // ---------------------------------------------------------------

    private void OpenAddPageDialog()
    {
        // Страницу создаёт сам диалог (через API), а результат уходит родителю.
        var parameters = new Dictionary<string, object?>
        {
            [nameof(PageDialog.ExistingPaths)] = Pages.Select(x => x.Path).ToList(),
            [nameof(PageDialog.OnSave)] = EventCallback.Factory.Create<DashboardPage>(this, OnPageCreatedAsync)
        };

        DialogService.Show<PageDialog>("Создать страницу", parameters, closeOnOverlayClick: false);
    }

    private async Task OnPageCreatedAsync(DashboardPage page)
    {
        await PageCreated.InvokeAsync(page);
        DialogService.Close();
    }

    // ---------------------------------------------------------------
    // Настройки сайта.
    // ---------------------------------------------------------------

    private void OpenSiteSettings()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(SiteSettingsDialog.Settings)] = SettingsService.Current,
            [nameof(SiteSettingsDialog.OnSave)] = EventCallback.Factory.Create<SiteSettings>(this, SaveSiteSettingsAsync)
        };

        DialogService.Show<SiteSettingsDialog>("Настройки сайта", parameters, closeOnOverlayClick: false);
    }

    private async Task SaveSiteSettingsAsync(SiteSettings settings)
    {
        // Сервис сохраняет настройки через API и уведомляет подписчиков (OnSettingsChanged).
        await SettingsService.SaveAsync(settings);
        await InvokeAsync(StateHasChanged);
        DialogService.Close();
    }

    // ---------------------------------------------------------------
    // Режим редактирования.
    // ---------------------------------------------------------------

    private void ToggleEditMode() => EditModeService.Toggle();

    private static string ThemeString(ThemeMode mode) => mode switch
    {
        ThemeMode.Dark => "dark",
        ThemeMode.Light => "light",
        _ => "auto"
    };

    public async ValueTask DisposeAsync()
    {
        EditModeService.OnChange -= OnEditModeChanged;
        SettingsService.OnChange -= OnSettingsChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
