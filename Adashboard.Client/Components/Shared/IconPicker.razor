@*
    Выбор встроенной иконки Font Awesome: поле поиска со списком подходящих классов иконок,
    образец выбранной иконки и ссылка на поиск иконок на сайте библиотеки.

    Справочник классов лежит в домене (FontAwesomeIcons), поэтому поиск идёт по нему,
    а не по разметке Font Awesome. Список управляется с клавиатуры: стрелки перемещают
    подсветку, Enter выбирает вариант, Esc закрывает подсказки; роли combobox/listbox/option
    и aria-activedescendant описывают это скринридеру.
*@

<div class="icon-picker">
    <div class="icon-picker__field">
        <a class="icon-picker__search-link"
           href="https://fontawesome.com/v6/search"
           target="_blank"
           rel="noopener noreferrer"
           title="Поиск иконок на fontawesome.com"
           aria-label="Открыть поиск иконок Font Awesome в новой вкладке">
            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
        <span class="icon-picker__preview" aria-hidden="true">
            <i class="@Value"></i>
        </span>
        <input class="form-control icon-picker__input"
               type="text"
               autocomplete="off"
               spellcheck="false"
               role="combobox"
               aria-autocomplete="list"
               aria-expanded="@(_matches.Count > 0 ? "true" : "false")"
               aria-controls="@_listId"
               aria-activedescendant="@ActiveOptionId"
               placeholder="Например: house, docker, github"
               value="@_searchText"
               aria-label="@AriaLabel"
               @oninput="OnSearchInput"
               @onkeydown="OnKeyDownAsync" />
    </div>

    @if (_matches.Count > 0)
    {
        <ul class="icon-picker__list" id="@_listId" role="listbox">
            @for (var index = 0; index < _matches.Count; index++)
            {
                var optionIndex = index;
                var icon = _matches[optionIndex];

                <li id="@OptionId(optionIndex)"
                    class="icon-picker__item @(optionIndex == _activeIndex ? "is-active" : null)"
                    role="option"
                    aria-selected="@(optionIndex == _activeIndex ? "true" : "false")"
                    @onclick="() => SelectIconAsync(icon)">
                    <i class="@icon" aria-hidden="true"></i>
                    <span>@icon</span>
                </li>
            }
        </ul>
    }
</div>

@code {
    private const int MaxResults = 30;

    // Идентификаторы списка и вариантов уникальны: по ним поле связывается со списком для скринридера.
    private readonly string _listId = $"icon-list-{Guid.NewGuid():N}";

    private string _searchText = string.Empty;
    private IReadOnlyList<string> _matches = [];
    private int _activeIndex = -1;

    /// <summary>
    /// Текущий CSS-класс выбранной иконки.
    /// </summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Уведомление о выборе иконки: поддерживает <c>@bind-Value</c>.
    /// </summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Подпись поля для скринридеров.
    /// </summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Поиск иконки";

    // Подсвеченный вариант: по нему поле сообщает скринридеру активный пункт списка.
    private string? ActiveOptionId => _activeIndex >= 0 && _activeIndex < _matches.Count ? OptionId(_activeIndex) : null;

    private string OptionId(int index) => $"{_listId}-{index}";

    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;

        var search = _searchText.Trim();
        _matches = search.Length == 0
            ? []
            : FontAwesomeIcons.Icons
                .Where(x => x.Contains(search, StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
                .Take(MaxResults)
                .ToList();

        // Список изменился: прежняя подсветка к нему уже не относится.
        _activeIndex = -1;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (_matches.Count == 0)
        {
            return;
        }

        switch (args.Key)
        {
            case "ArrowDown":
                _activeIndex = (_activeIndex + 1) % _matches.Count;
                break;
            case "ArrowUp":
                _activeIndex = _activeIndex <= 0 ? _matches.Count - 1 : _activeIndex - 1;
                break;
            case "Enter":
                if (_activeIndex >= 0)
                {
                    await SelectIconAsync(_matches[_activeIndex]);
                }

                break;
            case "Escape":
                _matches = [];
                _activeIndex = -1;
                break;
        }
    }

    private async Task SelectIconAsync(string icon)
    {
        Value = icon;
        _searchText = icon;
        _matches = [];
        _activeIndex = -1;
        await ValueChanged.InvokeAsync(icon);
    }
}
