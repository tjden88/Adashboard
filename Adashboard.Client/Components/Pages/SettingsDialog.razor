@*
    Диалог настроек раскладки dashboard.

    Здесь редактируются только заголовок и описание: они хранятся в раскладке (DashboardLayout)
    и сохраняются отдельным запросом PUT /api/layout/info. Общие настройки сайта (тема, показ
    логотипа, интервал проверки) живут в отдельном диалоге SiteSettingsDialog.
*@

<form class="settings-dialog" @onsubmit="Save" @onsubmit:preventDefault>
    <div class="settings-section">
        <label for="siteTitle">Заголовок dashboard</label>
        <input id="siteTitle"
               class="form-control"
               type="text"
               maxlength="120"
               autocomplete="off"
               value="@_model.Title"
               @oninput="args => _model.Title = args.Value?.ToString() ?? string.Empty" />
    </div>

    <div class="settings-section">
        <label for="siteDescription">Описание</label>
        <input id="siteDescription"
               class="form-control"
               type="text"
               maxlength="300"
               autocomplete="off"
               value="@_model.Description"
               @oninput="args => _model.Description = args.Value?.ToString() ?? string.Empty" />
    </div>

    @if (_error is not null)
    {
        <p class="text-danger" role="alert">@_error</p>
    }

    <div class="settings-dialog__actions">
        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>@(_isSaving ? "Сохранение..." : "Сохранить")
        </button>
    </div>
</form>

@code {
    private EditModel _model = new();
    private string? _error;
    private bool _isSaving;

    /// <summary>Раскладка, заголовок и описание которой редактируются.</summary>
    [Parameter, EditorRequired]
    public DashboardLayout Layout { get; set; } = null!;

    /// <summary>Событие сохранения: владелец раскладки сохраняет её через API.</summary>
    [Parameter, EditorRequired]
    public required EventCallback OnSave { get; set; }

    protected override void OnInitialized() => _model = new EditModel
    {
        Title = Layout.Title,
        Description = Layout.Description
    };

    private async Task Save()
    {
        _error = null;

        // API требует непустой заголовок: проверяем до запроса, чтобы показать понятное сообщение.
        var title = _model.Title.Trim();
        if (title.Length == 0)
        {
            _error = "Укажите заголовок dashboard.";
            return;
        }

        _isSaving = true;

        try
        {
            Layout.Title = title;
            Layout.Description = _model.Description.Trim();
            await OnSave.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>Набор редактируемых полей раскладки.</summary>
    private sealed class EditModel
    {
        public string Title { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;
    }
}
