@*
    Диалог общих настроек dashboard.

    Сейчас здесь редактируются только заголовок и описание: они хранятся в раскладке
    (DashboardLayout) и сохраняются отдельным запросом PUT /api/layout/info. Прежние
    настройки сайта (тема, показ логотипа, интервал проверки) вынесены в отдельную
    задачу и пока зашиты константами на клиенте, поэтому в этом диалоге их нет.
*@

<form class="settings-dialog" @onsubmit="Save" @onsubmit:preventDefault>
    <div class="settings-section">
        <label for="siteTitle">Заголовок dashboard</label>
        <input id="siteTitle"
               class="form-control"
               type="text"
               maxlength="120"
               autocomplete="off"
               value="@_title"
               @oninput="args => _title = args.Value?.ToString() ?? string.Empty" />
    </div>

    <div class="settings-section">
        <label for="siteDescription">Описание</label>
        <input id="siteDescription"
               class="form-control"
               type="text"
               maxlength="300"
               autocomplete="off"
               value="@_description"
               @oninput="args => _description = args.Value?.ToString() ?? string.Empty" />
    </div>

    @if (_error is not null)
    {
        <p class="text-danger" role="alert">@_error</p>
    }

    <div class="settings-dialog__actions">
        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>@(_isSaving ? "Сохранение..." : "Сохранить")
        </button>
    </div>
</form>

@code {
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string? _error;
    private bool _isSaving;

    /// <summary>Раскладка, заголовок и описание которой редактируются.</summary>
    [Parameter, EditorRequired]
    public DashboardLayout Layout { get; set; } = null!;

    /// <summary>Событие сохранения: родитель сохраняет раскладку через API.</summary>
    [Parameter, EditorRequired]
    public required EventCallback OnSave { get; set; }

    protected override void OnInitialized()
    {
        _title = Layout.Title;
        _description = Layout.Description;
    }

    private async Task Save()
    {
        _error = null;

        // API требует непустой заголовок: проверяем до запроса, чтобы показать понятное сообщение.
        var title = _title.Trim();
        if (title.Length == 0)
        {
            _error = "Укажите заголовок dashboard.";
            return;
        }

        _isSaving = true;

        try
        {
            Layout.Title = title;
            Layout.Description = _description.Trim();
            await OnSave.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
