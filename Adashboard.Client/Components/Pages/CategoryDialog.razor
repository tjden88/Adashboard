@using Adashboard.Client.Services
@using Refit
@inject IDashboardApi DashboardApi
@inject ILogger<CategoryDialog> Logger

@*
    Диалог создания и изменения категории.

    Запросы к API выполняются здесь же (как и у CardDialog): создание — POST, изменение — PUT.
    Родителю возвращается итоговая контрактная модель через OnSave.
*@

<form class="category-dialog" @onsubmit="Save" @onsubmit:preventDefault>
    <div class="category-dialog__field">
        <label for="categoryTitle" class="category-dialog__label">Название категории</label>
        <input id="categoryTitle"
               class="form-control"
               type="text"
               maxlength="120"
               autocomplete="off"
               placeholder="Обязательно"
               value="@_model.Title"
               @oninput="args => _model.Title = args.Value?.ToString() ?? string.Empty" />
    </div>

    <div class="category-dialog__field">
        <label for="categoryPage" class="category-dialog__label">Страница</label>
        <select id="categoryPage" class="form-control" value="@_model.PageId" @onchange="OnPageSelected">
            @foreach (var item in Pages)
            {
                <option value="@item.Id">@PageLabel(item)</option>
            }
        </select>
    </div>

    <div class="category-dialog__field">
        <div class="category-dialog__slider-head">
            <label for="categoryWidth" class="category-dialog__label">Ширина</label>
            <span class="category-dialog__width-value" aria-hidden="true">
                @_model.Width из 12
            </span>
        </div>
        <input id="categoryWidth"
               type="range"
               min="1"
               max="12"
               step="1"
               value="@_model.Width"
               @oninput="OnWidthInput"
               aria-valuetext="@_model.Width из 12 колонок" />
    </div>

    @if (_error is not null)
    {
        <p class="text-danger" role="alert">@_error</p>
    }

    <div class="category-dialog__actions">
        <button type="submit" class="btn btn-primary" disabled="@(_titleInvalid || _isSaving)">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>@(_isSaving ? "Сохранение..." : "Сохранить")
        </button>
    </div>
</form>

@code {
    private CategoryEditModel _model = new();
    private string? _error;
    private bool _isSaving;

    /// <summary>Категория для редактирования или <c>null</c> при создании.</summary>
    [Parameter]
    public DashboardCategory? Category { get; set; }

    /// <summary>Идентификатор страницы, в которую добавляется новая категория.</summary>
    [Parameter]
    public int DashboardPageId { get; set; }

    /// <summary>Список всех страниц: категорию можно отнести к любой из них.</summary>
    [Parameter]
    public IReadOnlyList<DashboardPage> Pages { get; set; } = [];

    /// <summary>Порядок новой категории (используется только при создании).</summary>
    [Parameter]
    public int Order { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback<DashboardCategory> OnSave { get; set; }

    private bool _titleInvalid => string.IsNullOrWhiteSpace(_model.Title);

    protected override void OnInitialized()
    {
        _model = Category is null
            ? new CategoryEditModel { PageId = DashboardPageId }
            : CategoryEditModel.FromCategory(Category);
    }

    private void OnPageSelected(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var pageId))
        {
            _model.PageId = pageId;
        }
    }

    // Подпись страницы в селекторе: путь показываем, чтобы различать страницы с похожими названиями.
    private static string PageLabel(DashboardPage page)
        => page.Path.Length == 0 ? $"{page.Title} (основная)" : $"{page.Title} — /{page.Path}";

    private void OnWidthInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var width))
        {
            _model.Width = Math.Clamp(width, 1, 12);
        }
    }

    private async Task Save()
    {
        if (_titleInvalid)
        {
            return;
        }

        _error = null;
        _isSaving = true;

        try
        {
            var isNew = Category is null;

            // Собираем контрактную модель из редактируемых полей: при изменении сохраняем
            // идентификатор и порядок, при создании берём порядок из параметров.
            var category = new DashboardCategory
            {
                Id = Category?.Id ?? 0,
                DashboardPageId = _model.PageId,
                Order = Category?.Order ?? Order,
                Title = _model.Title.Trim(),
                Width = _model.Width
            };

            if (isNew)
            {
                category = await DashboardApi.CreateCategoryAsync(category);
            }
            else
            {
                await DashboardApi.UpdateCategoryAsync(category);
            }

            await OnSave.InvokeAsync(category);
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Сохранение категории завершилось ошибкой API. Код: {StatusCode}.", ex.StatusCode);
            _error = $"Не удалось сохранить категорию (код {(int)ex.StatusCode}).";
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>Набор редактируемых полей категории.</summary>
    private sealed class CategoryEditModel
    {
        public int PageId { get; set; }

        public string Title { get; set; } = string.Empty;

        public int Width { get; set; } = 4;

        public static CategoryEditModel FromCategory(DashboardCategory category) => new()
        {
            PageId = category.DashboardPageId,
            Title = category.Title,
            Width = Math.Clamp(category.Width, 1, 12)
        };
    }
}
