@page "/"
@page "/{PagePath}"


<PageView PagePath="@PagePath" />

@code {
    /// <summary>
    /// Путь открытой страницы из адреса. <c>null</c> для корневого адреса «/».
    /// </summary>
    [Parameter]
    public string? PagePath { get; set; }

    [CascadingParameter]
    public string? PageTitle { get; set; } = "test";
}
