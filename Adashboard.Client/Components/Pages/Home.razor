@page "/"
@page "/{**PagePath}"

@using Adashboard.Client.Helpers

@inject NavigationManager Navigation
@inject ILogger<Home> Logger

@*
    Точка маршрута dashboard: любой путь открывается здесь. При первом открытии вкладки Home один раз
    загружает снапшот через DashboardDataService, а дальше по маршруту только выбирает страницу из
    локальных данных сервиса — запросов к API при переходах нет.

    Шапка и боковое меню рисуются вне условий ниже: Blazor сохраняет один и тот же экземпляр
    компонента, если он остаётся на своём месте в дереве, — при таком разборе переход между
    страницами обновляет только содержимое, а меню и шапка не пересоздаются (без мерцания и
    потери своего состояния). Состояния загрузки, ошибки, «страница не найдена» и
    «dashboard не настроен» относятся к маршруту, поэтому живут только в блоке контента.
    Индикатор загрузки показываем только на первичной загрузке снапшота.
*@

<PageTitle>@PageTitleText</PageTitle>

<SideMenu/>
<Header />

@if (Data.IsLoading)
{
    <div class="page-status" role="status" aria-live="polite" aria-label="Загрузка страницы">
        <span class="page-status__spinner" aria-hidden="true"></span>
    </div>
}
else if (Data.Error is not null)
{
    <section class="page-status" role="alert">
        <h1 class="page-status__title">Не удалось открыть страницу</h1>
        <p class="page-status__text page-status__text--error">@Data.Error</p>
        <button type="button" class="btn btn-primary" @onclick="RetryAsync">
            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i> Повторить
        </button>
    </section>
}
else if (_isNotFound)
{
    <section class="page-status" role="alert">
        <p class="page-status__code" aria-hidden="true">404</p>
        <h1 class="page-status__title">Страница не найдена</h1>
        <p class="page-status__text">Такой страницы нет. Проверьте адрес или вернитесь на основную страницу.</p>
        <a class="btn btn-primary" href="/">
            <i class="fa-solid fa-house" aria-hidden="true"></i> На главную
        </a>
    </section>
}
else if (_isNotConfigured)
{
    <section class="page-status" role="alert">
        <h1 class="page-status__title">Сервер не настроен</h1>
        <p class="page-status__text">Основная страница не найдена. Проверьте состояние данных на сервере.</p>
    </section>
}
else
{
    <PageView/>
}

@code {
    // Единственный владелец dashboard-данных: снапшот страниц, категорий и карточек.
    [CascadingParameter]
    private DashboardDataService Data { get; set; } = null!;

    private bool _isNotFound;
    private bool _isNotConfigured;

    /// <summary>
    /// Путь страницы из адреса. <c>null</c> или пустая строка — основная страница «/».
    /// </summary>
    [Parameter]
    public string? PagePath { get; set; }

    // Заголовок вкладки: у найденной страницы — её заголовок, при «не найдена» — отдельная подпись,
    // в остальных состояниях страница пуста и подставляется имя приложения.
    private string PageTitleText => _isNotFound ? "Страница не найдена" : Data.SelectedPage.Page.DisplayTitle();

    protected override async Task OnParametersSetAsync()
    {
        var normalized = NormalizePath(PagePath);

        // Снапшот загружается один раз при старте вкладки; повторная загрузка — только retry после ошибки.
        // Проверка IsLoading нужна, потому что уведомление каскадного значения вызывает этот метод
        // повторно изнутри загрузки: без него загрузка запускалась бы рекурсивно.
        if (!Data.IsLoaded && !Data.IsLoading)
        {
            var error = await Data.LoadSnapshotAsync();
            if (error is not null)
            {
                return;
            }
        }

        if (Data.IsLoading)
        {
            return;
        }

        await ApplyRouteAsync(normalized);
    }

    // Повторная загрузка снапшота (кнопка «Повторить» после ошибки) и выбор страницы по текущему адресу.
    private async Task RetryAsync()
    {
        if (Data.IsLoading)
        {
            return;
        }

        var error = await Data.LoadSnapshotAsync();
        if (error is not null)
        {
            return;
        }

        await ApplyRouteAsync(NormalizePath(PagePath));
    }

    // Формирует страницу из локальных данных сервиса: к API здесь не обращаемся.
    private async Task ApplyRouteAsync(string normalized)
    {
        if (Data.IsLoading || Data.Error is not null)
        {
            return;
        }

        // Регистр пути из адреса не важен, поэтому допустимость проверяем без его учёта:
        // адрес «/About» открывает страницу «about», а невозможный путь сразу даёт 404.
        if (normalized.Length > 0 && !PagePathRules.IsValid(normalized.ToLowerInvariant()))
        {
            ApplyNotFound(normalized);
            return;
        }

        var page = Data.GetPageByPath(normalized);
        if (page is null)
        {
            // Отсутствие основной страницы — это не «ненайденный адрес», а ненастроенный dashboard.
            if (normalized.Length == 0)
            {
                ApplyNotConfigured(normalized);
            }
            else
            {
                ApplyNotFound(normalized);
            }

            return;
        }

        _isNotFound = false;
        _isNotConfigured = false;

        Data.SelectPage(page);

        // Путь в адресе мог отличаться регистром или лишним слэшем: запоминаем канонический путь,
        // чтобы повторный вызов маршрута не запускал выбор страницы снова.
        CanonicalizeUrl(page.Page.Path);
    }

    // Приводит состояние к «страница не найдена».
    private void ApplyNotFound(string path)
    {
        Logger.LogWarning("Страница по пути {Path} не найдена.", path);

        Data.SelectPage(null);
        _isNotFound = true;
        _isNotConfigured = false;
    }

    // Приводит состояние к «dashboard не настроен»: страницы с пустым путём (основной) нет.
    private void ApplyNotConfigured(string path)
    {
        Logger.LogWarning("Основная страница не найдена: сервер не настроен. Путь: {Path}.", path);

        Data.SelectPage(null);
        _isNotConfigured = true;
        _isNotFound = false;
    }

    // Заменяет адрес на канонический путь страницы, убирая различия в регистре и лишние слэши.
    private void CanonicalizeUrl(string pagePath)
    {
        // Текущий путь без ведущего слэша и без строки запроса и хэша.
        var current = Navigation.ToBaseRelativePath(Navigation.Uri);
        var cutIndex = current.IndexOfAny(['?', '#']);
        if (cutIndex >= 0)
        {
            current = current[..cutIndex];
        }

        if (string.Equals(current, pagePath, StringComparison.Ordinal))
        {
            return;
        }

        // Замена без новой записи в истории: кнопка «Назад» не должна возвращать на неканонический адрес.
        Navigation.NavigateTo(pagePath.Length == 0 ? "/" : "/" + pagePath, replace: true);
    }

    // Приводит путь из адреса к виду, в котором он хранится: без ведущих и завершающих слэшей.
    private static string NormalizePath(string? path) => path?.Trim().Trim('/') ?? string.Empty;
}
