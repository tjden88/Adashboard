@*
    Диалог общих настроек сайта dashboard.

    Здесь редактируются настройки, не связанные со страницами: режим темы, показ логотипа
    и интервал проверки статуса карточек. Сохранение и применение выполняет владелец настроек
    (SiteSettingsService) по событию OnSave.
*@

<form class="settings-dialog" @onsubmit="Save" @onsubmit:preventDefault>
    <div class="settings-section">
        <label class="settings-dialog__label">Тема оформления</label>
        <div class="settings-dialog__options" role="radiogroup" aria-label="Тема оформления">
            @foreach (var option in ThemeOptions)
            {
                <label class="settings-dialog__option">
                    <input type="radio"
                           name="themeMode"
                           checked="@(_model.ThemeMode == option.Mode)"
                           @onchange="() => _model.ThemeMode = option.Mode" />
                    <span>@option.Title</span>
                </label>
            }
        </div>
    </div>

    <div class="settings-section">
        <label class="settings-dialog__toggle" for="showLogo">
            <input id="showLogo"
                   type="checkbox"
                   checked="@_model.ShowLogo"
                   @onchange="args => _model.ShowLogo = args.Value is true" />
            <span>Показывать логотип</span>
        </label>
    </div>

    <div class="settings-section">
        <label class="settings-dialog__label" for="healthInterval">Интервал проверки статуса, сек.</label>
        <input id="healthInterval"
               class="form-control"
               type="number"
               min="0"
               max="3600"
               step="1"
               value="@_model.HealthCheckIntervalSeconds"
               @oninput="OnIntervalInput" />
        <p class="settings-dialog__hint">Как часто проверять доступность сервисов карточек. 0 — значение по умолчанию.</p>
    </div>

    @if (_error is not null)
    {
        <p class="text-danger" role="alert">@_error</p>
    }

    <div class="settings-dialog__actions">
        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>@(_isSaving ? "Сохранение..." : "Сохранить")
        </button>
    </div>
</form>

@code {
    private static readonly (ThemeMode Mode, string Title)[] ThemeOptions =
    [
        (ThemeMode.Auto, "Автоматически"),
        (ThemeMode.Dark, "Тёмная"),
        (ThemeMode.Light, "Светлая")
    ];

    private EditModel _model = new();
    private string? _error;
    private bool _isSaving;

    /// <summary>Текущие настройки, которые редактируются.</summary>
    [Parameter, EditorRequired]
    public SiteSettings Settings { get; set; } = null!;

    /// <summary>Событие сохранения: владелец настроек сохраняет их и уведомляет подписчиков.</summary>
    [Parameter, EditorRequired]
    public required EventCallback<SiteSettings> OnSave { get; set; }

    protected override void OnInitialized() => _model = EditModel.FromSettings(Settings);

    private void OnIntervalInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var interval))
        {
            _model.HealthCheckIntervalSeconds = Math.Clamp(interval, 0, 3600);
        }
    }

    private async Task Save()
    {
        _error = null;

        if (_model.HealthCheckIntervalSeconds < 0)
        {
            _error = "Интервал проверки статуса не может быть отрицательным.";
            return;
        }

        _isSaving = true;

        try
        {
            await OnSave.InvokeAsync(_model.ToSettings());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>Набор редактируемых полей настроек сайта.</summary>
    private sealed class EditModel
    {
        public ThemeMode ThemeMode { get; set; } = ThemeMode.Auto;

        public bool ShowLogo { get; set; } = true;

        public int HealthCheckIntervalSeconds { get; set; } = 30;

        public static EditModel FromSettings(SiteSettings settings) => new()
        {
            ThemeMode = settings.ThemeMode,
            ShowLogo = settings.ShowLogo,
            HealthCheckIntervalSeconds = settings.HealthCheckIntervalSeconds
        };

        public SiteSettings ToSettings() => new()
        {
            ThemeMode = ThemeMode,
            ShowLogo = ShowLogo,
            HealthCheckIntervalSeconds = HealthCheckIntervalSeconds
        };
    }
}
