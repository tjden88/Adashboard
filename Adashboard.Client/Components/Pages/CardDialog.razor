@using Refit
@using System.Text.Json
@using Adashboard.Client.Services
@implements IAsyncDisposable
@inject IDashboardApi DashboardApi
@inject PageTitleService PageTitleService
@inject DashboardApiOptions ApiOptions
@inject IJSRuntime JS
@inject ILogger<CardDialog> Logger

<form class="card-dialog" @onsubmit="Save" @onsubmit:preventDefault>
    <div class="card-dialog__field">
        <label for="cardTitle" class="card-dialog__label">Заголовок</label>
        <div class="card-dialog__title-row">
            <input id="cardTitle"
                   class="form-control"
                   type="text"
                   maxlength="120"
                   autocomplete="off"
                   placeholder="Например: Docker"
                   value="@_title"
                   @oninput="args => _title = args.Value?.ToString() ?? string.Empty" />
            <button type="button"
                    class="btn btn-outline-secondary card-dialog__fetch-title"
                    @onclick="FetchTitle"
                    disabled="@_isFetchingTitle"
                    title="Получить заголовок со страницы"
                    aria-label="Получить заголовок со страницы">
                <i class="fa-solid @(_isFetchingTitle ? "fa-spinner fa-spin" : "fa-wand-magic-sparkles")" aria-hidden="true"></i>
            </button>
        </div>
        @if (_titleLookupError is not null)
        {
            <p class="card-dialog__error" role="alert">@_titleLookupError</p>
        }
    </div>

    <div class="card-dialog__field">
        <label for="cardUrl" class="card-dialog__label">URL (ссылка)</label>
        <div class="card-dialog__url">
            <button type="button"
                    class="card-dialog__scheme"
                    @onclick="CycleScheme"
                    title="Схема ссылки"
                    aria-label="@($"Схема ссылки: {SchemeLabel}")">
                @SchemeLabel
            </button>
            <input id="cardUrl"
                   class="form-control card-dialog__url-input"
                   type="text"
                   maxlength="500"
                   autocomplete="off"
                   placeholder="example.com"
                   value="@_url"
                   @oninput="args => _url = args.Value?.ToString() ?? string.Empty" />
        </div>
    </div>

    <div class="card-dialog__field">
        <label class="card-dialog__label">Иконка</label>

        <div class="card-dialog__icon-modes" role="radiogroup" aria-label="Тип иконки">
            <label class="card-dialog__radio">
                <input type="radio"
                       name="cardIconMode"
                       checked="@(!_useCustomImage)"
                       @onchange="() => _useCustomImage = false" />
                <span>Встроенная иконка</span>
            </label>
            <label class="card-dialog__radio">
                <input type="radio"
                       name="cardIconMode"
                       checked="@_useCustomImage"
                       @onchange="() => _useCustomImage = true" />
                <span>Своё изображение</span>
            </label>
        </div>

        @if (_useCustomImage)
        {
            <div class="card-dialog__image">
                <div class="card-dialog__image-preview">
                    @if (_previewSource is not null)
                    {
                        <img src="@_previewSource" alt="Предпросмотр изображения" />
                    }
                    else
                    {
                        <i class="fa-regular fa-image" aria-hidden="true"></i>
                    }
                </div>

                <div class="card-dialog__image-controls">
                    <input class="form-control"
                           type="text"
                           maxlength="1000"
                           autocomplete="off"
                           placeholder="https://example.com/icon.png"
                           value="@_imageUrl"
                           @oninput="OnImageUrlInput"
                           aria-label="Ссылка на изображение" />

                    <div class="card-dialog__image-buttons">
                        <label class="btn btn-outline-secondary card-dialog__image-upload">
                            <i class="fa-solid fa-upload" aria-hidden="true"></i>Выбрать файл
                            <InputFile OnChange="OnFileSelected"
                                       accept="image/png,image/jpeg,image/gif,image/webp,image/bmp,image/avif"
                                       hidden />
                        </label>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearImage">
                            <i class="fa-solid fa-eraser" aria-hidden="true"></i>Очистить
                        </button>
                    </div>

                    <p class="card-dialog__hint">
                        Ссылка, файл или вставка из буфера обмена (Ctrl+V).
                    </p>
                </div>
            </div>

            @if (_imageError is not null)
            {
                <p class="card-dialog__error" role="alert">@_imageError</p>
            }
        }
        else
        {
            <IconPicker @bind-Value="_icon" />
        }
    </div>

    <div class="card-dialog__row">
        <div class="card-dialog__field card-dialog__field--grow">
            <label class="card-dialog__label">Цвет фона</label>
            <ColorPicker @bind-Value="_color" AriaLabel="Цвет фона карточки" />
        </div>
        <label class="card-dialog__toggle" title="Карточка займёт две колонки">
            <input type="checkbox"
                   checked="@_isWide"
                   @onchange="args => _isWide = args.Value is true" />
            <span>Широкая</span>
        </label>
    </div>

    <div class="card-dialog__field">
        <label class="card-dialog__label">Проверка статуса</label>
        <div class="card-dialog__status-options" role="radiogroup" aria-label="Режим проверки статуса">
            @foreach (var option in StatusModeOptions)
            {
                <label class="card-dialog__status-option" title="@option.Description">
                    <input type="radio"
                           name="cardStatusMode"
                           value="@option.Mode"
                           checked="@(_statusMode == option.Mode)"
                           @onchange="() => _statusMode = option.Mode" />
                    <span class="card-dialog__status-text">
                        <span class="card-dialog__status-title">@option.Title</span>
                        <span class="card-dialog__status-description">@option.Hint</span>
                    </span>
                </label>
            }
        </div>
    </div>

    @if (_error is not null)
    {
        <p class="card-dialog__error" role="alert">@_error</p>
    }

    <div class="card-dialog__actions">
        @if (Card is not null)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="Delete">
                <i class="fa-solid fa-trash" aria-hidden="true"></i>Удалить
            </button>
        }

        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>@(_isSaving ? "Сохранение..." : "Сохранить")
        </button>
    </div>
</form>

@code {
    private const string DefaultColor = "#1e40af";
    private const string DefaultIcon = "fa-solid fa-link";

    // Варианты проверки статуса, отображаемые в диалоге.
    private static readonly (CardStatusMode Mode, string Title, string Hint, string Description)[] StatusModeOptions =
    [
        (CardStatusMode.None, "Не проверять", "Индикатор скрыт.", "Индикатор на карточке не отображается."),
        (CardStatusMode.Reachable, "Сервис отвечает", "Любой ответ сервера.", "Доступен при любом ответе сервера, включая форму входа."),
        (CardStatusMode.NoServerError, "Без серверных ошибок", "Кроме ошибок 5xx.", "Доступен, пока сервер не вернул ошибку 5xx."),
        (CardStatusMode.Success, "Успешный ответ (2xx)", "Только ответ 2xx.", "Доступен только при успешном ответе 200–299."),
    ];

    private string _title = string.Empty;
    private string _url = string.Empty;
    private UrlScheme _scheme = UrlScheme.Https;
    private string _color = DefaultColor;
    private string _icon = string.Empty;
    private CardStatusMode _statusMode = CardStatusMode.None;
    private bool _isWide;
    private int _categoryId;
    private string? _error;

    private bool _useCustomImage;
    private string _imageUrl = string.Empty;
    private byte[]? _uploadedBytes;
    private string? _uploadedPreview;
    private string? _existingImagePath;
    private string? _imageError;
    private bool _isSaving;

    private const int MaxImageBytes = 2 * 1024 * 1024;

    // Идентификатор, назначенный сервером при создании карточки. Нужен, если создание
    // уже прошло, но следующий шаг (загрузка иконки) не удался: при повторе карточку
    // обновляем, а не создаём заново.
    private int? _createdCardId;

    private bool _isFetchingTitle;
    private string? _titleLookupError;
    private readonly CancellationTokenSource _titleLookupCts = new();

    private IJSObjectReference? _module;
    private DotNetObjectReference<CardDialog>? _selfRef;
    private bool _clipboardInitialized;

    private string SchemeLabel => _scheme switch
    {
        UrlScheme.Http => "http://",
        UrlScheme.Https => "https://",
        _ => "○"
    };

    /// <summary>Источник для предпросмотра: загруженный файл, ссылка или уже сохранённое изображение.</summary>
    private string? _previewSource =>
        _uploadedPreview
        ?? (!string.IsNullOrWhiteSpace(_imageUrl) ? _imageUrl.Trim() : null)
        ?? ApiOptions.ResolveUploadPath(_existingImagePath);

    /// <summary>Карточка для редактирования или <c>null</c> при создании.</summary>
    [Parameter]
    public DashboardCard? Card { get; set; }

    /// <summary>Идентификатор категории, в которую добавляется новая карточка.</summary>
    [Parameter]
    public int CategoryId { get; set; }

    /// <summary>Позиция новой карточки в категории (используется только при создании).</summary>
    [Parameter]
    public int Position { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback<DashboardCard> OnSave { get; set; }

    [Parameter]
    public EventCallback<DashboardCard> OnDelete { get; set; }

    protected override void OnInitialized()
    {
        if (Card is null)
        {
            _categoryId = CategoryId;
            return;
        }

        _categoryId = Card.DashboardCategoryId;
        _title = Card.Title;
        _color = Card.BackgroundColor;
        _statusMode = Card.StatusMode;
        _isWide = Card.IsWide;

        // Изображение-иконка: либо пользовательский файл, либо класс Font Awesome.
        _useCustomImage = Card.IsCustomIcon;
        if (_useCustomImage)
        {
            _existingImagePath = string.IsNullOrWhiteSpace(Card.IconSource) ? null : Card.IconSource;
        }
        else
        {
            _icon = Card.IconSource;
        }

        // Схема хранится отдельно от адреса; для старых данных допускаем схему внутри адреса.
        var (embeddedScheme, url) = SplitScheme(Card.Url);
        _scheme = embeddedScheme != UrlScheme.None ? embeddedScheme : Card.UrlScheme;
        _url = url;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _clipboardInitialized)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/icon-image.js");
            _selfRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initializeClipboard", _selfRef);
            _clipboardInitialized = true;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void CycleScheme()
    {
        _scheme = _scheme switch
        {
            UrlScheme.Http => UrlScheme.Https,
            UrlScheme.Https => UrlScheme.None,
            _ => UrlScheme.Http
        };
    }

    /// <summary>Пытается заполнить название, взяв заголовок страницы по адресу карточки.</summary>
    private async Task FetchTitle()
    {
        _titleLookupError = null;

        var (scheme, url) = NormalizeUrl(_scheme, _url);
        if (url.Length == 0)
        {
            _titleLookupError = "Введите ссылку.";
            return;
        }

        if (!IsSafeUrl(scheme, url))
        {
            _titleLookupError = "Недопустимая схема ссылки.";
            return;
        }

        _isFetchingTitle = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var title = await PageTitleService.TryGetTitleAsync(UrlSchemePrefix(scheme) + url, _titleLookupCts.Token);
            if (string.IsNullOrWhiteSpace(title))
            {
                _titleLookupError = "Не удалось найти заголовок на странице.";
            }
            else
            {
                _title = title;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (InvalidOperationException ex)
        {
            _titleLookupError = ex.Message;
        }
        catch (Exception)
        {
            _titleLookupError = "Не удалось получить заголовок страницы.";
        }
        finally
        {
            _isFetchingTitle = false;
        }
    }

    private void OnImageUrlInput(ChangeEventArgs args)
    {
        _imageUrl = args.Value?.ToString() ?? string.Empty;

        // Ссылка имеет приоритет над ранее выбранным файлом: иначе предпросмотр не обновится.
        if (_imageUrl.Length > 0)
        {
            _uploadedBytes = null;
            _uploadedPreview = null;
        }

        _imageError = null;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        _imageError = null;
        var file = args.File;

        if (file.Size > MaxImageBytes)
        {
            _imageError = "Файл превышает максимальный размер 2 МБ.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxImageBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            _uploadedBytes = buffer.ToArray();
            _uploadedPreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(_uploadedBytes)}";
            _imageUrl = string.Empty;
        }
        catch (Exception)
        {
            _imageError = "Не удалось прочитать выбранный файл.";
        }
    }

    /// <summary>Принимает изображение, вставленное из буфера обмена, в виде data URL.</summary>
    [JSInvokable]
    public void OnClipboardImage(string? dataUrl)
    {
        if (string.IsNullOrWhiteSpace(dataUrl))
        {
            return;
        }

        var commaIndex = dataUrl.IndexOf(',');
        if (commaIndex < 0)
        {
            return;
        }

        try
        {
            var bytes = Convert.FromBase64String(dataUrl[(commaIndex + 1)..]);
            if (bytes.Length == 0 || bytes.LongLength > MaxImageBytes)
            {
                _imageError = "Изображение превышает максимальный размер 2 МБ.";
            }
            else
            {
                _uploadedBytes = bytes;
                _uploadedPreview = dataUrl;
                _imageUrl = string.Empty;
                _useCustomImage = true;
                _imageError = null;
            }
        }
        catch (FormatException)
        {
            _imageError = "Не удалось прочитать изображение из буфера обмена.";
        }

        InvokeAsync(StateHasChanged);
    }

    private void ClearImage()
    {
        _imageUrl = string.Empty;
        _uploadedBytes = null;
        _uploadedPreview = null;
        _existingImagePath = null;
        _imageError = null;

        // «Очистить» возвращает карточку к встроенной иконке.
        _useCustomImage = false;
    }

    private async Task Save()
    {
        _error = null;
        _imageError = null;

        var title = _title.Trim();
        var color = _color.Trim();
        var icon = _icon.Trim();
        var (scheme, url) = NormalizeUrl(_scheme, _url);

        if (url.Length == 0)
        {
            _error = "Введите ссылку.";
            return;
        }

        if (!IsSafeUrl(scheme, url))
        {
            _error = "Недопустимая схема ссылки.";
            return;
        }

        if (color.Length == 0)
        {
            color = DefaultColor;
        }

        if (!IsValidHexColor(color))
        {
            _error = "Цвет фона должен быть в формате #RRGGBB.";
            return;
        }

        if (icon.Length == 0)
        {
            icon = DefaultIcon;
        }

        // Пользовательская иконка без файла, ссылки и ранее сохранённого пути не имеет смысла.
        if (_useCustomImage
            && _uploadedBytes is null
            && string.IsNullOrWhiteSpace(_imageUrl)
            && string.IsNullOrWhiteSpace(_existingImagePath))
        {
            _imageError = "Укажите ссылку или выберите изображение.";
            return;
        }

        _isSaving = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var card = Card ?? new DashboardCard
            {
                DashboardCategoryId = _categoryId,
                Position = Position
            };

            // Повторное сохранение после частичного сбоя: карточка уже создана, работаем с её Id.
            if (Card is null && _createdCardId is > 0)
            {
                card.Id = _createdCardId.Value;
            }

            card.Title = title;
            card.Url = url;
            card.UrlScheme = scheme;
            card.BackgroundColor = color;
            card.StatusMode = _statusMode;
            card.IsWide = _isWide;

            if (_useCustomImage)
            {
                card.IsCustomIcon = true;
                card.IconSource = _existingImagePath ?? string.Empty;
            }
            else
            {
                card.IsCustomIcon = false;
                card.IconSource = icon;
            }

            // Новую карточку сначала создаём: только после этого сервер назначит Id,
            // а он нужен для загрузки файла изображения-иконки.
            var isNew = card.Id <= 0;
            if (isNew)
            {
                card = await DashboardApi.CreateCardAsync(card);
                _createdCardId = card.Id;
            }

            if (_useCustomImage && (_uploadedBytes is not null || !string.IsNullOrWhiteSpace(_imageUrl)))
            {
                // Загружаем новое изображение и запоминаем путь, который вернул API.
                card.IconSource = await UploadIconAsync(card.Id);
                card.IsCustomIcon = true;
            }
            else if (!_useCustomImage && !isNew)
            {
                card.IsCustomIcon = false;
            }

            // При создании без пользовательской иконки запись сохранять повторно не нужно.
            if (!isNew || _useCustomImage)
            {
                await DashboardApi.UpdateCardAsync(card);
            }

            _createdCardId = null;
            await OnSave.InvokeAsync(card);
        }
        catch (InvalidOperationException ex)
        {
            await RollbackCreatedCardAsync();
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            // Если карточку успели создать, а следующий шаг не удался — откатываем её,
            // чтобы не осталась «фантомная» запись, невидимая в интерфейсе.
            await RollbackCreatedCardAsync();

            if (ex is ApiException apiEx)
            {
                Logger.LogWarning(apiEx, "Сохранение карточки завершилось ошибкой API. Код: {StatusCode}.", apiEx.StatusCode);
                _error = $"Не удалось сохранить карточку (код {(int)apiEx.StatusCode}).";
            }
            else
            {
                _error = "Не удалось сохранить карточку.";
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Удаляет карточку, созданную в рамках текущей неудачной попытки сохранения.
    /// </summary>
    /// <remarks>
    /// Откат нужен, потому что карточку создаём до загрузки иконки, а сам файл — уже после
    /// появления идентификатора. Если загрузка не удалась, запись без картинки оставлять нельзя.
    /// </remarks>
    private async Task RollbackCreatedCardAsync()
    {
        if (_createdCardId is not int createdId)
        {
            return;
        }

        _createdCardId = null;

        try
        {
            await TryDeleteCardImageAsync(createdId);
            await DashboardApi.DeleteCardAsync(createdId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось откатить создание карточки {CardId}.", createdId);
        }
    }

    /// <summary>
    /// Загружает изображение-иконку для уже сохранённой карточки и возвращает путь к нему.
    /// </summary>
    /// <remarks>
    /// Файл отправляется как бинарные данные, ссылка — как JSON-тело. Поток выбранного файла
    /// должен жить до конца запроса, поэтому создаётся здесь и не закрывается раньше времени.
    /// </remarks>
    private async Task<string> UploadIconAsync(int cardId)
    {
        if (_uploadedBytes is not null)
        {
            var response = await DashboardApi.UploadImageAsync(cardId, _uploadedBytes);
            return await ReadImagePathAsync(response);
        }

        var urlResponse = await DashboardApi.UploadImageFromUrlAsync(
            cardId, _imageUrl.Trim());
        return await ReadImagePathAsync(urlResponse);
    }

    private async Task Delete()
    {
        if (Card is not null)
        {
            await OnDelete.InvokeAsync(Card);
        }
    }

    /// <summary>
    /// Читает путь к сохранённому изображению из ответа API.
    /// </summary>
    /// <remarks>
    /// Разбор сделан вручную, без отдельной модели: успешный ответ — <c>{ "imagePath": "..." }</c>,
    /// неуспешный — <c>{ "error": "..." }</c>. При ошибке выбрасываем понятное исключение,
    /// которое перехватывает <see cref="Save"/>.
    /// </remarks>
    private static async Task<string> ReadImagePathAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();

        if (!response.IsSuccessStatusCode)
        {
            throw new InvalidOperationException(ExtractString(body, "error") ?? "Не удалось сохранить изображение.");
        }

        var imagePath = ExtractString(body, "imagePath");
        if (string.IsNullOrWhiteSpace(imagePath))
        {
            throw new InvalidOperationException("API не вернуло путь к изображению.");
        }

        return imagePath;
    }

    /// <summary>
    /// Извлекает строковое свойство из JSON-ответа API, не полагаясь на строгую модель.
    /// </summary>
    private static string? ExtractString(string body, string property)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(body);
            if (document.RootElement.ValueKind == JsonValueKind.Object
                && document.RootElement.TryGetProperty(property, out var value)
                && value.ValueKind == JsonValueKind.String)
            {
                return value.GetString();
            }
        }
        catch (JsonException)
        {
            // Формат ответа неожиданный: считаем свойство отсутствующим.
        }

        return null;
    }


    /// <summary>
    /// Выделяет схему из адреса, если она там уже указана.
    /// </summary>
    private static (UrlScheme Scheme, string Url) SplitScheme(string url)
    {
        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
        {
            return (UrlScheme.Http, url[7..]);
        }

        if (url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return (UrlScheme.Https, url[8..]);
        }

        return (UrlScheme.None, url);
    }

    /// <summary>
    /// Нормализует адрес: схема в самом адресе имеет приоритет над переключателем.
    /// </summary>
    private static (UrlScheme Scheme, string Url) NormalizeUrl(UrlScheme scheme, string rawUrl)
    {
        var trimmed = rawUrl.Trim();
        var split = SplitScheme(trimmed);

        return split.Scheme != UrlScheme.None ? split : (scheme, trimmed);
    }

    /// <summary>
    /// Запрещает опасные схемы, если адрес задаётся без префикса.
    /// </summary>
    private static bool IsSafeUrl(UrlScheme scheme, string url)
    {
        if (scheme != UrlScheme.None)
        {
            return true;
        }

        var normalized = url.TrimStart().ToLowerInvariant();

        return !normalized.StartsWith("javascript:", StringComparison.Ordinal)
               && !normalized.StartsWith("data:", StringComparison.Ordinal)
               && !normalized.StartsWith("vbscript:", StringComparison.Ordinal)
               && !normalized.StartsWith("file:", StringComparison.Ordinal)
               && !normalized.StartsWith("blob:", StringComparison.Ordinal);
    }

    /// <summary>
    /// Возвращает префикс адреса для выбранной схемы ссылки.
    /// </summary>
    private static string UrlSchemePrefix(UrlScheme scheme) => scheme switch
    {
        UrlScheme.Http => "http://",
        UrlScheme.Https => "https://",
        _ => string.Empty
    };

    private static bool IsValidHexColor(string color)
    {
        if (color.Length != 7 || color[0] != '#')
        {
            return false;
        }

        for (var i = 1; i < color.Length; i++)
        {
            if (!Uri.IsHexDigit(color[i]))
            {
                return false;
            }
        }

        return true;
    }

    public async ValueTask DisposeAsync()
    {
        _titleLookupCts.Cancel();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeClipboard");
                await _module.DisposeAsync();
            }
            catch
            {
            }
        }

        _selfRef?.Dispose();
    }
}
