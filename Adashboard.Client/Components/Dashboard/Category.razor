@using Adashboard.Client.Components.Pages
@using Adashboard.Client.Services
@using Refit
@inject IDashboardApi DashboardApi
@inject DialogService DialogService
@inject ILogger<Category> Logger

@*
    Одна категория dashboard вместе со своими ссылками.

    Компонент сам управляет категорией и её карточками: открывает диалоги создания и изменения
    карточек, создаёт, изменяет и удаляет карточки, а также изменяет и удаляет саму категорию.
    О результатах родителю (LayoutView) сообщают события Saved/Deleted и CardSaved/CardDeleted,
    чтобы общие списки оставались актуальными.
*@

<section class="dashboard-category"
         data-category-id="@Model.Id"
         style="--span-desktop:@DesktopWidth; --span-medium:@MediumWidth; --span-mobile:@MobileWidth; --cards-desktop:@DesktopWidth; --cards-medium:@MediumWidth; --cards-mobile:@MobileWidth;">
    @* Визуальная часть панели (рамка, фон, отступы) вынесена во вложенный блок: маркер
       изменения ширины лежит снаружи и не обрезается её overflow. *@
    <div class="category-frame">
        <header class="category-header">
            <div class="category-title-wrap">
                <span class="drag-handle" title="Перетащить категорию" aria-hidden="true">
                    <i class="fa-solid fa-grip-vertical"></i>
                </span>
                <h2>@Model.Title</h2>
            </div>
            <div class="category-actions">
                <button type="button"
                        class="btn btn-icon btn-sm btn-success"
                        @onclick="OpenAddCardDialog"
                        aria-label="Добавить ссылку в категорию @Model.Title"
                        title="Добавить ссылку">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                </button>
                <button type="button"
                        class="btn btn-icon btn-sm btn-primary"
                        @onclick="OpenEditDialog"
                        aria-label="Редактировать категорию @Model.Title"
                        title="Редактировать категорию">
                    <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
                </button>
                <button type="button"
                        class="btn btn-icon btn-sm btn-danger"
                        @onclick="RequestDeleteAsync"
                        aria-label="Удалить категорию @Model.Title"
                        title="Удалить категорию">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
            </div>
        </header>

        <div class="category-cards" data-category-id="@Model.Id">
            @foreach (var card in Cards.OrderBy(x => x.Position))
            {
                <Card @key="card.Id" Model="@card"
                      DesktopColumns="@DesktopWidth"
                      MediumColumns="@MediumWidth"
                      MobileColumns="@MobileWidth"
                      EditRequested="OpenEditCardDialog" />
            }
        </div>
    </div>

    @* Маркер изменения ширины категории: тянем мышью вправо/влево. Виден только в режиме
       редактирования (управляется CSS по классу html.dashboard-edit-mode). *@
    <span class="category-resize-handle" title="Изменить ширину категории" aria-hidden="true">
        <i class="fa-solid fa-ellipsis-vertical"></i>
    </span>
</section>

@code {
    [Parameter, EditorRequired]
    public DashboardCategory Model { get; set; } = null!;

    /// <summary>
    /// Карточки категории. Read-модель API отдаёт их плоским списком, поэтому карточки
    /// передаются отдельным параметром, а не живут внутри модели категории.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<DashboardCard> Cards { get; set; } = [];

    /// <summary>Уведомление родителя о созданной или изменённой категории.</summary>
    [Parameter, EditorRequired]
    public EventCallback<DashboardCategory> Saved { get; set; }

    /// <summary>Уведомление родителя об удалённой категории.</summary>
    [Parameter, EditorRequired]
    public EventCallback<DashboardCategory> Deleted { get; set; }

    /// <summary>Уведомление родителя о созданной или изменённой карточке.</summary>
    [Parameter, EditorRequired]
    public EventCallback<DashboardCard> CardSaved { get; set; }

    /// <summary>Уведомление родителя об удалённой карточке.</summary>
    [Parameter, EditorRequired]
    public EventCallback<DashboardCard> CardDeleted { get; set; }

    // Ширину категории ограничиваем допустимым диапазоном сетки (1..12), даже если в данных
    // оказалось некорректное значение: иначе получилась бы нулевая ширина.
    private int DesktopWidth => Math.Clamp(Model.Width, 1, 12);

    private int MediumWidth => GetMediumSpan(DesktopWidth);

    private int MobileWidth => Math.Min(DesktopWidth, 4);

    private static int GetMediumSpan(int desktopWidth)
    {
        return Math.Clamp((int)Math.Round(desktopWidth / 2d, MidpointRounding.AwayFromZero), 1, 6);
    }

    // ---------------------------------------------------------------
    // Сама категория: изменение и удаление.
    // Запросы к API выполняют диалог изменения (CategoryDialog) и удаление здесь.
    // ---------------------------------------------------------------

    private void OpenEditDialog()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(CategoryDialog.Category)] = Model,
            [nameof(CategoryDialog.OnSave)] = EventCallback.Factory.Create<DashboardCategory>(this, OnCategorySavedAsync)
        };

        DialogService.Show<CategoryDialog>($"Редактировать категорию: {Model.Title}", parameters, closeOnOverlayClick: false);
    }

    private async Task OnCategorySavedAsync(DashboardCategory category)
    {
        // Передаём категорию родителю: он обновит общий список и перерисует сетку.
        await Saved.InvokeAsync(category);
        DialogService.Close();
    }

    private async Task RequestDeleteAsync()
    {
        // Пустую категорию удаляем сразу: подтверждать нечего.
        if (Cards.Count == 0)
        {
            await DeleteCategoryAsync();
            return;
        }

        var parameters = new Dictionary<string, object?>
        {
            [nameof(ConfirmDialog.Message)] = $"Удалить категорию «{Model.Title}» вместе со всеми ссылками?",
            [nameof(ConfirmDialog.ConfirmLabel)] = "Удалить",
            [nameof(ConfirmDialog.OnConfirm)] = EventCallback.Factory.Create(this, DeleteCategoryAsync)
        };

        DialogService.Show<ConfirmDialog>("Подтверждение удаления", parameters, closeOnOverlayClick: true);
    }

    private async Task DeleteCategoryAsync()
    {
        try
        {
            await DashboardApi.DeleteCategoryAsync(Model.Id);
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Не удалось удалить категорию {CategoryId}. Код: {StatusCode}.", Model.Id, ex.StatusCode);
            return;
        }

        await Deleted.InvokeAsync(Model);
    }

    // ---------------------------------------------------------------
    // Карточки: создание, изменение и удаление.
    // Сохранение карточки (включая изображение-иконку) выполняет сам диалог:
    // он знает, какую иконку выбрал пользователь. Здесь мы лишь обновляем список у родителя.
    // ---------------------------------------------------------------

    private void OpenAddCardDialog()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(CardDialog.CategoryId)] = Model.Id,
            [nameof(CardDialog.Position)] = NextCardPosition(),
            [nameof(CardDialog.OnSave)] = EventCallback.Factory.Create<DashboardCard>(this, OnCardSavedAsync)
        };

        DialogService.Show<CardDialog>("Добавить карточку", parameters, closeOnOverlayClick: false);
    }

    private void OpenEditCardDialog(DashboardCard card)
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(CardDialog.Card)] = card,
            [nameof(CardDialog.OnSave)] = EventCallback.Factory.Create<DashboardCard>(this, OnCardSavedAsync),
            [nameof(CardDialog.OnDelete)] = EventCallback.Factory.Create<DashboardCard>(this, OpenDeleteCardConfirm)
        };

        DialogService.Show<CardDialog>($"Редактировать карточку: {card.Title}", parameters, closeOnOverlayClick: false);
    }

    private async Task OnCardSavedAsync(DashboardCard card)
    {
        // Передаём карточку родителю: он обновит общий список и перерисует сетку.
        await CardSaved.InvokeAsync(card);
        DialogService.Close();
    }

    private void OpenDeleteCardConfirm(DashboardCard card)
    {
        var displayName = string.IsNullOrWhiteSpace(card.Title) ? card.Url : card.Title;

        var parameters = new Dictionary<string, object?>
        {
            [nameof(ConfirmDialog.Message)] = $"Удалить ссылку «{displayName}»?",
            [nameof(ConfirmDialog.ConfirmLabel)] = "Удалить",
            [nameof(ConfirmDialog.OnConfirm)] = EventCallback.Factory.Create(this, () => DeleteCard(card))
        };

        DialogService.Show<ConfirmDialog>("Подтверждение удаления", parameters, closeOnOverlayClick: true);
    }

    private async Task DeleteCard(DashboardCard card)
    {
        try
        {
            await DashboardApi.DeleteCardAsync(card.Id);
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Не удалось удалить карточку {CardId}. Код: {StatusCode}.", card.Id, ex.StatusCode);
            return;
        }

        await CardDeleted.InvokeAsync(card);
    }

    private int NextCardPosition()
    {
        var positions = Cards.Select(x => x.Position).ToList();
        return positions.Count > 0 ? positions.Max() + 1 : 0;
    }
}
