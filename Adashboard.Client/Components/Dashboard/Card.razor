@using Adashboard.Client.Services
@using Adashboard.Domain.Extensions
@implements IAsyncDisposable
@inject EditModeService EditModeService
@inject DashboardApiOptions ApiOptions
@inject HealthCheckService HealthCheckService
@inject SiteSettingsService SettingsService
@inject ILogger<Card> Logger

@*
    Одна карточка-ссылка dashboard.

    Карточка сама следит за своим статусом: пока она есть на странице, компонент периодически
    просит API проверить сервис, на который ведёт ссылка, и показывает индикатор. Так проверка
    не зависит от родителя и «умирает» вместе с карточкой при её удалении.

    Отображение ссылки (схема, иконка, цвета) и переход по ней тоже описаны здесь.
*@

<a class="dashboard-card"
   data-card-id="@Model.Id"
   href="@Href"
   target="_blank"
   rel="noopener noreferrer"
   @onclick="OnCardClick"
   @onclick:preventDefault="@EditModeService.IsEnabled"
   style="--card-bg:@Model.BackgroundColor; --card-icon-color:@Model.GetIconColor(); --card-text-color:@Model.GetTextColor(); --card-span-desktop:@CardSpanDesktop; --card-span-medium:@CardSpanMedium; --card-span-mobile:@CardSpanMobile;">
    <span class="card-title">@Model.Title</span>
    <div class="card-icon" aria-hidden="true">
        @if (Model.IsCustomIcon && !string.IsNullOrWhiteSpace(Model.IconSource))
        {
            <img class="card-icon__image"
                 src="@ApiOptions.ResolveUploadPath(Model.IconSource)"
                 alt=""
                 loading="lazy"
                 onload="this.hidden = false"
                 onerror="this.hidden = true" />
            <i class="fa-solid fa-link"></i>
        }
        else
        {
            <i class="@IconClass"></i>
        }
    </div>
    @if (Model.StatusMode != CardStatusMode.None)
    {
        <span class="status-dot @StatusClass" role="img" aria-label="@StatusLabel" title="@StatusTitle"></span>
    }
    @* Полупрозрачная иконка редактирования. Элемент присутствует всегда, а видимостью
       управляет CSS: показывается только в режиме редактирования и только при наведении
       (или фокусе с клавиатуры) на карточку. Так карточку не нужно перерисовывать при
       переключении режима, и оверлей не перехватывает клики (pointer-events: none). *@
    <span class="card-edit-overlay" aria-hidden="true">
        <i class="fa-solid fa-pen-nib"></i>
    </span>
</a>

@code {

    /// <summary>
    /// Как часто повторять проверку статуса. Интервал берётся из настроек сайта, поэтому его
    /// изменение вступает в силу без перезагрузки страницы.
    /// </summary>
    private int HealthCheckIntervalSeconds => SettingsService.Current.HealthCheckIntervalSeconds;

    /// <summary>
    /// Результат последней проверки доступности: состояние и пояснение от API.
    /// </summary>
    private ServiceHealthResult _health = ServiceHealthResult.Unknown;

    private readonly CancellationTokenSource _healthCts = new();

    // «Будильник» цикла проверок: после редактирования карточки проверяем её, не дожидаясь
    // конца текущего интервала. Пока счётчик равен нулю, цикл просто спит до тайм-аута.
    private readonly SemaphoreSlim _wake = new(0);

    private Task? _healthLoop;

    // «Отпечаток» данных карточки, влияющих на проверку. Если он изменился (например, после
    // редактирования), статус проверяем сразу, не дожидаясь очередного интервала.
    private string? _modelSignature;

    [Parameter, EditorRequired]
    public DashboardCard Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public int DesktopColumns { get; set; }

    [Parameter, EditorRequired]
    public int MediumColumns { get; set; }

    [Parameter, EditorRequired]
    public int MobileColumns { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<DashboardCard> EditRequested { get; set; }

    // Куда ведёт карточка: схема из модели прибавляется к адресу.
    private string Href => Model.UrlScheme.ToSchemeText() + Model.Url;

    // Если пользовательское изображение не задано, показываем встроенную иконку Font Awesome.
    private string IconClass => string.IsNullOrWhiteSpace(Model.IconSource)
        ? "fa-solid fa-link"
        : Model.IconSource;


    private string StatusClass => _health.State switch
    {
        ServiceHealthState.Online => "online",
        ServiceHealthState.Offline => "offline",
        _ => "unknown"
    };

    private string StatusLabel => _health.State switch
    {
        ServiceHealthState.Online => "Сервис доступен",
        ServiceHealthState.Offline => "Сервис недоступен",
        _ => "Статус проверяется"
    };

    // В подсказке показываем пояснение API, а при его отсутствии — обычную подпись состояния.
    private string StatusTitle => string.IsNullOrWhiteSpace(_health.Message) ? StatusLabel : _health.Message;

    private int CardSpanDesktop => GetCardSpan(Model.IsWide, DesktopColumns);

    private int CardSpanMedium => GetCardSpan(Model.IsWide, MediumColumns);

    private int CardSpanMobile => GetCardSpan(Model.IsWide, MobileColumns);

    // В режиме редактирования переход по ссылке отключён: клик открывает окно редактирования.
    private Task OnCardClick()
        => EditModeService.IsEnabled ? EditRequested.InvokeAsync(Model) : Task.CompletedTask;

    private static int GetCardSpan(bool isWide, int categoryColumns)
    {
        var safeColumns = Math.Max(1, categoryColumns);

        // Широкая карточка всегда занимает две колонки, но не больше доступного числа колонок категории.
        return isWide ? Math.Min(2, safeColumns) : 1;
    }

    protected override void OnParametersSet()
    {
        var signature = $"{Model.StatusMode}|{Model.UrlScheme}|{Model.Url}";
        if (signature == _modelSignature)
        {
            return;
        }

        var isFirst = _modelSignature is null;
        _modelSignature = signature;

        // При первой установке параметров цикл ещё не запущен (он стартует после первого
        // рендера), поэтому будим его только при изменениях: данные карточки поменялись —
        // статус сбрасываем и проверяем сразу, не дожидаясь очередного интервала.
        if (!isFirst)
        {
            _health = ServiceHealthResult.Unknown;

            if (_wake.CurrentCount == 0)
            {
                _wake.Release();
            }
        }
    }

    protected override void OnInitialized()
    {
        // Следим за настройками: при изменении интервала проверки будим цикл, чтобы он
        // перечитал значение и продолжил работать с новой частотой.
        SettingsService.OnChange += OnSettingsChanged;
    }

    private void OnSettingsChanged()
    {
        if (_wake.CurrentCount == 0)
        {
            _wake.Release();
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _healthLoop = RunHealthLoopAsync(_healthCts.Token);
        }

        return Task.CompletedTask;
    }

    // Периодическая проверка: сразу после появления карточки и далее с заданным интервалом.
    // Цикл один на карточку, поэтому одновременных проверок не бывает.
    private async Task RunHealthLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await CheckHealthAsync(cancellationToken);

                // Спим до следующего интервала или до «будильника» после редактирования.
                await _wake.WaitAsync(TimeSpan.FromSeconds(HealthCheckIntervalSeconds), cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Штатное завершение цикла: карточка удалена или страница ушла.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Цикл проверки статуса карточки {CardId} остановлен из-за ошибки.", Model.Id);
        }
    }

    private async Task CheckHealthAsync(CancellationToken cancellationToken)
    {
        // Карточка без индикатора не проверяется.
        if (Model.StatusMode == CardStatusMode.None)
        {
            return;
        }

        try
        {
            var result = await HealthCheckService.CheckAsync(Model.Id, cancellationToken);
            if (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            // Карточку удалили на сервере (например, в другой вкладке): прекращаем проверки,
            // чтобы не слать запросы по несуществующей карточке. Цикл завершится сам при следующем
            // ожидании, так как токен уже отменён.
            if (result.CardGone)
            {
                Logger.LogDebug("Проверки статуса карточки {CardId} остановлены: карточка удалена на сервере.", Model.Id);
                await _healthCts.CancelAsync();
                return;
            }

            _health = result;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось обновить статус карточки {CardId}.", Model.Id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        SettingsService.OnChange -= OnSettingsChanged;
        await _healthCts.CancelAsync();

        if (_healthLoop is not null)
        {
            try
            {
                await _healthLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _healthCts.Dispose();
        _wake.Dispose();
    }
}
