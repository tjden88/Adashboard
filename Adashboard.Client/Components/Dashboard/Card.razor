@using Adashboard.Client.Services
@using Adashboard.Domain.Models
@inject EditModeService EditModeService
@inject DashboardApiOptions ApiOptions

<a class="dashboard-card"
   data-card-id="@Model.Id"
   href="@Href"
   target="_blank"
   rel="noopener noreferrer"
   @onclick="OnCardClick"
   @onclick:preventDefault="@EditModeService.IsEnabled"
   style="--card-bg:@Model.BackgroundColor; --card-icon-color:@Model.GetIconColor(); --card-text-color:@Model.GetTextColor(); --card-span-desktop:@CardSpanDesktop; --card-span-medium:@CardSpanMedium; --card-span-mobile:@CardSpanMobile;">
    <span class="card-title">@Model.Title</span>
    <div class="card-icon" aria-hidden="true">
        @if (Model.CardImage.IsCustom && !string.IsNullOrWhiteSpace(Model.CardImage.IconSource))
        {
            @* Своё изображение приоритетнее встроенной иконки. Иконка-заглушка остаётся
               запасным вариантом: CSS прячет её, пока картинка показана, а при ошибке
               загрузки onerror скрывает изображение и открывает иконку. *@
            <img class="card-icon__image"
                 src="@ApiOptions.ResolveUploadPath(Model.CardImage.IconSource)"
                 alt=""
                 loading="lazy"
                 onload="this.hidden = false"
                 onerror="this.hidden = true" />
            <i class="fa-solid fa-link"></i>
        }
        else
        {
            <i class="@IconClass"></i>
        }
    </div>
    @if (Model.StatusMode != CardStatusMode.None)
    {
        <span class="status-dot @StatusClass" role="img" aria-label="@StatusLabel" title="@StatusTitle"></span>
    }
</a>

@code {
    [Parameter, EditorRequired]
    public DashboardCard Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public int DesktopColumns { get; set; }

    [Parameter, EditorRequired]
    public int MediumColumns { get; set; }

    [Parameter, EditorRequired]
    public int MobileColumns { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<DashboardCard> EditRequested { get; set; }

    /// <summary>
    /// Результат последней проверки доступности: состояние и пояснение от API.
    /// </summary>
    [Parameter]
    public ServiceHealthResult Health { get; set; } = ServiceHealthResult.Unknown;

    // Куда ведёт карточка: схема из модели прибавляется к адресу.
    private string Href => UrlSchemePrefix(Model.UrlScheme) + Model.Url;

    // Если пользовательское изображение не задано, показываем встроенную иконку Font Awesome.
    private string IconClass => string.IsNullOrWhiteSpace(Model.CardImage.IconSource)
        ? "fa-solid fa-link"
        : Model.CardImage.IconSource;

    private static string UrlSchemePrefix(UrlScheme scheme) => scheme switch
    {
        UrlScheme.Http => "http://",
        UrlScheme.Https => "https://",
        _ => string.Empty
    };

    private string StatusClass => Health.State switch
    {
        ServiceHealthState.Online => "online",
        ServiceHealthState.Offline => "offline",
        _ => "unknown"
    };

    private string StatusLabel => Health.State switch
    {
        ServiceHealthState.Online => "Сервис доступен",
        ServiceHealthState.Offline => "Сервис недоступен",
        _ => "Статус проверяется"
    };

    // В подсказке показываем пояснение API, а при его отсутствии — обычную подпись состояния.
    private string StatusTitle => string.IsNullOrWhiteSpace(Health.Message) ? StatusLabel : Health.Message;

    private int CardSpanDesktop => GetCardSpan(Model.IsWide, DesktopColumns);

    private int CardSpanMedium => GetCardSpan(Model.IsWide, MediumColumns);

    private int CardSpanMobile => GetCardSpan(Model.IsWide, MobileColumns);

    // В режиме редактирования переход по ссылке отключён: клик открывает окно редактирования.
    private Task OnCardClick()
        => EditModeService.IsEnabled ? EditRequested.InvokeAsync(Model) : Task.CompletedTask;

    private static int GetCardSpan(bool isWide, int categoryColumns)
    {
        var safeColumns = Math.Max(1, categoryColumns);

        // Широкая карточка всегда занимает две колонки, но не больше доступного числа колонок категории.
        return isWide ? Math.Min(2, safeColumns) : 1;
    }
}
