@using Adashboard.Client.Components.Pages
@using Adashboard.Client.Services
@using Microsoft.JSInterop
@using Refit
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IDashboardApi DashboardApi
@inject DialogService DialogService
@inject EditModeService EditModeService
@inject ILogger<DashboardView> Logger

@*
    Раскладка dashboard: загрузка данных, шапка, сетка категорий, настройки и операции
    с категориями (создание, изменение, удаление, перетаскивание и изменение ширины).

    Компонент переиспользует существующие Category (одна категория) и Card (одна карточка):
    операции с карточками и проверка статуса живут внутри них, а сюда приходит только
    уведомление об изменениях (CardSaved/CardDeleted), чтобы поддерживать общий список в актуальном виде.
*@

<PageTitle>@PageTitleText</PageTitle>

@if (!_isLoaded)
{
    if (_loadError is null)
    {
        <div class="dashboard-loading" role="status" aria-live="polite" aria-label="Загрузка dashboard">
            <span class="dashboard-loading__spinner" aria-hidden="true"></span>
        </div>
    }
    else
    {
        @* Понятное состояние ошибки с возможностью повторить загрузку. *@
        <div class="dashboard-loading" role="alert">
            <p class="text-danger">@_loadError</p>
            <button type="button" class="btn btn-primary" @onclick="RetryLoadAsync">
                <i class="fa-solid fa-rotate-right" aria-hidden="true"></i> Повторить
            </button>
        </div>
    }
}
else
{
    <section class="dashboard-shell">
        <header class="dashboard-header">
            <div class="dashboard-header-brand">
                @if (ShowLogo)
                {
                    <img class="dashboard-logo" src="/uploads/assets/logo.png" alt="" />
                }
                <div>
                    <h1>@_layout.Title</h1>
                    <p>@_layout.Description</p>
                </div>
            </div>
            <div class="dashboard-header-actions">

                @if (EditModeService.IsEnabled)
                {
                    <button type="button" class="btn btn-icon btn-sm btn-success" @onclick="OpenAddCategoryDialog" aria-label="Добавить категорию" title="Добавить категорию">
                        <i class="fa-regular fa-layer-plus"></i>
                    </button>

                    <button type="button" class="btn btn-icon btn-sm btn-outline-secondary" @onclick="OpenSettings" aria-label="Открыть настройки" title="Настройки">
                        <i class="fa-solid fa-gear" aria-hidden="true"></i>
                    </button>
                }

                <button type="button"
                        class="px-4 btn btn-icon btn-sm @(EditModeService.IsEnabled ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="ToggleEditMode"
                        aria-pressed="@EditModeService.IsEnabled"
                        aria-label="Переключить режим редактирования"
                        title="@(EditModeService.IsEnabled ? "Завершить редактирование" : "Редактировать")">
                    <i class="fa-solid @(EditModeService.IsEnabled ? "fa-check" : "fa-pen-nib")" aria-hidden="true"></i>
                </button>

            </div>
        </header>

        <div class="dashboard-grid" id="dashboard-grid">
            @foreach (var category in OrderedCategories)
            {
                <Category @key="category.Id" Model="@category"
                          Cards="@GetCards(category.Id)"
                          EditRequested="OpenEditCategoryDialog"
                          DeleteRequested="OpenDeleteCategoryConfirm"
                          CardSaved="OnCardSaved"
                          CardDeleted="OnCardDeleted" />
            }
        </div>
    </section>
}

@code {
    // Информационная часть раскладки (заголовок и описание). Хранится отдельно от категорий
    // и карточек: их API отдаёт плоскими списками (см. DashboardLayoutReadModel).
    private DashboardLayout _layout = new()
    {
        Id = 1
    };

    // Плоские списки, полученные из read-модели. Карточки хранят ссылку на категорию
    // через DashboardCategoryId, поэтому отдельная вложенная структура не нужна.
    // Список карточек общий для компонента: он нужен и для отрисовки категорий, и для
    // перетаскивания карточек между категориями.
    private readonly List<DashboardCategory> _categories = [];
    private readonly List<DashboardCard> _cards = [];

    private IEnumerable<DashboardCategory> OrderedCategories => _categories.OrderBy(x => x.Order);

    // Заголовок вкладки браузера повторяет заголовок в хедере, а при пустом значении — «Adashboard».
    private string PageTitleText => string.IsNullOrWhiteSpace(_layout.Title) ? "Adashboard" : _layout.Title;

    private IJSObjectReference? _module;
    private DotNetObjectReference<DashboardView>? _dotNetRef;
    private readonly SemaphoreSlim _reorderLock = new(1, 1);
    private bool _isLoaded;
    private bool _dragAndDropInitialized;

    // Текст ошибки загрузки раскладки: пока он задан, вместо дашборда показывается сообщение с кнопкой повтора.
    private string? _loadError;

    // Настройки сайта пока зашиты в клиенте: их вынесение в отдельное хранилище — отдельная задача.
    private const bool ShowLogo = true;
    private const string DefaultThemeMode = "auto";

    protected override void OnInitialized()
    {
        EditModeService.OnChange += OnEditModeChanged;
    }

    private void OnEditModeChanged() => InvokeAsync(StateHasChanged);

    private void ToggleEditMode() => EditModeService.Toggle();

    // Карточки указанной категории, упорядоченные по Position.
    private IReadOnlyList<DashboardCard> GetCards(int categoryId)
        => _cards.Where(x => x.DashboardCategoryId == categoryId).OrderBy(x => x.Position).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
            _dotNetRef = DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync("initializeTheme", DefaultThemeMode);

            await TryLoadAsync();
            return;
        }

        if (_isLoaded && !_dragAndDropInitialized && _module is not null && _dotNetRef is not null)
        {
            await _module.InvokeVoidAsync("initializeDragAndDrop", _dotNetRef);
            _dragAndDropInitialized = true;
        }

        if (_isLoaded && _module is not null)
        {
            await _module.InvokeVoidAsync("setEditMode", EditModeService.IsEnabled);
        }
    }

    // ---------------------------------------------------------------
    // Настройки раскладки.
    // ---------------------------------------------------------------

    private void OpenSettings()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(SettingsDialog.Layout)] = _layout,
            [nameof(SettingsDialog.OnSave)] = EventCallback.Factory.Create(this, OnSettingsSavedAsync)
        };

        DialogService.Show<SettingsDialog>("Настройки", parameters, closeOnOverlayClick: false);
    }

    private async Task OnSettingsSavedAsync()
    {
        // Диалог уже изменил заголовок и описание раскладки: остаётся сохранить их через API.
        await SaveLayoutInfoAsync();
        await InvokeAsync(StateHasChanged);
        DialogService.Close();
    }

    // ---------------------------------------------------------------
    // Категории: создание, изменение, удаление.
    // ---------------------------------------------------------------

    private void OpenAddCategoryDialog()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(CategoryDialog.Category)] = new DashboardCategory { DashboardLayoutId = _layout.Id },
            [nameof(CategoryDialog.OnSave)] = EventCallback.Factory.Create<DashboardCategory>(this, AddCategory)
        };

        DialogService.Show<CategoryDialog>("Создать категорию", parameters, closeOnOverlayClick: false);
    }

    private void OpenEditCategoryDialog(DashboardCategory category)
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(CategoryDialog.Category)] = category,
            [nameof(CategoryDialog.OnSave)] = EventCallback.Factory.Create<DashboardCategory>(this, SaveCategory)
        };

        DialogService.Show<CategoryDialog>("Редактировать категорию", parameters, closeOnOverlayClick: false);
    }

    private async Task AddCategory(DashboardCategory category)
    {
        // Новую категорию ставим в конец: порядок задаётся явно, идентификатор назначит сервер.
        category.Order = _categories.Count > 0 ? _categories.Max(x => x.Order) + 1 : 0;

        try
        {
            var created = await DashboardApi.CreateCategoryAsync(category);
            _categories.Add(created);
            await InvokeAsync(StateHasChanged);
            DialogService.Close();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Не удалось создать категорию. Код: {StatusCode}.", ex.StatusCode);
        }
    }

    private async Task SaveCategory(DashboardCategory category)
    {
        try
        {
            await DashboardApi.UpdateCategoryAsync(category);
            await InvokeAsync(StateHasChanged);
            DialogService.Close();
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Не удалось изменить категорию {CategoryId}. Код: {StatusCode}.", category.Id, ex.StatusCode);
        }
    }

    private async Task OpenDeleteCategoryConfirm(DashboardCategory category)
    {
        // Пустую категорию удаляем сразу: подтверждать нечего.
        if (_cards.All(x => x.DashboardCategoryId != category.Id))
        {
            await DeleteCategory(category);
            return;
        }

        var parameters = new Dictionary<string, object?>
        {
            [nameof(ConfirmDialog.Message)] = $"Удалить категорию «{category.Title}» вместе со всеми ссылками?",
            [nameof(ConfirmDialog.ConfirmLabel)] = "Удалить",
            [nameof(ConfirmDialog.OnConfirm)] = EventCallback.Factory.Create(this, () => DeleteCategory(category))
        };

        DialogService.Show<ConfirmDialog>("Подтверждение удаления", parameters, closeOnOverlayClick: true);
    }

    private async Task DeleteCategory(DashboardCategory category)
    {
        // Вместе с категорией удаляем файлы пользовательских иконок всех её карточек:
        // сервер чистит только записи БД, файлы изображений лежат отдельно.
        foreach (var card in _cards.Where(x => x.DashboardCategoryId == category.Id).ToList())
        {
            await TryDeleteCardImageAsync(card.Id);
        }

        try
        {
            await DashboardApi.DeleteCategoryAsync(category.Id);
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Не удалось удалить категорию {CategoryId}. Код: {StatusCode}.", category.Id, ex.StatusCode);
            return;
        }

        _cards.RemoveAll(x => x.DashboardCategoryId == category.Id);
        _categories.RemoveAll(x => x.Id == category.Id);
        await InvokeAsync(StateHasChanged);
    }

    // ---------------------------------------------------------------
    // Уведомления от Category об изменениях карточек.
    // Сохранение и удаление карточки выполняет сама категория (её диалоги и запросы к API);
    // здесь мы лишь поддерживаем общий список карточек в актуальном состоянии.
    // ---------------------------------------------------------------

    private void OnCardSaved(DashboardCard card)
    {
        // Новая карточка добавляется, изменённая — заменяется по идентификатору.
        var index = _cards.FindIndex(x => x.Id == card.Id);
        if (index >= 0)
        {
            _cards[index] = card;
        }
        else
        {
            _cards.Add(card);
        }
    }

    private void OnCardDeleted(DashboardCard card)
    {
        _cards.RemoveAll(x => x.Id == card.Id);
    }

    // ---------------------------------------------------------------
    // Переупорядочивание перетаскиванием (drag & drop) и изменение ширины.
    // -----------------------------------------------------------------

    [JSInvokable]
    public async Task OnCategoriesReordered(int[] orderedCategoryIds)
    {
        if (orderedCategoryIds.Length == 0)
        {
            return;
        }

        await _reorderLock.WaitAsync();
        try
        {
            var order = 0;
            var changed = new List<DashboardCategory>();

            foreach (var id in orderedCategoryIds)
            {
                var category = _categories.FirstOrDefault(x => x.Id == id);
                if (category is not null)
                {
                    category.Order = order;
                    changed.Add(category);
                    order++;
                }
            }

            // Категории, которых нет в присланном списке, уходят в конец, сохраняя относительный порядок.
            foreach (var category in _categories.OrderBy(x => x.Order))
            {
                if (Array.IndexOf(orderedCategoryIds, category.Id) < 0)
                {
                    category.Order = order;
                    changed.Add(category);
                    order++;
                }
            }

            await PersistCategoryOrderAsync(changed);
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Применяет новую ширину категории, полученную от перетаскивания маркера в клиенте.
    /// </summary>
    [JSInvokable]
    public async Task OnCategoryResized(int categoryId, int width)
    {
        var category = _categories.FirstOrDefault(x => x.Id == categoryId);
        if (category is null)
        {
            return;
        }

        var clampedWidth = Math.Clamp(width, 1, 12);
        if (category.Width == clampedWidth)
        {
            return;
        }

        await _reorderLock.WaitAsync();
        try
        {
            category.Width = clampedWidth;

            try
            {
                await DashboardApi.UpdateCategoryAsync(category);
            }
            catch (ApiException ex)
            {
                // Ошибку только логируем: ширину в памяти оставляем изменённой, чтобы состояние
                // интерфейса совпадало с показанным пользователю (как и при сортировке).
                Logger.LogWarning(ex, "Не удалось сохранить ширину категории {CategoryId}. Код: {StatusCode}.", category.Id, ex.StatusCode);
            }
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnCardsReordered(int sourceCategoryId, int targetCategoryId, int[] sourceCardIds, int[] targetCardIds)
    {
        await _reorderLock.WaitAsync();
        try
        {
            var cardsById = _cards.ToDictionary(x => x.Id, x => x);
            var changed = new List<DashboardCard>();

            // Список из DOM авторитетный: он полностью определяет состав и порядок карточек.
            ApplyCardOrder(sourceCategoryId, sourceCardIds, cardsById, changed);

            if (sourceCategoryId != targetCategoryId)
            {
                ApplyCardOrder(targetCategoryId, targetCardIds, cardsById, changed);
            }

            await PersistCardChangesAsync(changed);
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    private static void ApplyCardOrder(
        int categoryId,
        int[] orderedIds,
        IReadOnlyDictionary<int, DashboardCard> cardsById,
        List<DashboardCard> changed)
    {
        for (var i = 0; i < orderedIds.Length; i++)
        {
            if (!cardsById.TryGetValue(orderedIds[i], out var card))
            {
                continue;
            }

            card.DashboardCategoryId = categoryId;
            card.Position = i;

            if (!changed.Contains(card))
            {
                changed.Add(card);
            }
        }
    }

    private async Task PersistCategoryOrderAsync(IEnumerable<DashboardCategory> categories)
    {
        foreach (var category in categories)
        {
            try
            {
                await DashboardApi.UpdateCategoryAsync(category);
            }
            catch (ApiException ex)
            {
                Logger.LogWarning(ex, "Не удалось сохранить порядок категории {CategoryId}. Код: {StatusCode}.", category.Id, ex.StatusCode);
            }
        }
    }

    private async Task PersistCardChangesAsync(IEnumerable<DashboardCard> cards)
    {
        foreach (var card in cards)
        {
            try
            {
                await DashboardApi.UpdateCardAsync(card);
            }
            catch (ApiException ex)
            {
                Logger.LogWarning(ex, "Не удалось сохранить карточку {CardId}. Код: {StatusCode}.", card.Id, ex.StatusCode);
            }
        }
    }

    // ---------------------------------------------------------------
    // Загрузка и сохранение данных через API.
    // ---------------------------------------------------------------

    private async Task LoadLayoutAsync()
    {
        // Read-модель отдаёт раскладку и плоские списки категорий и карточек.
        var readModel = await DashboardApi.GetLayoutAsync();

        _layout = readModel?.Layout ?? new DashboardLayout { Id = 1 };

        _categories.Clear();
        _categories.AddRange(readModel?.Categories ?? []);

        _cards.Clear();
        _cards.AddRange(readModel?.Cards ?? []);
    }

    // Загружает раскладку, обрабатывая состояния загрузки, ошибки и повтора.
    private async Task TryLoadAsync()
    {
        try
        {
            await LoadLayoutAsync();
            _loadError = null;
            _isLoaded = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось загрузить раскладку dashboard.");
            _loadError = "Не удалось загрузить раскладку. Проверьте соединение с сервером и попробуйте снова.";
            StateHasChanged();
        }
    }

    // Повторная загрузка раскладки после ошибки (кнопка «Повторить»).
    private Task RetryLoadAsync() => TryLoadAsync();

    private async Task SaveLayoutInfoAsync()
    {
        try
        {
            await DashboardApi.SaveLayoutInfoAsync(_layout);
        }
        catch (ApiException ex)
        {
            // Refit выбрасывает ApiException при неуспешном ответе: оставляем понятное сообщение с кодом.
            throw new InvalidOperationException($"Не удалось сохранить раскладку (код {(int)ex.StatusCode}).", ex);
        }
    }

    // Удаление файла иконки не должно срывать другие операции: ошибку только логируем.
    private async Task TryDeleteCardImageAsync(int cardId)
    {
        try
        {
            await DashboardApi.DeleteImageAsync(cardId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось удалить изображение карточки {CardId} через API.", cardId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        EditModeService.OnChange -= OnEditModeChanged;

        // Диалоги настроек, категории, карточки и подтверждения держат колбэк на текущую
        // раскладку: закрываем их при уходе, чтобы не вызывать метод у уже удалённого компонента.
        if (DialogService.Current is not null &&
            (DialogService.Current.ComponentType == typeof(SettingsDialog)
             || DialogService.Current.ComponentType == typeof(CategoryDialog)
             || DialogService.Current.ComponentType == typeof(CardDialog)
             || DialogService.Current.ComponentType == typeof(ConfirmDialog)))
        {
            DialogService.Close();
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeDragAndDrop");
                await _module.DisposeAsync();
            }
            catch
            {
            }
        }

        _dotNetRef?.Dispose();
        _reorderLock.Dispose();
    }
}
