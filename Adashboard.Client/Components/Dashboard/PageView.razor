@implements IAsyncDisposable
@inject IDashboardApi DashboardApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<PageView> Logger

@*
    Содержимое открытой страницы dashboard: панель действий, сетка категорий и пустое состояние.

    Данные приходят каскадной моделью DashboardPageModel из Home: Home — владелец модели и
    состояний маршрута (загрузка, ошибки, 404), а этот компонент меняет общие списки категорий
    и карточек прямо в модели и перерисовывает себя.

    Категории укладывает по колонкам модуль js/dashboard.js: он позиционирует их абсолютно,
    поэтому сетке задаётся высота. Там же живёт перетаскивание категорий и изменение их ширины:
    результаты приходят обратно в OnCategoriesReordered и OnCategoryResized.

    Окна диалогов рисуются здесь же: открытость ведёт этот компонент, содержимое передаётся
    контейнеру, а закрывает окно сам диалог через каскадный DialogContainer.
*@

@{
    var isEditMode = AppStateService.IsEditMode;
    var categories = OrderedCategories;
}

<section class="dashboard-shell">
    @if (isEditMode)
    {
        <div class="page-actions" role="group" aria-label="Действия страницы">
            <p class="page-actions__title">
                <i class="fa-solid fa-pen-ruler" aria-hidden="true"></i> Настройка страницы
            </p>
            <div class="page-actions__buttons">
                <button type="button" class="btn btn-success" @onclick="() => _isAddCategoryOpen = true">
                    <i class="fa-solid fa-layer-plus" aria-hidden="true"></i> Добавить категорию
                </button>
                <button type="button" class="btn" @onclick="() => _isPageSettingsOpen = true">
                    <i class="fa-solid fa-gear" aria-hidden="true"></i> Настройки страницы
                </button>
                @if (!Model.IsMainPage)
                {
                    <button type="button" class="btn btn-danger" @onclick="RequestOrDeletePage">
                        <i class="fa-solid fa-trash" aria-hidden="true"></i> Удалить страницу
                    </button>
                }
            </div>
        </div>
    }

    @if (categories.Count == 0)
    {
        <p class="dashboard-empty" role="status">
            <i class="fa-regular fa-rectangle-list" aria-hidden="true"></i>
            <span>
                Нет содержимого.
                @if (isEditMode)
                {
                    <text>Добавьте первую категорию, чтобы наполнить страницу.</text>
                }
            </span>
        </p>
    }

    @* Сетка есть всегда, даже без категорий: модуль раскладки следит за её появлением
       и изменениями, поэтому элемент должен существовать с первого рендера. *@
    <div class="dashboard-grid" id="dashboard-grid">
        @foreach (var category in categories)
        {
            <Category @key="CategoryKey(category)" Model="category" Cards="GetCards(category.Id)" />
        }
    </div>
</section>

<DialogContainer @bind-Open="_isAddCategoryOpen" Title="Создать категорию">
    <CategoryDialog DashboardPageId="Model.Page.Id" Order="NextCategoryOrder" Saved="OnCategoryCreatedAsync" />
</DialogContainer>

<DialogContainer @bind-Open="_isPageSettingsOpen" Title="Настройки страницы">
    <PageDialog Page="Model.Page" Saved="OnPageSavedAsync" />
</DialogContainer>

<DialogContainer @bind-Open="_isDeletePageOpen" Title="Удаление страницы" Size="DialogContainer.DialogSize.ConfirmDialog">
    <ConfirmDialog Message="Удалить страницу вместе со всеми категориями и ссылками?" ConfirmLabel="Удалить" Confirmed="DeletePageAsync" />
</DialogContainer>

@code {
    private bool _isAddCategoryOpen;
    private bool _isPageSettingsOpen;
    private bool _isDeletePageOpen;

    // Модуль раскладки и перетаскивания; подключается на первом рендере.
    private IJSObjectReference? _module;

    // Ссылка на компонент для обратных вызовов из модуля (перетаскивание, изменение ширины).
    private DotNetObjectReference<PageView>? _dotNetRef;

    // Последний переданный в модуль режим редактирования: JS дёргаем только при изменении.
    private bool? _appliedEditMode;

    // Изменения порядка и ширины уходят в API по одному: одновременно больше одной записи не бывает.
    private readonly SemaphoreSlim _reorderLock = new(1, 1);

    [CascadingParameter]
    private AppStateService AppStateService { get; set; } = null!;

    [CascadingParameter]
    private DashboardPageModel Model { get; set; } = null!;

    /// <summary>
    /// Уведомление Home об изменении данных страницы: шапка получает страницу параметром
    /// и должна перерисоваться.
    /// </summary>
    [Parameter]
    public EventCallback PageInfoSaved { get; set; }

    private IReadOnlyList<DashboardCategory> OrderedCategories => Model.Categories.OrderBy(x => x.Order).ToList();

    // Порядковый номер новой категории: она добавляется в конец списка.
    private int NextCategoryOrder => Model.Categories.Count > 0 ? Model.Categories.Max(x => x.Order) + 1 : 0;


    // Карточки указанной категории, упорядоченные по положению. Read-модель отдаёт карточки
    // плоским списком, поэтому категория получает свои карточки параметром.
    private IReadOnlyList<DashboardCard> GetCards(int categoryId)
        => Model.Cards.Where(x => x.DashboardCategoryId == categoryId).OrderBy(x => x.Position).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
                await _module.InvokeVoidAsync("initializeLayout");

                _dotNetRef = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("initializeDragAndDrop", _dotNetRef);
            }
            catch (JSException ex)
            {
                // Без раскладки страница остаётся рабочей: категории идут одной колонкой (CSS),
                // перетаскивание и изменение ширины при этом недоступны.
                Logger.LogWarning(ex, "Модуль раскладки dashboard не подключён: категории показаны одной колонкой.");
                _module = null;
            }
        }

        // Режим редактирования может смениться в любой момент: модуль получает флаг при перерисовке.
        if (_module is not null && _appliedEditMode != AppStateService.IsEditMode)
        {
            _appliedEditMode = AppStateService.IsEditMode;

            try
            {
                await _module.InvokeVoidAsync("setEditMode", _appliedEditMode);
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Не удалось передать режим редактирования в модуль раскладки.");
            }
        }
    }

    // Новая категория создана диалогом: кладём её в общий список, перерисовываем сетку.
    // Окно закрывает сам диалог через каскадный DialogContainer.
    private Task OnCategoryCreatedAsync(DashboardCategory category)
    {
        Model.Categories.Add(category);
        return InvokeAsync(StateHasChanged);
    }

    // Страница изменена диалогом: обновляем её в модели и, если путь изменился, переходим на новый
    // адрес (Home загрузит страницу заново по нему).
    private async Task OnPageSavedAsync(DashboardPage page)
    {
        var pathChanged = !string.Equals(page.Path, Model.Page.Path, StringComparison.Ordinal);
        Model.Page = page;

        var index = Model.Pages.FindIndex(x => x.Id == page.Id);
        if (index >= 0)
        {
            Model.Pages[index] = page;
        }

        // Заголовок и описание страницы показывают шапка и вкладка браузера: сообщаем Home.
        await PageInfoSaved.InvokeAsync();

        if (pathChanged)
        {
            Navigation.NavigateTo(page.Path.Length == 0 ? "/" : "/" + page.Path);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    // Если категорий нет - не запрашивать подтверждение
    private async Task RequestOrDeletePage()
    {
        if (Model.Categories.Any())
            _isDeletePageOpen = true;
        else
            await DeletePageAsync();
    }

    private async Task DeletePageAsync()
    {
        Logger.LogDebug("Удаление страницы dashboard {PageId}.", Model.Page.Id);

        try
        {
            var response = await DashboardApi.DeletePageAsync(Model.Page.Id);
            if (!response.IsSuccessStatusCode)
            {
                Logger.LogWarning("Удаление страницы {PageId} завершилось ошибкой API. Код: {StatusCode}.", Model.Page.Id, (int?)response.StatusCode);
                return;
            }

            Logger.LogInformation("Страница dashboard удалена. Идентификатор: {PageId}.", Model.Page.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось удалить страницу dashboard {PageId}.", Model.Page.Id);
            return;
        }

        // Текущей страницы больше нет: возвращаемся на основную.
        Navigation.NavigateTo("/");
    }

    // ---------------------------------------------------------------
    // Перетаскивание категорий и изменение их ширины (из модуля js/dashboard.js).
    // Изменения сразу уходят в API по одному элементу: серверного батча нет.
    // Сохраняем только то, что действительно изменилось.
    // ---------------------------------------------------------------

    /// <summary>
    /// Применяет новый порядок категорий, полученный от перетаскивания.
    /// </summary>
    [JSInvokable]
    public async Task OnCategoriesReordered(int[] orderedCategoryIds)
    {
        if (orderedCategoryIds.Length == 0)
        {
            return;
        }

        await _reorderLock.WaitAsync();
        try
        {
            // Сначала считаем желаемый порядок, не трогая модель: иначе не отличить реальное
            // изменение от перетаскивания на прежнее место (такой drop уже отсекает модуль,
            // но проверка защищает и от совпадающего итогового порядка).
            var target = new List<(DashboardCategory Category, int Order)>();
            var order = 0;

            foreach (var id in orderedCategoryIds)
            {
                var category = Model.Categories.FirstOrDefault(x => x.Id == id);
                if (category is not null)
                {
                    target.Add((category, order));
                    order++;
                }
            }

            // Категории, которых нет в присланном списке, уходят в конец, сохраняя относительный порядок.
            foreach (var category in Model.Categories.OrderBy(x => x.Order).ToList())
            {
                if (Array.IndexOf(orderedCategoryIds, category.Id) < 0)
                {
                    target.Add((category, order));
                    order++;
                }
            }

            var changed = target.Where(x => x.Category.Order != x.Order).ToList();
            if (changed.Count == 0)
            {
                Logger.LogDebug("Порядок категорий не изменился: сохранение не требуется.");
                return;
            }

            foreach (var (category, newOrder) in target)
            {
                category.Order = newOrder;
            }

            Logger.LogDebug("Применён новый порядок категорий. Изменено категорий: {Count}.", changed.Count);
            await PersistCategoryChangesAsync(changed.Select(x => x.Category).ToList());
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Применяет новую ширину категории, полученную от маркера изменения ширины.
    /// </summary>
    [JSInvokable]
    public async Task OnCategoryResized(int categoryId, int width)
    {
        var category = Model.Categories.FirstOrDefault(x => x.Id == categoryId);
        if (category is null)
        {
            return;
        }

        var clampedWidth = Math.Clamp(width, 1, 12);
        if (category.Width == clampedWidth)
        {
            return;
        }

        await _reorderLock.WaitAsync();
        try
        {
            category.Width = clampedWidth;

            Logger.LogDebug("Изменена ширина категории {CategoryId} на {Width}.", category.Id, clampedWidth);
            await PersistCategoryChangesAsync([category]);
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    // Сохраняет изменённые категории по одной: ошибку отдельной записи только логируем,
    // чтобы состояние интерфейса совпадало с показанным пользователю.
    private async Task PersistCategoryChangesAsync(IReadOnlyCollection<DashboardCategory> categories)
    {
        if (categories.Count == 0)
        {
            return;
        }

        foreach (var category in categories)
        {
            try
            {
                var response = await DashboardApi.UpdateCategoryAsync(category);
                if (!response.IsSuccessStatusCode)
                {
                    Logger.LogWarning("Не удалось сохранить категорию {CategoryId}. Код: {StatusCode}.", category.Id, (int?)response.StatusCode);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Не удалось сохранить категорию {CategoryId}.", category.Id);
            }
        }

        Logger.LogInformation("Изменения категорий dashboard сохранены. Категорий: {Count}.", categories.Count);
    }

    // Ключ включает ширину: после ресайза категория перерисовывается и получает корректные
    // значения span для всех брейкпоинтов, а не только для текущего.
    private static string CategoryKey(DashboardCategory category) => $"{category.Id}:{category.Width}";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeDragAndDrop");
                await _module.InvokeVoidAsync("disposeLayout");
                await _module.DisposeAsync();
            }
            catch (Exception)
            {
                // Соединение с JS потеряно: освобождать больше нечего.
            }
        }

        _dotNetRef?.Dispose();
        _reorderLock.Dispose();
    }
}
