@using Adashboard.Client.Components.Pages
@using Adashboard.Client.Services
@using Refit
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IDashboardApi DashboardApi
@inject DashboardApiOptions ApiOptions
@inject DialogService DialogService
@inject EditModeService EditModeService
@inject ILogger<PageView> Logger

@*
    Страница dashboard: загрузка данных, шапка (через PageHeader), сетка категорий
    и операции со страницей в целом (перетаскивание категорий, изменение ширины,
    добавление категории, настройки и удаление страницы).

    Сама категория (Category) отвечает за свои операции: изменение, удаление и работу
    с карточками. Сюда приходят только уведомления об изменениях (CategorySaved/CategoryDeleted
    и CardSaved/CardDeleted), чтобы поддерживать общие списки в актуальном состоянии.
*@

@if (!_isLoaded)
{
    if (_loadError is null)
    {
        <div class="dashboard-loading" role="status" aria-live="polite" aria-label="Загрузка dashboard">
            <span class="dashboard-loading__spinner" aria-hidden="true"></span>
        </div>
    }
    else
    {
        @* Понятное состояние ошибки с возможностью повторить загрузку. *@
        <div class="dashboard-loading" role="alert">
            <p class="text-danger">@_loadError</p>
            <button type="button" class="btn btn-primary" @onclick="RetryLoadAsync">
                <i class="fa-solid fa-rotate-right" aria-hidden="true"></i> Повторить
            </button>
        </div>
    }
}
else if (_pageNotFound)
{
    @* Путь из адреса не совпал ни с одной страницей: предлагаем вернуться на основную. *@
    <div class="dashboard-loading" role="alert">
        <p class="text-danger">Страница не найдена.</p>
        <a class="btn btn-primary" href="/">На главную</a>
    </div>
}
else
{
    <section class="dashboard-shell">
        <PageHeader Page="@_page"
                    Pages="_pages"
                    PageCreated="OnPageCreated" />

        @if (EditModeService.IsEnabled)
        {
            <div class="page-actions">
                <button type="button" class="btn btn-sm btn-success" @onclick="OpenAddCategoryDialog">
                    <i class="fa-solid fa-layer-plus" aria-hidden="true"></i> Добавить категорию
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenPageSettings">
                    <i class="fa-solid fa-gear" aria-hidden="true"></i> Настройки страницы
                </button>
                @if (!IsMainPage)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RequestDeletePageAsync">
                        <i class="fa-solid fa-trash" aria-hidden="true"></i> Удалить страницу
                    </button>
                }
            </div>
        }

        <div class="dashboard-grid" id="dashboard-grid">
            @foreach (var category in OrderedCategories)
            {
                <Category @key="category.Id" Model="@category"
                          Pages="_pages"
                          Cards="@GetCards(category.Id)"
                          Saved="OnCategorySaved"
                          Deleted="OnCategoryDeleted"
                          CardSaved="OnCardSaved"
                          CardDeleted="OnCardDeleted" />
            }
        </div>
    </section>
}

@code {
    // Информационная часть страницы (заголовок, описание и путь). Хранится отдельно от категорий
    // и карточек: их API отдаёт плоскими списками (см. DashboardPageReadModel).
    private DashboardPage _page = new();

    // Список всех страниц нужен селектору страницы в диалоге категории.
    private List<DashboardPage> _pages = [];

    // Плоские списки, полученные из read-модели. Карточки хранят ссылку на категорию
    // через DashboardCategoryId, поэтому отдельная вложенная структура не нужна.
    // Список карточек общий для компонента: он нужен и для отрисовки категорий, и для
    // перетаскивания карточек между категориями.
    private readonly List<DashboardCategory> _categories = [];
    private readonly List<DashboardCard> _cards = [];

    private IEnumerable<DashboardCategory> OrderedCategories => _categories.OrderBy(x => x.Order);

    // Порядковый номер для новой категории: она добавляется в конец списка.
    private int NextCategoryOrder => _categories.Count > 0 ? _categories.Max(x => x.Order) + 1 : 0;

    private IJSObjectReference? _module;
    private DotNetObjectReference<PageView>? _dotNetRef;
    private readonly SemaphoreSlim _reorderLock = new(1, 1);
    private bool _isLoaded;
    private bool _pageNotFound;
    private bool _dragAndDropInitialized;

    // Нормализованный путь загруженной страницы: нужен, чтобы отличить смену пути
    // при переходе между страницами от обычной перерисовки.
    private string _loadedPath = string.Empty;

    // Текст ошибки загрузки страницы: пока он задан, вместо дашборда показывается сообщение с кнопкой повтора.
    private string? _loadError;

    // Файлы оформления лежат в каталоге загрузок API, а не в статике клиента. Пути к ним
    // переводим в абсолютные адреса API (ResolveUploadPath), иначе при запуске клиента
    // отдельно от сервера они запрашивались бы у клиентского dev-сервера и давали 404.
    private const string LightBackgroundAsset = "/uploads/assets/bg-light.jpg";
    private const string DarkBackgroundAsset = "/uploads/assets/bg-dark.jpg";

    /// <summary>Путь открываемой страницы из адреса; <c>null</c> для корневого адреса «/».</summary>
    [Parameter]
    public string? PagePath { get; set; }

    // Основная страница имеет пустой путь и не удаляется.
    private bool IsMainPage => _page.Path.Length == 0;

    protected override void OnInitialized()
    {
        EditModeService.OnChange += OnEditModeChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var normalized = NormalizePath(PagePath);

        // Переход между страницами приходит сменой параметра маршрута: перезагружаем данные.
        if (_isLoaded && !string.Equals(normalized, _loadedPath, StringComparison.OrdinalIgnoreCase))
        {
            await TryLoadAsync();
        }
    }

    private void OnEditModeChanged() => InvokeAsync(StateHasChanged);

    // Карточки указанной категории, упорядоченные по Position.
    private IReadOnlyList<DashboardCard> GetCards(int categoryId)
        => _cards.Where(x => x.DashboardCategoryId == categoryId).OrderBy(x => x.Position).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
            _dotNetRef = DotNetObjectReference.Create(this);

            // Фон страницы задан в CSS, но сами файлы лежат в API. Абсолютные адреса
            // передаём в модуль: CSS-переменные не умеют подставлять адрес другого origin.
            await _module.InvokeVoidAsync(
                "setBackgroundImages",
                ApiOptions.ResolveUploadPath(LightBackgroundAsset),
                ApiOptions.ResolveUploadPath(DarkBackgroundAsset));

            await TryLoadAsync();
            return;
        }

        if (_isLoaded && !_pageNotFound && !_dragAndDropInitialized && _module is not null && _dotNetRef is not null)
        {
            await _module.InvokeVoidAsync("initializeDragAndDrop", _dotNetRef);
            _dragAndDropInitialized = true;
        }

        if (_isLoaded && _module is not null)
        {
            await _module.InvokeVoidAsync("setEditMode", EditModeService.IsEnabled);
        }
    }

    // ---------------------------------------------------------------
    // Действия над страницей: добавление категории, настройки и удаление.
    // Сами запросы к API выполняют диалоги, здесь мы поддерживаем состояние списков.
    // ---------------------------------------------------------------

    private void OpenAddCategoryDialog()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(CategoryDialog.DashboardPageId)] = _page.Id,
            [nameof(CategoryDialog.Order)] = NextCategoryOrder,
            [nameof(CategoryDialog.Pages)] = _pages,
            [nameof(CategoryDialog.OnSave)] = EventCallback.Factory.Create<DashboardCategory>(this, OnCategoryCreatedAsync)
        };

        DialogService.Show<CategoryDialog>("Создать категорию", parameters, closeOnOverlayClick: false);
    }

    private void OpenPageSettings()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(PageDialog.Page)] = _page,
            [nameof(PageDialog.ExistingPaths)] = _pages.Select(x => x.Path).ToList(),
            [nameof(PageDialog.OnSave)] = EventCallback.Factory.Create<DashboardPage>(this, OnPageInfoSavedAsync)
        };

        DialogService.Show<PageDialog>("Настройки страницы", parameters, closeOnOverlayClick: false);
    }

    private Task OnPageInfoSavedAsync(DashboardPage page)
    {
        var pathChanged = !string.Equals(page.Path, _page.Path, StringComparison.Ordinal);

        _page = page;

        // Страницу переименовали по пути — переходим на новый адрес, чтобы он совпадал с адресной строкой.
        if (pathChanged)
        {
            Navigation.NavigateTo("/" + page.Path);
        }

        DialogService.Close();
        return InvokeAsync(StateHasChanged);
    }

    // Новая страница создана в шапке: переходим на неё, чтобы продолжить настройку.
    private Task OnPageCreated(DashboardPage page)
    {
        Navigation.NavigateTo("/" + page.Path);
        return Task.CompletedTask;
    }

    private async Task RequestDeletePageAsync()
    {
        // Пустую страницу удаляем сразу: подтверждать нечего.
        if (_categories.Count == 0)
        {
            await DeletePageAsync();
            return;
        }

        var parameters = new Dictionary<string, object?>
        {
            [nameof(ConfirmDialog.Message)] = $"Удалить страницу «{_page.Title}» вместе со всеми категориями и ссылками?",
            [nameof(ConfirmDialog.ConfirmLabel)] = "Удалить",
            [nameof(ConfirmDialog.OnConfirm)] = EventCallback.Factory.Create(this, DeletePageAsync)
        };

        DialogService.Show<ConfirmDialog>("Подтверждение удаления", parameters, closeOnOverlayClick: true);
    }

    private async Task DeletePageAsync()
    {
        try
        {
            await DashboardApi.DeletePageAsync(_page.Id);
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Не удалось удалить страницу {PageId}. Код: {StatusCode}.", _page.Id, ex.StatusCode);
            return;
        }

        // Возвращаемся на основную страницу: текущей больше не существует.
        // Диалог подтверждения закрывает себя сам после вызова OnConfirm.
        Navigation.NavigateTo("/");
    }

    // ---------------------------------------------------------------
    // Уведомления от Category и PageHeader об изменениях категорий.
    // Изменение и удаление выполняет сама Category, создание — диалог на странице;
    // здесь мы лишь поддерживаем общий список категорий в актуальном состоянии.
    // ---------------------------------------------------------------

    private Task OnCategoryCreatedAsync(DashboardCategory category)
    {
        // Новую категорию добавляем в конец; диалог создания закрываем здесь, потому что
        // открывал его сам компонент страницы.
        _categories.Add(category);
        DialogService.Close();

        return InvokeAsync(StateHasChanged);
    }

    // Категория сохранена из своего компонента Category (изменение или перенос на другую страницу).
    private Task OnCategorySaved(DashboardCategory category)
    {
        // Категорию могли перенести на другую страницу: тогда убираем её из текущего списка.
        if (category.DashboardPageId != _page.Id)
        {
            _cards.RemoveAll(x => x.DashboardCategoryId == category.Id);
            _categories.RemoveAll(x => x.Id == category.Id);
            return InvokeAsync(StateHasChanged);
        }

        // Изменённая категория заменяется по идентификатору.
        var index = _categories.FindIndex(x => x.Id == category.Id);
        if (index >= 0)
        {
            _categories[index] = category;
        }
        else
        {
            _categories.Add(category);
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task OnCategoryDeleted(DashboardCategory category)
    {
        _cards.RemoveAll(x => x.DashboardCategoryId == category.Id);
        _categories.RemoveAll(x => x.Id == category.Id);

        return InvokeAsync(StateHasChanged);
    }

    // ---------------------------------------------------------------
    // Уведомления от Category об изменениях карточек.
    // Сохранение и удаление карточки выполняет сама категория (её диалоги и запросы к API);
    // здесь мы лишь поддерживаем общий список карточек в актуальном состоянии.
    // ---------------------------------------------------------------

    private void OnCardSaved(DashboardCard card)
    {
        // Новая карточка добавляется, изменённая — заменяется по идентификатору.
        var index = _cards.FindIndex(x => x.Id == card.Id);
        if (index >= 0)
        {
            _cards[index] = card;
        }
        else
        {
            _cards.Add(card);
        }
    }

    private void OnCardDeleted(DashboardCard card)
    {
        _cards.RemoveAll(x => x.Id == card.Id);
    }

    // ---------------------------------------------------------------
    // Переупорядочивание перетаскиванием (drag & drop) и изменение ширины.
    // -----------------------------------------------------------------

    [JSInvokable]
    public async Task OnCategoriesReordered(int[] orderedCategoryIds)
    {
        if (orderedCategoryIds.Length == 0)
        {
            return;
        }

        await _reorderLock.WaitAsync();
        try
        {
            var order = 0;
            var changed = new List<DashboardCategory>();

            foreach (var id in orderedCategoryIds)
            {
                var category = _categories.FirstOrDefault(x => x.Id == id);
                if (category is not null)
                {
                    category.Order = order;
                    changed.Add(category);
                    order++;
                }
            }

            // Категории, которых нет в присланном списке, уходят в конец, сохраняя относительный порядок.
            foreach (var category in _categories.OrderBy(x => x.Order))
            {
                if (Array.IndexOf(orderedCategoryIds, category.Id) < 0)
                {
                    category.Order = order;
                    changed.Add(category);
                    order++;
                }
            }

            await PersistCategoryOrderAsync(changed);
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Применяет новую ширину категории, полученную от перетаскивания маркера в клиенте.
    /// </summary>
    [JSInvokable]
    public async Task OnCategoryResized(int categoryId, int width)
    {
        var category = _categories.FirstOrDefault(x => x.Id == categoryId);
        if (category is null)
        {
            return;
        }

        var clampedWidth = Math.Clamp(width, 1, 12);
        if (category.Width == clampedWidth)
        {
            return;
        }

        await _reorderLock.WaitAsync();
        try
        {
            category.Width = clampedWidth;

            try
            {
                await DashboardApi.UpdateCategoryAsync(category);
            }
            catch (ApiException ex)
            {
                // Ошибку только логируем: ширину в памяти оставляем изменённой, чтобы состояние
                // интерфейса совпадало с показанным пользователю (как и при сортировке).
                Logger.LogWarning(ex, "Не удалось сохранить ширину категории {CategoryId}. Код: {StatusCode}.", category.Id, ex.StatusCode);
            }
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnCardsReordered(int sourceCategoryId, int targetCategoryId, int[] sourceCardIds, int[] targetCardIds)
    {
        await _reorderLock.WaitAsync();
        try
        {
            var cardsById = _cards.ToDictionary(x => x.Id, x => x);
            var changed = new List<DashboardCard>();

            // Список из DOM авторитетный: он полностью определяет состав и порядок карточек.
            ApplyCardOrder(sourceCategoryId, sourceCardIds, cardsById, changed);

            if (sourceCategoryId != targetCategoryId)
            {
                ApplyCardOrder(targetCategoryId, targetCardIds, cardsById, changed);
            }

            await PersistCardChangesAsync(changed);
        }
        finally
        {
            _reorderLock.Release();
        }

        await InvokeAsync(StateHasChanged);
    }

    private static void ApplyCardOrder(
        int categoryId,
        int[] orderedIds,
        IReadOnlyDictionary<int, DashboardCard> cardsById,
        List<DashboardCard> changed)
    {
        for (var i = 0; i < orderedIds.Length; i++)
        {
            if (!cardsById.TryGetValue(orderedIds[i], out var card))
            {
                continue;
            }

            card.DashboardCategoryId = categoryId;
            card.Position = i;

            if (!changed.Contains(card))
            {
                changed.Add(card);
            }
        }
    }

    private async Task PersistCategoryOrderAsync(IEnumerable<DashboardCategory> categories)
    {
        foreach (var category in categories)
        {
            try
            {
                await DashboardApi.UpdateCategoryAsync(category);
            }
            catch (ApiException ex)
            {
                Logger.LogWarning(ex, "Не удалось сохранить порядок категории {CategoryId}. Код: {StatusCode}.", category.Id, ex.StatusCode);
            }
        }
    }

    private async Task PersistCardChangesAsync(IEnumerable<DashboardCard> cards)
    {
        foreach (var card in cards)
        {
            try
            {
                await DashboardApi.UpdateCardAsync(card);
            }
            catch (ApiException ex)
            {
                Logger.LogWarning(ex, "Не удалось сохранить карточку {CardId}. Код: {StatusCode}.", card.Id, ex.StatusCode);
            }
        }
    }

    // ---------------------------------------------------------------
    // Загрузка данных через API.
    // ---------------------------------------------------------------

    private async Task LoadPageAsync()
    {
        var normalized = NormalizePath(PagePath);
        _loadedPath = normalized;

        // Список страниц нужен, чтобы по адресу найти нужную, а затем загрузить её содержимое.
        _pages = (await DashboardApi.GetPagesAsync()).ToList();

        var page = _pages.FirstOrDefault(p => string.Equals(p.Path, normalized, StringComparison.OrdinalIgnoreCase));
        if (page is null)
        {
            _pageNotFound = true;
            _categories.Clear();
            _cards.Clear();
            return;
        }

        _pageNotFound = false;

        // Read-модель отдаёт страницу и плоские списки категорий и карточек.
        var readModel = await DashboardApi.GetPageAsync(page.Id);

        _page = readModel?.Page ?? page;

        _categories.Clear();
        _categories.AddRange(readModel?.Categories ?? []);

        _cards.Clear();
        _cards.AddRange(readModel?.Cards ?? []);
    }

    // Приводит путь из адреса к виду, в котором он хранится: без ведущих и завершающих слэшей.
    private static string NormalizePath(string? path)
        => path?.Trim().Trim('/') ?? string.Empty;

    // Загружает страницу, обрабатывая состояния загрузки, ошибки и повтора.
    private async Task TryLoadAsync()
    {
        try
        {
            await LoadPageAsync();
            _loadError = null;
            _isLoaded = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось загрузить страницу dashboard.");
            _loadError = "Не удалось загрузить страницу. Проверьте соединение с сервером и попробуйте снова.";
            StateHasChanged();
        }
    }

    // Повторная загрузка страницы после ошибки (кнопка «Повторить»).
    private Task RetryLoadAsync() => TryLoadAsync();

    public async ValueTask DisposeAsync()
    {
        EditModeService.OnChange -= OnEditModeChanged;

        // Диалоги настроек, страницы, категории, карточки и подтверждения держат колбэк на компоненты
        // страницы: закрываем их при уходе, чтобы не вызывать метод у уже удалённого компонента.
        if (DialogService.Current is not null &&
            (DialogService.Current.ComponentType == typeof(PageDialog)
             || DialogService.Current.ComponentType == typeof(SiteSettingsDialog)
             || DialogService.Current.ComponentType == typeof(CategoryDialog)
             || DialogService.Current.ComponentType == typeof(CardDialog)
             || DialogService.Current.ComponentType == typeof(ConfirmDialog)))
        {
            DialogService.Close();
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeDragAndDrop");
                await _module.DisposeAsync();
            }
            catch
            {
            }
        }

        _dotNetRef?.Dispose();
        _reorderLock.Dispose();
    }
}
