@using Adashboard.Client.Helpers
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<PageView> Logger
@*
    Содержимое открытой страницы dashboard: панель действий, сетка категорий и пустое состояние.

    Данные приходят из DashboardDataService (каскадное значение): он единственный владелец списков
    страниц, категорий и карточек, поэтому после сохранений список обновляет сам сервис, а компонент
    перерисовывается уведомлением каскадного значения.

    Категории укладывает по колонкам модуль js/dashboard.js: он позиционирует их абсолютно,
    поэтому сетке задаётся высота. Там же живёт перетаскивание категорий и карточек, а также
    изменение ширины категории: результаты приходят обратно в OnCategoriesReordered,
    OnCategoryResized и OnCardsReordered, и порядок или ширину применяет сервис — только после
    успешного ответа API.

    Окна диалогов рисуются здесь же: открытость ведёт этот компонент, содержимое передаётся
    контейнеру, а закрывает окно сам диалог через каскадный DialogContainer. Справочники страниц
    и категорий диалоги берут из того же сервиса.
*@

@{
    var isEditMode = AppStateService.IsEditMode;

    // Сортировку категорий делаем один раз на рендер: карточки каждой категории сервис
    // отдаёт уже отсортированными по положению.
    var categories = Data.GetCategories();
}

<section class="dashboard-shell">
    @if (isEditMode)
    {
        <div class="page-actions" role="group" aria-label="Действия страницы">
            <p class="page-actions__title">
                <i class="fa-solid fa-pen-ruler" aria-hidden="true"></i> Режим редактирования
            </p>
            <div class="page-actions__buttons">
                <button type="button" class="btn btn-success" @onclick="() => _isAddCategoryOpen = true">
                    <i class="fa-solid fa-layer-group" aria-hidden="true"></i> Добавить категорию
                </button>
                <button type="button" class="btn" @onclick="() => _isPageSettingsOpen = true">
                    <i class="fa-solid fa-gear" aria-hidden="true"></i> Настройки страницы
                </button>
                @if (!SelectedPage.IsMainPage())
                {
                    <button type="button" class="btn btn-danger" @onclick="RequestOrDeletePage">
                        <i class="fa-solid fa-trash" aria-hidden="true"></i> Удалить страницу
                    </button>
                }
            </div>
        </div>
    }

    @if (categories.Count == 0)
    {
        <p class="dashboard-empty" role="status">
            <i class="fa-regular fa-rectangle-list" aria-hidden="true"></i>
            <span>
                Нет содержимого.
                @if (isEditMode)
                {
                    <text>Добавьте первую категорию, чтобы наполнить страницу.</text>
                }
            </span>
        </p>
    }

    @* Сетка есть всегда, даже без категорий: модуль раскладки следит за её появлением
       и изменениями, поэтому элемент должен существовать с первого рендера. *@
    <div class="dashboard-grid" id="dashboard-grid">
        @foreach (var category in categories)
        {
            <Category @key="CategoryKey(category)"
                      Model="category"
                      Cards="Data.GetCards(category.Id)" />
        }
    </div>
</section>

<DialogContainer @bind-Open="_isAddCategoryOpen" Title="Создать категорию">
    <CategoryDialog DashboardPageId="SelectedPage.Id" />
</DialogContainer>

<DialogContainer @bind-Open="_isPageSettingsOpen" Title="Настройки страницы">
    <PageDialog Page="SelectedPage" Saved="OnPageSavedAsync" />
</DialogContainer>

<DialogContainer @bind-Open="_isDeletePageOpen" Title="Удаление страницы" Size="DialogContainer.DialogSize.ConfirmDialog">
    <ConfirmDialog Message="Удалить страницу вместе со всеми категориями и ссылками?" ConfirmLabel="Удалить" Confirmed="DeletePageAsync" />
</DialogContainer>

@code {
    private bool _isAddCategoryOpen;
    private bool _isPageSettingsOpen;
    private bool _isDeletePageOpen;

    // Модуль раскладки и перетаскивания; подключается на первом рендере.
    private IJSObjectReference? _module;

    // Ссылка на компонент для обратных вызовов из модуля (перетаскивание, изменение ширины).
    private DotNetObjectReference<PageView>? _dotnetRef;

    // Последний переданный в модуль режим редактирования: JS дёргаем только при изменении.
    private bool? _appliedEditMode;

    [CascadingParameter]
    private AppStateService AppStateService { get; set; } = null!;

    /// <summary>
    /// Единственный владелец dashboard-данных: категории, карточки и выбранная страница.
    /// </summary>
    [CascadingParameter]
    private DashboardDataService Data { get; set; } = null!;

    // Открытая страница. Отдельное имя: в разметке «@page» Razor разбирает как директиву,
    // а не как обращение к странице.
    private DashboardPage SelectedPage => Data.SelectedPage.Page;

    // Диалог страницы: данные обновляет сервис, а при изменении пути переходим на новый адрес
    // (Home выберет страницу из локальных данных).
    private async Task OnPageSavedAsync(DashboardPage page)
    {
        var pathChanged = !string.Equals(page.Path, SelectedPage.Path, StringComparison.Ordinal);

        if (pathChanged)
        {
            Navigation.NavigateTo(page.Path.Length == 0 ? "/" : "/" + page.Path);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
                await _module.InvokeVoidAsync("initializeLayout");

                _dotnetRef = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("initializeDragAndDrop", _dotnetRef);
            }
            catch (JSException ex)
            {
                // Без раскладки страница остаётся рабочей: категории идут одной колонкой (CSS),
                // перетаскивание и изменение ширины при этом недоступны.
                Logger.LogWarning(ex, "Модуль раскладки dashboard не подключён: категории показаны одной колонкой.");
                _module = null;
            }
        }

        // Режим редактирования может смениться в любой момент: модуль получает флаг при перерисовке.
        if (_module is not null && _appliedEditMode != AppStateService.IsEditMode)
        {
            _appliedEditMode = AppStateService.IsEditMode;

            try
            {
                await _module.InvokeVoidAsync("setEditMode", _appliedEditMode);
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Не удалось передать режим редактирования в модуль раскладки.");
            }
        }
    }

    // Если категорий нет - не запрашивать подтверждение
    private async Task RequestOrDeletePage()
    {
        if (Data.GetCategories().Count > 0)
            _isDeletePageOpen = true;
        else
            await DeletePageAsync();
    }

    private async Task DeletePageAsync()
    {
        var page = SelectedPage;
        if (page.Id == 0)
        {
            return;
        }

        var error = await Data.DeletePageAsync(page.Id);
        if (error is not null)
        {
            Logger.LogWarning(error);
            return;
        }

        // Текущей страницы больше нет: возвращаемся на основную.
        Navigation.NavigateTo("/");
    }

    // ---------------------------------------------------------------
    // Перетаскивание категорий и изменение их ширины (из модуля js/dashboard.js).
    // Порядок и ширину применяет сервис: значения становятся видимыми только после
    // успешного ответа API, поэтому при отказе интерфейс остаётся с прежними значениями.
    // ---------------------------------------------------------------

    /// <summary>
    /// Применяет новый порядок категорий, полученный от перетаскивания.
    /// </summary>
    [JSInvokable]
    public async Task OnCategoriesReordered(int[] orderedCategoryIds)
    {
        if (orderedCategoryIds.Length == 0)
            return;

        var error = await Data.ReorderCategoriesAsync(orderedCategoryIds);
        if (error is not null)
            Logger.LogWarning(error);
    }

    /// <summary>
    /// Применяет новую ширину категории, полученную от маркера изменения ширины.
    /// </summary>
    [JSInvokable]
    public async Task OnCategoryResized(int categoryId, int width, bool isMobile)
    {
        var error = await Data.SetCategoryWidthAsync(categoryId, width, isMobile);
        if (error is not null)
            Logger.LogWarning(error);
    }

    /// <summary>
    /// Применяет новый порядок карточек, полученный от перетаскивания, в том числе с переносом в другую категорию.
    /// </summary>
    [JSInvokable]
    public async Task OnCardsReordered(int sourceCategoryId, int targetCategoryId, int[] sourceCardIds, int[] targetCardIds)
    {
        var error = await Data.ReorderCardsAsync(sourceCategoryId, targetCategoryId, sourceCardIds, targetCardIds);
        if (error is not null)
            Logger.LogWarning(error);
    }

    // Ключ включает обе ширины: после ресайза категория перерисовывается и получает корректные
    // значения span для всех брейкпоинтов, а не только для текущего.
    private static string CategoryKey(DashboardCategory category) => $"{category.Id}:{category.Width}:{category.MobileWidth}";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeDragAndDrop");
                await _module.InvokeVoidAsync("disposeLayout");
                await _module.DisposeAsync();
            }
            catch (Exception)
            {
                // Соединение с JS потеряно: освобождать больше нечего.
            }
        }

        _dotnetRef?.Dispose();
    }
}
